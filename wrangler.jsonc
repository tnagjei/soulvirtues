// input: Soul Virtues Pages build and its dedicated report database
// output: Reproducible production bindings without embedding private credentials
// pos: wrangler.jsonc (更新规则：绑定变化同步 README、付款回归与 Cloudflare 部署)
{
  "name": "soulvirtues",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-08-17",
  "d1_databases": [
    {
      "binding": "REPORTS_DB",
      "database_name": "soulvirtues-reports",
      "database_id": "0afc3785-6cbe-4949-b09c-ef8524095e2f",
      "migrations_dir": "migrations"
    },
    {
      "binding": "TEST_REPORTS_DB",
      "database_name": "soulvirtues-reports-test",
      "database_id": "4a4fd586-946f-4d4f-a4c1-f7d0c54f222d"
    }
  ],
  "vars": {
    "WAFFO_WEBHOOK_PUBLIC_KEY": "",
    "AI_TEST_REPORT_ID": "61a9ae18-ddb3-4486-8676-547d85f1c7d6"
  },
  "env": {
    "preview": {
      "d1_databases": [],
      "vars": {},
      "queues": {
        "producers": []
      }
    }
  },
  "queues": {
    "producers": [
      {
        "binding": "REPORT_QUEUE",
        "queue": "soulvirtues-report-ai"
      }
    ]
  }
}
