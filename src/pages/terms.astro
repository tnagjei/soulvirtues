---
// input: None (static Terms of Service page)
// output: Full Terms of Service page outlining acceptable use and disclaimers
// pos: src/pages/terms.astro (更新规则：文件变更需同步本注释与所属目录 README)

import Layout from '../layouts/Layout.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://soulvirtues.org/terms/#webpage",
  "url": "https://soulvirtues.org/terms/",
  "name": "Terms of Service - Soul Virtues Extractor",
  "description": "Terms of Service for Soul Virtues Extractor (soulvirtues.org). Acceptable use guidelines, intellectual property notices, and disclaimers.",
  "inLanguage": "en",
  "isPartOf": {
    "@type": "WebSite",
    "@id": "https://soulvirtues.org/#website",
    "name": "Soul Virtues Extractor",
    "url": "https://soulvirtues.org/"
  }
};
---

<Layout
  title="Terms of Service - Soul Virtues Extractor"
  description="Terms of Service for Soul Virtues Extractor (soulvirtues.org). Acceptable use guidelines, intellectual property notices, and disclaimers."
  canonicalUrl="https://soulvirtues.org/terms/"
  structuredData={structuredData}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-16">
    <div class="mb-10 text-center">
      <h1 class="text-3xl sm:text-5xl font-black text-white font-mono mb-4">Terms of Service</h1>
      <p class="text-gray-400 text-xs font-mono">Last Updated: August 17, 2026</p>
    </div>

    <div class="pixel-card p-6 sm:p-10 space-y-6 text-gray-300 text-sm leading-relaxed">
      <div>
        <h2 class="text-lg font-bold text-white mb-2">1. Agreement to Terms</h2>
        <p>
          By accessing and using Soul Virtues Extractor (soulvirtues.org), you agree to be bound by these Terms of Service. If you disagree with any part of these terms, you may discontinue use of the website.
        </p>
      </div>

      <div>
        <h2 class="text-lg font-bold text-white mb-2">2. Entertainment & Informational Purpose</h2>
        <p>
          The Soul Virtues Extractor is provided solely for entertainment, educational, and fan appreciation purposes. The results do not constitute formal psychological evaluations or clinical medical advice.
        </p>
      </div>

      <div>
        <h2 class="text-lg font-bold text-white mb-2">3. Intellectual Property & Fan Tribute Disclaimer</h2>
        <p>
          Undertale and related game assets, characters, and concepts are the intellectual property of Toby Fox. This website is a fan-created interactive project and is not affiliated with or endorsed by Toby Fox or original rightsholders.
        </p>
      </div>

      <div>
        <h2 class="text-lg font-bold text-white mb-2">4. User Conduct</h2>
        <p>
          You agree not to misuse the website, attempt unauthorized access, disrupt web servers, or distribute malicious code.
        </p>
      </div>

      <div>
        <h2 class="text-lg font-bold text-white mb-2">5. Disclaimer of Warranties</h2>
        <p>
          The website is provided on an "AS IS" and "AS AVAILABLE" basis without warranties of any kind, express or implied.
        </p>
      </div>

      <div>
        <h2 class="text-lg font-bold text-white mb-2">6. Contact Information</h2>
        <p>
          For any inquiries regarding these terms, please contact:
          <!--email_off--><a href="mailto:contact@soulvirtues.org" class="text-red-400 underline font-mono">contact@soulvirtues.org</a><!--/email_off-->.
        </p>
      </div>
    </div>
  </div>
</Layout>
