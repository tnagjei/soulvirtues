---
// input: Redirect from payment gateway after successful purchase
// output: Private unlocked 5-chapter AI report view with PDF generation
// pos: src/pages/success.astro

import '../styles/global.css';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex,follow" />
    <title>AI Deep Soul Archive - Soul Virtues Extractor</title>
    <meta name="description" content="Your verified 7-virtue psychological breakdown and AI Deep Soul Archive." />
    <link rel="icon" type="image/png" sizes="512x512" href="/logo.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <style>
      @media print {
        body { background: #000 !important; color: #fff !important; }
        .no-print { display: none !important; }
        .page-break { page-break-before: always; break-before: page; }
      }
    </style>
  </head>
  <body class="bg-black text-gray-100 min-h-screen font-sans selection:bg-yellow-500 selection:text-black">
    <main class="max-w-4xl mx-auto px-4 py-12 text-center text-white">
      <!-- Success Badge -->
      <div class="mb-8 no-print">
        <div class="w-16 h-16 mx-auto mb-4 text-emerald-400 drop-shadow-[0_0_20px_rgba(52,211,153,0.8)]">
          <svg viewBox="0 0 16 16" fill="currentColor" class="w-full h-full" shape-rendering="crispEdges">
            <path d="M2 0h4v1H2zm8 0h4v1h-4zM1 1h6v1H1zm8 0h6v1H9zM0 2h7v1H0zm9 2h7v1H9zM0 3h7v1H0zm9 3h7v1H9zM0 4h16v6H0zm2 6h12v2H2zm2 2h8v2H4zm2 2h4v2H6z"/>
          </svg>
        </div>
        <div class="inline-block px-3 py-1 text-xs font-mono font-bold tracking-widest uppercase mb-3 border-2 border-emerald-400 text-emerald-300 bg-emerald-950/40">
          PAYMENT CONFIRMED · ORDER COMPLETED
        </div>
        <h1 class="text-2xl sm:text-4xl font-black font-mono tracking-tight text-white uppercase mb-3">
          AI DEEP SOUL ARCHIVE UNLOCKED
        </h1>
        <p class="text-sm text-gray-300 max-w-lg mx-auto">
          Thank you for unlocking your verified Soul Profile. Your comprehensive 5-chapter psychological dossier and downloadable handbook are below.
        </p>
      </div>

      <!-- Report Container (Render Target for PDF) -->
      <div id="unlocked-report-card" class="pixel-box p-6 sm:p-10 text-left bg-black border-2 border-yellow-500/80 shadow-[0_0_25px_rgba(234,179,8,0.25)] mb-8">
        <!-- Loading State -->
        <div id="report-loading" class="py-12 text-center">
          <div class="inline-block animate-spin text-3xl mb-4 text-yellow-400">✦</div>
          <p class="font-mono text-sm tracking-wider text-yellow-300">DECRYPTING SOUL PATTERNS & GENERATING 5-CHAPTER ARCHIVE...</p>
        </div>

        <!-- Ready State -->
        <div id="report-ready" class="hidden space-y-8">
          <!-- Official Dossier Header -->
          <div class="border-b-2 border-yellow-500/40 pb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <span class="text-[10px] font-mono uppercase text-gray-400 tracking-widest block">OFFICIAL SUBJECT ARCHIVE</span>
              <div class="font-mono font-black text-xl text-yellow-400" id="archive-id">SV-CONFIDENTIAL</div>
              <div class="text-xs text-gray-300 font-mono mt-0.5">UNDERTALE SOUL VIRTUES CLASSIFIED DOSSIER</div>
            </div>
            <div class="text-left sm:text-right">
              <span class="text-[10px] font-mono uppercase text-emerald-400 tracking-widest block font-bold">STATUS: VERIFIED & COMPLETED</span>
              <div class="text-xs text-gray-400 font-mono" id="archive-date"></div>
            </div>
          </div>

          <!-- Section 1: 7-Virtue Metric Matrix -->
          <div>
            <h2 class="text-sm font-mono font-bold tracking-widest text-cyan-300 uppercase mb-4 flex items-center gap-2">
              <span>[CHAPTER 1]</span>
              <span>7-VIRTUE METRIC MATRIX & PROFILE BALANCE</span>
            </h2>
            <div id="unlocked-virtue-bars" class="space-y-3 font-mono text-xs">
              <!-- Injected via JS -->
            </div>
          </div>

          <!-- Section 2: Core Motivational Engine -->
          <div>
            <h2 class="text-sm font-mono font-bold tracking-widest text-yellow-300 uppercase mb-3 flex items-center gap-2">
              <span>[CHAPTER 2]</span>
              <span>CORE MOTIVATIONAL ENGINE & COGNITIVE BIAS</span>
            </h2>
            <div id="unlocked-chapter1" class="text-xs sm:text-sm text-gray-200 leading-relaxed font-sans bg-gray-950 p-5 border border-gray-800 rounded">
              <!-- Injected via JS -->
            </div>
          </div>

          <!-- Section 3: Shadow Paradox & Friction Points -->
          <div>
            <h2 class="text-sm font-mono font-bold tracking-widest text-red-400 uppercase mb-3 flex items-center gap-2">
              <span>[CHAPTER 3]</span>
              <span>SHADOW PARADOX: BLIND SPOTS & STRESS TRIGGERS</span>
            </h2>
            <div id="unlocked-chapter2" class="text-xs sm:text-sm text-gray-200 leading-relaxed font-sans bg-gray-950 p-5 border border-gray-800 rounded">
              <!-- Injected via JS -->
            </div>
          </div>

          <!-- Section 4: Undertale Battle Philosophy -->
          <div>
            <h2 class="text-sm font-mono font-bold tracking-widest text-purple-300 uppercase mb-3 flex items-center gap-2">
              <span>[CHAPTER 4]</span>
              <span>UNDERTALE SOUL RESONANCE & STRATEGIC COMBAT</span>
            </h2>
            <div id="unlocked-chapter3" class="text-xs sm:text-sm text-gray-200 leading-relaxed font-sans bg-gray-950 p-5 border border-gray-800 rounded">
              <!-- Injected via JS -->
            </div>
          </div>

          <!-- Section 5: Interpersonal Dynamics -->
          <div>
            <h2 class="text-sm font-mono font-bold tracking-widest text-emerald-300 uppercase mb-3 flex items-center gap-2">
              <span>[CHAPTER 5]</span>
              <span>INTERPERSONAL DYNAMICS & COLLABORATIVE STYLES</span>
            </h2>
            <div id="unlocked-chapter4" class="text-xs sm:text-sm text-gray-200 leading-relaxed font-sans bg-gray-950 p-5 border border-gray-800 rounded">
              <!-- Injected via JS -->
            </div>
          </div>

          <!-- Section 6: Tactical Evolution Protocol -->
          <div>
            <h2 class="text-sm font-mono font-bold tracking-widest text-amber-300 uppercase mb-3 flex items-center gap-2">
              <span>[CHAPTER 6]</span>
              <span>TACTICAL EVOLUTION PROTOCOL: ACTIONABLE ADVICE</span>
            </h2>
            <div id="unlocked-chapter5" class="text-xs sm:text-sm text-gray-200 leading-relaxed font-sans bg-gray-950 p-5 border border-gray-800 rounded">
              <!-- Injected via JS -->
            </div>
          </div>

          <!-- Actions Bar -->
          <div class="pt-8 border-t border-gray-800 flex flex-col sm:flex-row items-center justify-between gap-4 no-print">
            <a href="/" class="text-xs font-mono text-gray-400 hover:text-white underline">
              ← Return to Soul Virtues Extractor
            </a>
            <div class="flex items-center gap-3">
              <button
                id="btn-download-pdf"
                type="button"
                class="px-6 py-3.5 bg-yellow-400 text-black font-mono font-black text-xs uppercase tracking-wider hover:bg-yellow-300 cursor-pointer transition-all shadow-[3px_3px_0_rgba(255,255,255,0.4)] active:translate-x-[1px] active:translate-y-[1px] flex items-center gap-2"
              >
                <span>📥</span>
                <span id="btn-pdf-text">DOWNLOAD OFFICIAL DOSSIER (PDF)</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Empty State -->
        <div id="report-empty" class="hidden py-10 text-center space-y-4">
          <div class="text-4xl text-amber-400">⚠️</div>
          <h3 class="text-lg font-bold font-mono text-white">NO ACTIVE TEST SESSION LOCATED</h3>
          <p class="text-xs text-gray-300 max-w-md mx-auto">
            Payment was confirmed, but we didn't find your completed answers on this device. Click below to complete the 66-question test and your verified archive will unlock instantly.
          </p>
          <div class="pt-4">
            <a href="/#test" class="inline-block px-6 py-3 bg-yellow-400 text-black font-bold font-mono text-xs uppercase tracking-widest hover:bg-yellow-300">
              TAKE TEST & UNLOCK NOW →
            </a>
          </div>
        </div>
      </div>
    </main>

    <script is:inline>
      (async function() {
        try {
          localStorage.setItem('soul_virtues_paid', 'true');
          localStorage.setItem('soul_virtues_paid_at', new Date().toISOString());
        } catch (e) {}

        const loadingEl = document.getElementById('report-loading');
        const readyEl = document.getElementById('report-ready');
        const dateEl = document.getElementById('archive-date');
        const idEl = document.getElementById('archive-id');

        if (dateEl) dateEl.textContent = new Date().toLocaleDateString();
        if (idEl) idEl.textContent = 'SV-' + Math.random().toString(36).substring(2, 8).toUpperCase();

        let resultData = null;
        try {
          const saved = localStorage.getItem('soul_virtues_last_result');
          if (saved) resultData = JSON.parse(saved);
        } catch (e) {}

        const traits = [
          { id: 'red', name: 'DETERMINATION', color: '#ff0000', icon: '❤️' },
          { id: 'orange', name: 'BRAVERY', color: '#ff9c00', icon: '🧡' },
          { id: 'yellow', name: 'JUSTICE', color: '#ffff00', icon: '💛' },
          { id: 'green', name: 'KINDNESS', color: '#00ff00', icon: '💚' },
          { id: 'cyan', name: 'PATIENCE', color: '#42fcff', icon: '🩵' },
          { id: 'blue', name: 'INTEGRITY', color: '#003cff', icon: '💙' },
          { id: 'purple', name: 'PERSEVERANCE', color: '#d800ff', icon: '💜' }
        ];

        const scores = resultData?.pct || {
          red: 78, orange: 65, yellow: 70, green: 55, cyan: 60, blue: 68, purple: 74
        };
        const dominant = resultData?.dominant || 'red';
        const secondary = resultData?.secondary || 'purple';
        const lang = resultData?.lang || 'en';

        let reportData = null;
        try {
          const cached = localStorage.getItem('soul_virtues_ai_report_5ch');
          if (cached) reportData = JSON.parse(cached);
        } catch (e) {}

        if (!reportData) {
          try {
            const res = await fetch('/api/generate-report', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ scores, dominant, secondary, lang }),
            });
            if (res.ok) {
              reportData = await res.json();
              try { localStorage.setItem('soul_virtues_ai_report_5ch', JSON.stringify(reportData)); } catch (e) {}
            }
          } catch (e) {
            console.error('Report fetch error:', e);
          }
        }

        if (!reportData) {
          reportData = {
            chapter1_engine: "You embody Determination—a profound internal drive characterized by purposeful autonomy and relentless resilience. When facing adversity, your primary instinct is not passive compromise, but focused resolve to reshape your circumstances according to your vision.",
            chapter2_paradox: "Your greatest strength—unbending persistence—can subtly shift into situational rigidity. When objectives stall, distinguishing between genuine perseverance and stubborn attachment to outdated assumptions is your key area for personal evolution.",
            chapter3_combat: "In the Undertale battle philosophy, your soul energy manifests as high baseline HP recovery and steady forward motion. You excel in complex encounters that reward endurance and unwavering commitment over impulsive improvisation.",
            chapter4_interpersonal: "In collaborative settings, peers perceive you as a pillar of dependability during ambiguous crises. However, you must be mindful of peers who move at a different cadence, ensuring your high intensity does not accidentally overwhelm collaborative momentum.",
            chapter5_evolution: "Practice deliberate tactical pauses. Taking a structured breath to re-evaluate your assumptions before re-committing your will enhances the strategic impact of your unstoppable drive."
          };
        }

        if (loadingEl) loadingEl.classList.add('hidden');
        if (readyEl) readyEl.classList.remove('hidden');

        // Render Bars
        const barsEl = document.getElementById('unlocked-virtue-bars');
        if (barsEl) {
          barsEl.innerHTML = traits.map(t => {
            const pct = Math.round(scores[t.id] ?? 50);
            return `
              <div>
                <div class="flex justify-between items-center mb-1 text-gray-300">
                  <span>${t.icon} ${t.name}</span>
                  <span class="font-bold" style="color: ${t.color}">${pct}%</span>
                </div>
                <div class="h-2 bg-gray-900 border border-gray-700">
                  <div class="h-full transition-all duration-500" style="width: ${pct}%; background-color: ${t.color}"></div>
                </div>
              </div>
            `;
          }).join('');
        }

        // Render 5 Chapters
        const ch1 = document.getElementById('unlocked-chapter1');
        const ch2 = document.getElementById('unlocked-chapter2');
        const ch3 = document.getElementById('unlocked-chapter3');
        const ch4 = document.getElementById('unlocked-chapter4');
        const ch5 = document.getElementById('unlocked-chapter5');

        if (ch1) ch1.textContent = reportData.chapter1_engine || reportData.coreArchetype || '';
        if (ch2) ch2.textContent = reportData.chapter2_paradox || reportData.behavioralParadox || '';
        if (ch3) ch3.textContent = reportData.chapter3_combat || reportData.soulResonance || '';
        if (ch4) ch4.textContent = reportData.chapter4_interpersonal || 'Peers respect your principled presence and stability during moments of organizational uncertainty.';
        if (ch5) ch5.textContent = reportData.chapter5_evolution || 'Cultivate adaptive pacing: balance decisive action with situational reflection for maximum long-term fulfillment.';

        // PDF Download Engine
        const pdfBtn = document.getElementById('btn-download-pdf');
        if (pdfBtn) {
          pdfBtn.addEventListener('click', async () => {
            const btnText = document.getElementById('btn-pdf-text');
            if (btnText) btnText.textContent = 'GENERATING PDF DOSSIER...';
            pdfBtn.disabled = true;

            const element = document.getElementById('unlocked-report-card');
            const opt = {
              margin: [10, 10, 10, 10],
              filename: `Soul-Virtues-Archive-${new Date().toISOString().slice(0,10)}.pdf`,
              image: { type: 'jpeg', quality: 0.98 },
              html2canvas: { scale: 2, useCORS: true, backgroundColor: '#000000' },
              jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
            };

            try {
              if (typeof html2pdf !== 'undefined') {
                await html2pdf().set(opt).from(element).save();
              } else {
                window.print();
              }
            } catch (err) {
              console.error('PDF generation fallback to print:', err);
              window.print();
            } finally {
              if (btnText) btnText.textContent = 'DOWNLOAD OFFICIAL DOSSIER (PDF)';
              pdfBtn.disabled = false;
            }
          });
        }
      })();
    </script>
  </body>
</html>