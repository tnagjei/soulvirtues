---
// input: Redirect from payment gateway after successful purchase
// output: Private unlocked AI report view with noindex and print action
// pos: src/pages/success.astro

import '../styles/global.css';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex,follow" />
    <title>AI Deep Soul Archive - Soul Virtues Extractor</title>
    <meta name="description" content="Your verified 7-virtue psychological breakdown and AI Deep Soul Archive." />
    <link rel="icon" type="image/png" sizes="512x512" href="/logo.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-black text-gray-100 min-h-screen font-sans selection:bg-yellow-500 selection:text-black">
    <main class="max-w-4xl mx-auto px-4 py-12 text-center text-white">
      <!-- Success Badge -->
      <div class="mb-8">
        <div class="w-16 h-16 mx-auto mb-4 text-emerald-400 drop-shadow-[0_0_20px_rgba(52,211,153,0.8)]">
          <svg viewBox="0 0 16 16" fill="currentColor" class="w-full h-full" shape-rendering="crispEdges">
            <path d="M2 0h4v1H2zm8 0h4v1h-4zM1 1h6v1H1zm8 0h6v1H9zM0 2h7v1H0zm9 2h7v1H9zM0 3h7v1H0zm9 3h7v1H9zM0 4h16v6H0zm2 6h12v2H2zm2 2h8v2H4zm2 2h4v2H6z"/>
          </svg>
        </div>
        <div class="inline-block px-3 py-1 text-xs font-mono font-bold tracking-widest uppercase mb-3 border-2 border-emerald-400 text-emerald-300 bg-emerald-950/40">
          PAYMENT CONFIRMED · ORDER COMPLETED
        </div>
        <h1 class="text-2xl sm:text-4xl font-black font-mono tracking-tight text-white uppercase mb-3">
          AI DEEP SOUL ARCHIVE UNLOCKED
        </h1>
        <p class="text-sm text-gray-300 max-w-lg mx-auto">
          Thank you for unlocking your verified Soul Profile. Your detailed psychological analysis based on the 66-question assessment is below.
        </p>
      </div>

      <!-- Report Container -->
      <div id="unlocked-report-card" class="pixel-box p-6 sm:p-10 text-left bg-black/90 border-2 border-yellow-500/70 shadow-[0_0_25px_rgba(234,179,8,0.2)] mb-8">
        <!-- Loading State -->
        <div id="report-loading" class="py-12 text-center">
          <div class="inline-block animate-spin text-3xl mb-4 text-yellow-400">✦</div>
          <p class="font-mono text-sm tracking-wider text-yellow-300">DECRYPTING SOUL PATTERNS & GENERATING AI ARCHIVE...</p>
        </div>

        <!-- Ready State -->
        <div id="report-ready" class="hidden space-y-8">
          <!-- Header -->
          <div class="border-b border-gray-800 pb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <span class="text-[11px] font-mono uppercase text-gray-400 tracking-widest">SUBJECT ARCHIVE ID</span>
              <div class="font-mono font-bold text-lg text-white" id="archive-id">SV-CONFIDENTIAL</div>
            </div>
            <div class="text-left sm:text-right">
              <span class="text-[11px] font-mono uppercase text-emerald-400 tracking-widest">STATUS: VERIFIED & PAID</span>
              <div class="text-xs text-gray-400 font-mono" id="archive-date"></div>
            </div>
          </div>

          <!-- 7 Trait Scores Overview -->
          <div>
            <h2 class="text-sm font-mono font-bold tracking-widest text-cyan-300 uppercase mb-4">
              [1] 7-Virtue Metric Matrix
            </h2>
            <div id="unlocked-virtue-bars" class="space-y-3 font-mono text-xs">
              <!-- Injected via JS -->
            </div>
          </div>

          <!-- Deep AI Analysis -->
          <div>
            <h2 class="text-sm font-mono font-bold tracking-widest text-yellow-300 uppercase mb-4">
              [2] Personalized Psychological Analysis
            </h2>
            <div id="unlocked-deep-analysis" class="space-y-4 text-xs sm:text-sm text-gray-200 leading-relaxed font-sans bg-gray-950 p-6 border border-gray-800">
              <!-- Injected via JS -->
            </div>
          </div>

          <!-- Soul Combat & Behavioral Profile -->
          <div>
            <h2 class="text-sm font-mono font-bold tracking-widest text-purple-300 uppercase mb-4">
              [3] Behavioral Dynamics & Undertale Resonance
            </h2>
            <div id="unlocked-behavior-analysis" class="space-y-4 text-xs sm:text-sm text-gray-200 leading-relaxed font-sans bg-gray-950 p-6 border border-gray-800">
              <!-- Injected via JS -->
            </div>
          </div>

          <!-- Actions -->
          <div class="pt-6 border-t border-gray-800 flex flex-col sm:flex-row items-center justify-between gap-4">
            <a href="/" class="text-xs font-mono text-gray-400 hover:text-white underline">
              ← Return to Soul Virtues Extractor
            </a>
            <button
              id="btn-print-report"
              type="button"
              class="px-6 py-3 bg-white text-black font-mono font-bold text-xs uppercase tracking-wider hover:bg-gray-200 cursor-pointer transition-all shadow-[2px_2px_0_rgba(255,255,255,0.4)] active:translate-x-[1px] active:translate-y-[1px]"
            >
              💾 Save / Print Full Certificate
            </button>
          </div>
        </div>

        <!-- Empty/No Data State -->
        <div id="report-empty" class="hidden py-10 text-center space-y-4">
          <div class="text-4xl text-amber-400">⚠️</div>
          <h3 class="text-lg font-bold font-mono text-white">NO ACTIVE TEST SESSION LOCATED</h3>
          <p class="text-xs text-gray-300 max-w-md mx-auto">
            Payment was confirmed, but we didn't find your completed answers on this device. Click below to complete the 66-question test and your verified archive will unlock instantly.
          </p>
          <div class="pt-4">
            <a href="/#test" class="inline-block px-6 py-3 bg-yellow-400 text-black font-bold font-mono text-xs uppercase tracking-widest hover:bg-yellow-300">
              TAKE TEST & UNLOCK NOW →
            </a>
          </div>
        </div>
      </div>
    </main>

    <script is:inline>
      (async function() {
        try {
          localStorage.setItem('soul_virtues_paid', 'true');
          localStorage.setItem('soul_virtues_paid_at', new Date().toISOString());
        } catch (e) {}

        const loadingEl = document.getElementById('report-loading');
        const readyEl = document.getElementById('report-ready');
        const emptyEl = document.getElementById('report-empty');
        const dateEl = document.getElementById('archive-date');
        const idEl = document.getElementById('archive-id');

        if (dateEl) dateEl.textContent = new Date().toLocaleDateString();
        if (idEl) idEl.textContent = 'SV-' + Math.random().toString(36).substring(2, 8).toUpperCase();

        let resultData = null;
        try {
          const saved = localStorage.getItem('soul_virtues_last_result');
          if (saved) resultData = JSON.parse(saved);
        } catch (e) {}

        const traits = [
          { id: 'red', name: 'DETERMINATION', color: '#ff0000', icon: '❤️' },
          { id: 'orange', name: 'BRAVERY', color: '#ff9c00', icon: '🧡' },
          { id: 'yellow', name: 'JUSTICE', color: '#ffff00', icon: '💛' },
          { id: 'green', name: 'KINDNESS', color: '#00ff00', icon: '💚' },
          { id: 'cyan', name: 'PATIENCE', color: '#42fcff', icon: '🩵' },
          { id: 'blue', name: 'INTEGRITY', color: '#003cff', icon: '💙' },
          { id: 'purple', name: 'PERSEVERANCE', color: '#d800ff', icon: '💜' }
        ];

        const scores = resultData?.pct || {
          red: 78, orange: 65, yellow: 70, green: 55, cyan: 60, blue: 68, purple: 74
        };
        const dominant = resultData?.dominant || 'red';
        const secondary = resultData?.secondary || 'purple';
        const lang = resultData?.lang || 'en';

        let reportData = null;
        try {
          const cached = localStorage.getItem('soul_virtues_ai_report');
          if (cached) reportData = JSON.parse(cached);
        } catch (e) {}

        if (!reportData) {
          try {
            const res = await fetch('/api/generate-report', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ scores, dominant, secondary, lang }),
            });
            if (res.ok) {
              reportData = await res.json();
              try { localStorage.setItem('soul_virtues_ai_report', JSON.stringify(reportData)); } catch (e) {}
            }
          } catch (e) {
            console.error('Report fetch error:', e);
          }
        }

        if (!reportData) {
          reportData = {
            coreArchetype: "Your psychological matrix indicates a dominant focus on intentional persistence and principled autonomy. When confronting high-stress barriers, your decision engine naturally prioritizes self-directed resolve over conformist compromise.",
            behavioralParadox: "While your primary Virtue provides sharp momentum, your secondary profile creates a crucial checks-and-balances system. In collaborative settings, this dynamic allows you to act decisively while maintaining deep accountability for the consequences of your choices.",
            soulResonance: "In the Undertale battle framework, your soul energy manifests as high baseline HP regeneration combined with deliberate timing mechanics. You thrive in encounters where careful pattern recognition meets bold forward movement."
          };
        }

        if (loadingEl) loadingEl.classList.add('hidden');
        if (readyEl) readyEl.classList.remove('hidden');

        const barsEl = document.getElementById('unlocked-virtue-bars');
        if (barsEl) {
          barsEl.innerHTML = traits.map(t => {
            const pct = Math.round(scores[t.id] ?? 50);
            return `
              <div>
                <div class="flex justify-between items-center mb-1 text-gray-300">
                  <span>${t.icon} ${t.name}</span>
                  <span class="font-bold" style="color: ${t.color}">${pct}%</span>
                </div>
                <div class="h-2 bg-gray-900 border border-gray-700">
                  <div class="h-full transition-all duration-500" style="width: ${pct}%; background-color: ${t.color}"></div>
                </div>
              </div>
            `;
          }).join('');
        }

        const deepEl = document.getElementById('unlocked-deep-analysis');
        if (deepEl) {
          deepEl.innerHTML = `
            <p class="leading-relaxed text-gray-200">${reportData.coreArchetype || ''}</p>
            <p class="leading-relaxed text-gray-300 mt-3 pt-3 border-t border-gray-800"><strong>Behavioral Paradox & Growth:</strong> ${reportData.behavioralParadox || ''}</p>
          `;
        }

        const behavEl = document.getElementById('unlocked-behavior-analysis');
        if (behavEl) {
          behavEl.innerHTML = `
            <p class="leading-relaxed text-gray-200">${reportData.soulResonance || ''}</p>
          `;
        }

        const printBtn = document.getElementById('btn-print-report');
        if (printBtn) {
          printBtn.addEventListener('click', () => window.print());
        }
      })();
    </script>
  </body>
</html>
