---
// input: Complete V2 answers saved in this browser
// output: A personal reflection workbook with answer evidence and print-ready pages
// pos: src/pages/success.astro (更新规则：交付变化同步 field-guide 脚本、样式、回归与 src/pages/README)
import '../styles/fonts.css';
import '../styles/report.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,follow" />
    <title>Your Soul Field Guide - Soul Virtues Extractor</title>
    <meta name="description" content="Your quiz answers, seven trait readings and a practical personal reflection workbook." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link no-print" href="#guide">Skip to your guide</a>
    <div id="preview-banner" class="preview-banner no-print" hidden></div>
    <header class="guide-top no-print">
      <a href="/" class="brand"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 1h4v1h1v1h2V2h1V1h4v1h1v1h1v6h-2v2h-2v2h-2v2H6v-2H4v-2H2V9H0V3h1V2h1z"/></svg>SOUL VIRTUES</a>
      <div class="tools">
        <label class="sr-only" for="report-language">Report language</label>
        <select id="report-language"><option value="en">English</option><option value="es">Español</option></select>
        <button id="save-pdf" class="primary" disabled>Save PDF</button>
      </div>
    </header>
    <div class="guide-layout">
      <aside class="guide-nav no-print"><p id="contents-label">Inside your guide</p><nav id="contents" aria-label="Report sections"></nav><p id="save-state" role="status"></p></aside>
      <main id="guide" aria-busy="true">
        <section class="empty-state"><h1>Your personal guide</h1><p>Reading your saved answers…</p></section>
      </main>
    </div>
    <noscript><p class="empty-state">Enable JavaScript to read your saved quiz answers and open your guide.</p></noscript>
    <script>
      import '../scripts/field-guide';
    </script>
  </body>
</html>
