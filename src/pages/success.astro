---
// input: Redirect from payment gateway after successful purchase
// output: High-value visual RPG dossier with badges, dual-column cards, battle stats, and PDF export
// pos: src/pages/success.astro (更新规则：交付变化同步报告接口、回归与 src/pages/README)

import '../styles/global.css';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex,follow" />
    <title>Classified Soul Dossier - Soul Virtues Extractor</title>
    <meta name="description" content="Your verified 7-virtue psychological breakdown and AI Deep Soul Archive." />
    <link rel="icon" type="image/png" sizes="512x512" href="/logo.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <style>
      @media print {
        body { background: #000 !important; color: #fff !important; }
        .no-print { display: none !important; }
      }
    </style>
  </head>
  <body class="bg-black text-gray-100 min-h-screen font-sans selection:bg-yellow-500 selection:text-black">
    <main class="max-w-4xl mx-auto px-4 py-10 text-white">
      <!-- Success Badge (Header) -->
      <div class="text-center mb-8 no-print">
        <div class="w-14 h-14 mx-auto mb-3 text-emerald-400 drop-shadow-[0_0_20px_rgba(52,211,153,0.8)]">
          <svg viewBox="0 0 16 16" fill="currentColor" class="w-full h-full" shape-rendering="crispEdges">
            <path d="M2 0h4v1H2zm8 0h4v1h-4zM1 1h6v1H1zm8 0h6v1H9zM0 2h7v1H0zm9 2h7v1H9zM0 3h7v1H0zm9 3h7v1H9zM0 4h16v6H0zm2 6h12v2H2zm2 2h8v2H4zm2 2h4v2H6z"/>
          </svg>
        </div>
        <div class="inline-block px-3 py-1 text-xs font-mono font-bold tracking-widest uppercase mb-2 border-2 border-emerald-400 text-emerald-300 bg-emerald-950/40">
          REPORT DELIVERY
        </div>
        <h1 class="text-2xl sm:text-4xl font-black font-mono tracking-tight text-white uppercase">
          CLASSIFIED SOUL DOSSIER
        </h1>
        <p class="text-xs sm:text-sm text-gray-300 max-w-md mx-auto mt-2">
          Your saved quiz profile and reflection guide will appear below.
        </p>
      </div>

      <!-- Main Dossier Card (Render Target for PDF) -->
      <div id="unlocked-report-card" class="pixel-box p-6 sm:p-10 bg-black border-2 border-yellow-500/80 shadow-[0_0_30px_rgba(234,179,8,0.2)] mb-8 space-y-8">
        
        <!-- Loading State -->
        <div id="report-loading" class="py-16 text-center">
          <div class="inline-block animate-spin text-4xl mb-4 text-yellow-400">✦</div>
          <p class="font-mono text-sm tracking-wider text-yellow-300">SYNTHESIZING MULTI-DIMENSIONAL DOSSIER & COMBAT STATS...</p>
        </div>

        <section id="report-error" class="hidden text-center py-8" role="alert">
          <h2 class="font-mono text-amber-300 text-lg mb-3">REPORT TEMPORARILY UNAVAILABLE</h2>
          <p class="text-sm text-gray-300 mb-5">We could not load your report. You do not need to pay again. Retry, or contact tangjei414@gmail.com if the problem continues.</p>
          <button id="btn-retry-report" type="button" class="min-h-11 px-5 py-3 bg-yellow-400 text-black font-bold cursor-pointer">RETRY REPORT</button>
        </section>

        <!-- Loaded State -->
        <div id="report-ready" class="hidden space-y-8">
          <p id="report-source" class="text-sm text-gray-300" role="status"></p>
          
          <!-- Dossier Top Header -->
          <div class="border-b-2 border-yellow-500/30 pb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <span class="text-[10px] font-mono uppercase text-gray-400 tracking-widest block">PERSONAL REFLECTION ARCHIVE</span>
              <div class="font-mono font-black text-2xl text-yellow-400 tracking-wide" id="archive-id">SV-CONFIDENTIAL</div>
              <div class="text-xs text-gray-300 font-mono mt-0.5">INDEPENDENT FAN REFLECTION GUIDE</div>
            </div>
            <div class="text-left sm:text-right">
              <span class="text-[10px] font-mono uppercase text-emerald-400 tracking-widest block font-bold">QUIZ-BASED INTERPRETATION</span>
              <div class="text-xs text-gray-400 font-mono" id="archive-date"></div>
            </div>
          </div>

          <!-- Hero Archetype Identity Badge -->
          <div class="p-6 bg-gradient-to-r from-yellow-950/40 via-gray-900/80 to-black border-2 border-yellow-500/60 rounded relative overflow-hidden">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
              <div>
                <span class="text-[11px] font-mono font-bold text-yellow-400 uppercase tracking-widest block mb-1">
                  CORE ARCHETYPE CODENAME
                </span>
                <h2 id="archetype-title" class="text-2xl sm:text-3xl font-black font-mono text-white tracking-wide uppercase">
                  THE INDOMITABLE SENTINEL
                </h2>
                <p id="archetype-subtitle" class="text-xs sm:text-sm text-gray-300 italic font-serif mt-1">
                  Guardian of Unyielding Resolve & Fair Outcomes
                </p>
              </div>
              <div class="sm:text-right flex-shrink-0">
                <div class="inline-block px-3 py-1.5 bg-yellow-400/20 border border-yellow-400 text-yellow-300 text-xs font-mono font-black tracking-wider uppercase" id="percentile-badge">
                  REFLECTION GUIDE
                </div>
              </div>
            </div>
            <!-- Identity Tags -->
            <div id="archetype-tags" class="flex flex-wrap gap-2 pt-2 border-t border-gray-800">
              <!-- Injected via JS -->
            </div>
          </div>

          <!-- Section 1: 7-Virtue Metric Matrix -->
          <div>
            <h3 class="text-sm font-mono font-bold tracking-widest text-cyan-300 uppercase mb-4 flex items-center gap-2">
              <span>[01]</span>
              <span>7-VIRTUE METRIC SPECTRUM</span>
            </h3>
            <div id="unlocked-virtue-bars" class="space-y-3 font-mono text-xs">
              <!-- Injected via JS -->
            </div>
          </div>

          <!-- Section 2: Core Motivational Engine -->
          <div>
            <h3 class="text-sm font-mono font-bold tracking-widest text-yellow-300 uppercase mb-3 flex items-center gap-2">
              <span>[02]</span>
              <span>CORE PSYCHOLOGICAL ENGINE & DECISION PARADIGM</span>
            </h3>
            <div id="unlocked-engine" class="text-xs sm:text-sm text-gray-200 leading-relaxed font-sans bg-gray-950 p-5 border border-gray-800 rounded">
              <!-- Injected via JS -->
            </div>
          </div>

          <!-- Section 3: Dual-Column Light vs. Shadow (Superpowers vs. Blindspots) -->
          <div>
            <h3 class="text-sm font-mono font-bold tracking-widest text-white uppercase mb-4 flex items-center gap-2">
              <span>[03]</span>
              <span>POLARITY MATRIX: SUPERPOWERS VS. SHADOW BLINDSPOTS</span>
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <!-- Left: Superpowers -->
              <div class="p-5 bg-black/80 border-2 border-emerald-500/50 rounded flex flex-col justify-between">
                <div>
                  <div class="flex items-center gap-2 text-emerald-400 font-mono font-bold text-xs uppercase tracking-wider mb-3">
                    <span>⚡</span>
                    <span>CORE SUPERPOWERS</span>
                  </div>
                  <ul id="unlocked-superpowers" class="space-y-2.5 text-xs text-gray-200 leading-relaxed list-disc list-inside">
                    <!-- Injected via JS -->
                  </ul>
                </div>
              </div>

              <!-- Right: Shadow Blindspots -->
              <div class="p-5 bg-black/80 border-2 border-red-500/50 rounded flex flex-col justify-between">
                <div>
                  <div class="flex items-center gap-2 text-red-400 font-mono font-bold text-xs uppercase tracking-wider mb-3">
                    <span>⚠️</span>
                    <span>SHADOW BLINDSPOTS & STRESS TRAPS</span>
                  </div>
                  <ul id="unlocked-blindspots" class="space-y-2.5 text-xs text-gray-200 leading-relaxed list-disc list-inside">
                    <!-- Injected via JS -->
                  </ul>
                </div>
              </div>
            </div>
          </div>

          <!-- Section 4: RPG Combat Profile & Undertale Mechanics -->
          <div>
            <h3 class="text-sm font-mono font-bold tracking-widest text-purple-300 uppercase mb-4 flex items-center gap-2">
              <span>[04]</span>
              <span>FAN-MADE RPG STORY PROFILE</span>
            </h3>
            <div class="p-5 bg-gradient-to-b from-purple-950/30 via-black to-black border-2 border-purple-500/60 rounded space-y-5">
              
              <p class="text-xs text-gray-300">This section is fictional fan storytelling. The RPG stats and abilities are not measurements of your personality or official Undertale mechanics.</p>
              <!-- Combat Stats 4-Grid -->
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center font-mono">
                <div class="p-3 bg-black border border-purple-500/40 rounded">
                  <span class="text-[10px] text-gray-400 uppercase tracking-widest block">ATK (IMPACT)</span>
                  <span id="stat-atk" class="text-xl sm:text-2xl font-black text-red-400">85</span>
                </div>
                <div class="p-3 bg-black border border-purple-500/40 rounded">
                  <span class="text-[10px] text-gray-400 uppercase tracking-widest block">DEF (GUARD)</span>
                  <span id="stat-def" class="text-xl sm:text-2xl font-black text-cyan-400">92</span>
                </div>
                <div class="p-3 bg-black border border-purple-500/40 rounded">
                  <span class="text-[10px] text-gray-400 uppercase tracking-widest block">STA (RESOLVE)</span>
                  <span id="stat-sta" class="text-xl sm:text-2xl font-black text-purple-400">98</span>
                </div>
                <div class="p-3 bg-black border border-purple-500/40 rounded">
                  <span class="text-[10px] text-gray-400 uppercase tracking-widest block">AGI (TIMING)</span>
                  <span id="stat-agi" class="text-xl sm:text-2xl font-black text-yellow-400">70</span>
                </div>
              </div>

              <!-- Abilities & Synergy -->
              <div class="space-y-3 text-xs text-gray-200 font-sans border-t border-purple-900/50 pt-4">
                <div>
                  <span class="font-mono font-bold text-purple-300 uppercase block mb-1">
                    ✦ SOUL BATTLE MECHANIC: <span id="combat-mode" class="text-white">Tethered Matrix Weaver</span>
                  </span>
                  <p id="combat-ability" class="text-gray-300 leading-relaxed"></p>
                </div>
                <div class="border-t border-gray-900 pt-2">
                  <span class="font-mono font-bold text-yellow-300 uppercase block mb-1">
                    ✦ OPTIMAL SOUL SYNERGY:
                  </span>
                  <p id="combat-synergy" class="text-gray-300 leading-relaxed"></p>
                </div>
              </div>
            </div>
          </div>

          <!-- Section 5: Action Plan (DOs & DONTs Checklist) -->
          <div>
            <h3 class="text-sm font-mono font-bold tracking-widest text-amber-300 uppercase mb-4 flex items-center gap-2">
              <span>[05]</span>
              <span>TACTICAL EVOLUTION PROTOCOL: ACTIONABLE AGENDA</span>
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-3 text-xs">
              <div class="p-4 bg-black border border-emerald-500/40 rounded">
                <span class="font-mono font-bold text-emerald-400 uppercase block mb-1.5 flex items-center gap-1.5">
                  <span>✅</span> <span>KEEP DOING</span>
                </span>
                <p id="plan-keep" class="text-gray-300 leading-relaxed"></p>
              </div>
              <div class="p-4 bg-black border border-red-500/40 rounded">
                <span class="font-mono font-bold text-red-400 uppercase block mb-1.5 flex items-center gap-1.5">
                  <span>🛑</span> <span>STOP DOING</span>
                </span>
                <p id="plan-stop" class="text-gray-300 leading-relaxed"></p>
              </div>
              <div class="p-4 bg-black border border-yellow-500/40 rounded">
                <span class="font-mono font-bold text-yellow-400 uppercase block mb-1.5 flex items-center gap-1.5">
                  <span>🎯</span> <span>30-DAY QUEST</span>
                </span>
                <p id="plan-quest" class="text-gray-300 leading-relaxed"></p>
              </div>
            </div>
          </div>

          <!-- Action Controls Bar (Hidden in Print) -->
          <div class="pt-8 border-t-2 border-gray-800 flex flex-col sm:flex-row items-center justify-between gap-4 no-print">
            <a href="/" class="text-xs font-mono text-gray-400 hover:text-white underline">
              ← Return to Soul Virtues Extractor
            </a>
            <div class="flex items-center gap-3 w-full sm:w-auto">
              <button
                id="btn-download-pdf"
                type="button"
                class="w-full sm:w-auto px-6 py-3.5 bg-yellow-400 text-black font-mono font-black text-xs uppercase tracking-wider hover:bg-yellow-300 cursor-pointer transition-all shadow-[4px_4px_0_rgba(255,255,255,0.4)] active:translate-x-[1px] active:translate-y-[1px] flex items-center justify-center gap-2"
              >
                <span>📥</span>
                <span id="btn-pdf-text">DOWNLOAD DOSSIER (PDF)</span>
              </button>
            </div>
          </div>

        </div>

        <!-- Empty State -->
        <div id="report-empty" class="hidden py-10 text-center space-y-4">
          <div class="text-4xl text-amber-400">⚠️</div>
          <h3 class="text-lg font-bold font-mono text-white">NO ACTIVE TEST SESSION LOCATED</h3>
          <p class="text-xs text-gray-300 max-w-md mx-auto">
            We could not find a complete quiz on this browser. Open this page on the device where you completed the quiz, or return to finish your saved answers. For help recovering a report, contact tangjei414@gmail.com.
          </p>
          <div class="pt-4">
            <a href="/#test" class="inline-block px-6 py-3 bg-yellow-400 text-black font-bold font-mono text-xs uppercase tracking-widest hover:bg-yellow-300">
              TAKE TEST & UNLOCK NOW →
            </a>
          </div>
        </div>

      </div>
    </main>

  <script>
    import { fetchDossier, isDossierReport, readReportInput, REPORT_CACHE_KEY, type DossierReport } from '../data/reportDelivery';

    const element = (id: string) => document.getElementById(id)!;
    const text = (id: string, value: string | number) => { element(id).textContent = String(value); };
    const loading = element('report-loading');
    const ready = element('report-ready');
    const empty = element('report-empty');
    const errorPanel = element('report-error');
    const retry = element('btn-retry-report') as HTMLButtonElement;
    const download = element('btn-download-pdf') as HTMLButtonElement;
    const traits = [
      { id: 'red', name: 'DETERMINATION', color: '#ff0000' },
      { id: 'orange', name: 'BRAVERY', color: '#ff9c00' },
      { id: 'yellow', name: 'JUSTICE', color: '#ffff00' },
      { id: 'green', name: 'KINDNESS', color: '#00ff00' },
      { id: 'cyan', name: 'PATIENCE', color: '#42fcff' },
      { id: 'blue', name: 'INTEGRITY', color: '#003cff' },
      { id: 'purple', name: 'PERSEVERANCE', color: '#d800ff' },
    ] as const;

    function list(id: string, items: string[], tag: 'li' | 'span') {
      const nodes = items.map(item => {
        const node = document.createElement(tag);
        node.textContent = item;
        node.className = tag === 'span' ? 'px-2.5 py-0.5 border border-yellow-500/40 text-yellow-300 font-mono text-[10px]' : 'leading-relaxed mb-1.5';
        return node;
      });
      element(id).replaceChildren(...nodes);
    }

    function render(report: DossierReport, input: NonNullable<ReturnType<typeof readReportInput>>, archiveId: string, createdAt: string) {
      text('archive-id', archiveId);
      text('archive-date', new Date(createdAt).toLocaleDateString());
      text('archetype-title', report.archetypeTitle);
      text('archetype-subtitle', report.archetypeSubtitle);
      text('percentile-badge', report.source === 'ai' ? 'AI REFLECTION GUIDE' : 'PREPARED REFLECTION GUIDE');
      text('report-source', report.source === 'ai' ? 'AI-generated interpretation of your quiz scores. For self-reflection; not a clinical assessment.' : 'AI was unavailable. This edition uses prepared guidance selected for your quiz profile; it is not an AI-generated assessment.');
      list('archetype-tags', report.tags, 'span');
      list('unlocked-superpowers', report.superpowers, 'li');
      list('unlocked-blindspots', report.blindspots, 'li');
      element('unlocked-virtue-bars').replaceChildren(...traits.map(trait => {
        const score = input.scores[trait.id];
        const row = document.createElement('div');
        const label = document.createElement('div');
        label.className = 'flex justify-between mb-1 text-gray-300';
        const name = document.createElement('span');
        name.textContent = trait.name;
        const value = document.createElement('span');
        value.textContent = score.toFixed(1).replace(/\.0$/, '') + ' / 100';
        value.style.color = trait.color;
        label.append(name, value);
        const track = document.createElement('div');
        track.className = 'h-2 bg-gray-900 border border-gray-700';
        const bar = document.createElement('div');
        bar.className = 'h-full';
        bar.style.width = score + '%';
        bar.style.backgroundColor = trait.color;
        track.append(bar);
        row.append(label, track);
        row.dataset.trait = trait.id;
        row.dataset.score = String(score);
        return row;
      }));
      text('unlocked-engine', report.engine);
      for (const stat of ['atk', 'def', 'sta', 'agi'] as const) text('stat-' + stat, report.combat[stat]);
      text('combat-mode', report.combat.mode);
      text('combat-ability', report.combat.ability);
      text('combat-synergy', report.combat.synergy);
      for (const item of ['keep', 'stop', 'quest'] as const) text('plan-' + item, report.actionPlan[item]);
    }

    async function loadReport() {
      ready.classList.add('hidden');
      empty.classList.add('hidden');
      errorPanel.classList.add('hidden');
      loading.classList.remove('hidden');
      retry.disabled = true;
      download.disabled = true;
      document.body.dataset.reportState = 'loading';
      try {
        const input = readReportInput(localStorage);
        if (!input) {
          empty.classList.remove('hidden');
          document.body.dataset.reportState = 'missing-answers';
          return;
        }
        const fingerprint = JSON.stringify(input);
        let cached;
        try { cached = JSON.parse(localStorage.getItem(REPORT_CACHE_KEY) || 'null'); } catch { /* An invalid cache is retried from the service. */ }
        let report: DossierReport;
        let archiveId: string;
        let createdAt: string;
        if (cached?.fingerprint === fingerprint && isDossierReport(cached.report) && typeof cached.archiveId === 'string' && typeof cached.createdAt === 'string' && Number.isFinite(Date.parse(cached.createdAt))) {
          ({ report, archiveId, createdAt } = cached);
        } else {
          const local = ['localhost', '127.0.0.1'].includes(location.hostname);
          report = await fetchDossier(local ? 'https://soulvirtues.org/api/generate-report' : '/api/generate-report', input);
          archiveId = 'SV-' + crypto.randomUUID().slice(0, 8).toUpperCase();
          createdAt = new Date().toISOString();
          try { localStorage.setItem(REPORT_CACHE_KEY, JSON.stringify({ fingerprint, report, archiveId, createdAt })); } catch { /* The displayed report remains downloadable when storage is full. */ }
        }
        render(report, input, archiveId, createdAt);
        ready.classList.remove('hidden');
        document.body.dataset.reportState = 'ready';
        download.disabled = false;
      } catch {
        errorPanel.classList.remove('hidden');
        document.body.dataset.reportState = 'error';
      } finally {
        loading.classList.add('hidden');
        retry.disabled = false;
      }
    }
    retry.addEventListener('click', loadReport);
    void loadReport();

    download.addEventListener('click', async () => {
      text('btn-pdf-text', 'GENERATING PDF...');
      download.disabled = true;
      try {
        const html2pdf = (window as Window & { html2pdf?: () => any }).html2pdf;
        if (!html2pdf) { window.print(); return; }
        await html2pdf().set({
          margin: [8, 8, 8, 8],
          filename: 'Soul-Virtues-Dossier-' + new Date().toISOString().slice(0, 10) + '.pdf',
          image: { type: 'jpeg', quality: 0.98 },
          html2canvas: { scale: 2, useCORS: true, backgroundColor: '#000000' },
          jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' },
        }).from(element('unlocked-report-card')).save();
      } catch {
        window.print();
      } finally {
        text('btn-pdf-text', 'DOWNLOAD DOSSIER (PDF)');
        download.disabled = false;
      }
    });
  </script>
  </body>
</html>
