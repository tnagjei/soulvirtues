---
// input: A private report link and a server-verified purchase
// output: The saved personal workbook, order status and print-ready pages
// pos: src/pages/success.astro (更新规则：交付变化同步 field-guide 脚本、样式、回归与 src/pages/README)
import '../styles/fonts.css';
import '../styles/report.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,follow" />
    <title>Your Soul Field Guide - Soul Virtues Extractor</title>
    <meta name="description" content="Your quiz answers, seven trait readings and a practical personal reflection workbook." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Strip the private report id, language and access token before Umami sees the URL. -->
    <script is:inline>
      window.umamiUrl = (event, payload) => {
        const safe = new URL(payload.url);
        safe.search = "";
        safe.hash = "";
        return { ...payload, url: safe.toString() };
      };
    </script>
    <script is:inline async src="https://umami-224lxlg6qa-uw.a.run.app/script.js" data-website-id="3feaa031-8dda-4eba-8f20-47ee94bdc3d8" data-domains="soulvirtues.org" data-before-send="umamiUrl"></script>
  </head>
  <body>
    <a class="skip-link no-print" href="#guide">Skip to your guide</a>
    <div id="preview-banner" class="preview-banner no-print" hidden></div>
    <header class="guide-top no-print">
      <a href="/" class="brand"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 1h4v1h1v1h2V2h1V1h4v1h1v1h1v6h-2v2h-2v2h-2v2H6v-2H4v-2H2V9H0V3h1V2h1z"/></svg>SOUL VIRTUES</a>
      <div class="tools">
        <label class="sr-only" for="report-language">Report language</label>
        <select id="report-language"><option value="en">English</option><option value="es">Español</option></select>
        <button id="save-pdf" class="primary" disabled>Save PDF</button>
        <button id="save-report-link" class="secondary" disabled hidden>Save private link</button>
      </div>
    </header>
    <section id="delivery-status" class="delivery-status no-print" role="status" hidden></section>
    <input id="private-report-link" class="private-report-link no-print" type="text" readonly hidden aria-label="Private report link" />
    <div class="guide-layout">
      <aside class="guide-nav no-print"><p id="contents-label">Inside your guide</p><nav id="contents" aria-label="Report sections"></nav><p id="save-state" role="status"></p></aside>
      <main id="guide" aria-busy="true">
        <section class="empty-state"><div class="empty-scene"><svg class="empty-art" viewBox="0 0 240 180" role="img" aria-label="A tiny soul waiting beside an unlit lantern">
          <g class="twinkle" fill="#d9e99d"><path d="M50 24h4v10h-4zM46 28h12v4H46z"/></g>
          <g class="twinkle late" fill="#42fcff"><path d="M190 42h4v10h-4zM186 46h12v4h-12z"/></g>
          <g fill="#38473b"><path d="M31 151h178v4H31zM43 158h154v3H43z"/></g>
          <g class="float">
            <path d="M77 62h86v12h12v76h-12v12H77v-12H65V74h12z" fill="#18201b" stroke="#d9e99d" stroke-width="4"/>
            <path d="M86 78h68v8H86zM78 86h84v48H78zM86 134h68v8H86z" fill="#101613" stroke="#4f604f" stroke-width="2"/>
            <g fill="#d9e99d"><path d="M98 100h12v12H98zM130 100h12v12h-12z"/></g>
            <g class="blink" fill="#101613"><path d="M101 103h6v6h-6zM133 103h6v6h-6z"/></g>
            <path d="M112 120h16v4h-16z" fill="#d9e99d"/>
            <path d="M96 136h8v8h-8zM136 136h8v8h-8z" fill="#42fcff"/>
            <path d="M70 58h12v4H70zM158 58h12v4h-12z" fill="#d9e99d"/>
          </g>
          <g fill="#d9e99d"><path d="M196 91h5v15h-5zM191 96h15v5h-15zM202 76h4v10h-4zM199 79h10v4h-10z"/></g>
        </svg></div><div class="empty-card"><h1>Your personal guide is waking up</h1><p>We are reading your saved answers and lighting the lantern one page at a time.</p></div></section>
      </main>
    </div>
    <noscript><section class="empty-state"><div class="empty-card"><h1>Light missing</h1><p>Enable JavaScript to read your saved quiz answers and open your guide.</p></div></section></noscript>
    <script>
      import '../scripts/field-guide';
    </script>
  </body>
</html>
