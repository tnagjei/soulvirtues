---
// input: None (primary landing page)
// output: Full SSR/SSG page fully aligned with AGENTS.md (What, Why, How, Features, FAQ, H1+H2+H3 structure)
// pos: src/pages/index.astro (更新规则：文件变更需同步本注释与所属目录 README)

import Layout from '../layouts/Layout.astro';
import Quiz from '../components/Quiz.astro';
import SoulCard from '../components/SoulCard.astro';
import FAQ, { FAQS } from '../components/FAQ.astro';
import { SOULS, SOUL_CODES } from '../data/souls';

const pageTitle = "Soul Virtues Extractor - Free 66-Question Soul Virtues Test";
const pageDescription = "Take the free 66-question Soul Virtues Extractor test. Discover your Undertale SOUL trait and color percentage across Determination, Bravery, Justice, and more.";

// Schema.org JSON-LD
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://soulvirtues.org/#website",
      "url": "https://soulvirtues.org/",
      "name": "Soul Virtues Extractor",
      "description": pageDescription
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://soulvirtues.org/#app",
      "name": "Soul Virtues Extractor & Undertale Soul Test",
      "applicationCategory": "EntertainmentApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://soulvirtues.org/#faq",
      "mainEntity": FAQS.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.a
        }
      }))
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl="https://soulvirtues.org/"
  structuredData={structuredData}
>
  <!-- Hero Section -->
  <section class="relative pt-12 pb-8 px-4 sm:px-6 text-center max-w-5xl mx-auto overflow-hidden">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-500/10 border border-red-500/20 text-red-400 text-xs font-mono font-semibold tracking-wider uppercase mb-6">
      <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
      Official 66-Question Trait Assessment
    </div>

    <h1 class="text-3xl sm:text-6xl font-black text-white font-mono tracking-tight leading-tight mb-4">
      SOUL VIRTUES <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 via-amber-400 to-purple-500">EXTRACTOR</span>
    </h1>

    <p class="text-base sm:text-xl text-gray-300 max-w-3xl mx-auto leading-relaxed mb-6 font-sans">
      Take the free 66-question <strong class="text-white">Soul Virtues Test</strong> to discover your Undertale SOUL profile across Determination, Bravery, Justice, Kindness, Patience, Integrity, and Perseverance.
    </p>

    <p class="text-xs sm:text-sm text-gray-400 max-w-2xl mx-auto mb-2 leading-normal">
      Which Undertale soul are you? Complete the assessment below to reveal your exact multi-dimensional trait breakdown and custom pixel-art soul card.
    </p>
  </section>

  <!-- Interactive Quiz Component -->
  <section id="test" class="px-4 sm:px-6 scroll-mt-20">
    <Quiz />
  </section>

  <!-- Section 1: What Is the Soul Virtues Extractor? -->
  <section class="py-16 px-4 sm:px-6 max-w-5xl mx-auto border-t border-gray-800/80">
    <div class="prose prose-invert max-w-none">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white font-mono tracking-wide mb-6 flex items-center gap-3">
        <span class="text-red-500">#</span> What Is the Soul Virtues Extractor?
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-gray-300 text-sm sm:text-base leading-relaxed">
        <div>
          <p class="mb-4">
            The <strong class="text-white">Soul Virtues Extractor</strong> is a 66-question Undertale-inspired soul test and personality quiz designed to measure seven human soul virtues.
          </p>
          <p class="mb-4">
            Traditional online quizzes force you into a single rigid box with questions like "What is your Undertale soul color?" In contrast, our <strong>Undertale Soul Test</strong> recognizes that human personality is multi-faceted. Every person possesses a unique blend of all seven human soul traits in differing proportions.
          </p>
        </div>
        <div>
          <p class="mb-4">
            By answering 66 calibrated statements, you receive a full <strong>7-Dimension Soul Virtues Profile</strong>. Each response affects multiple traits simultaneously, reflecting how real-world decisions involve trade-offs between courage, justice, empathy, discipline, and resolve.
          </p>
          <p>
            Whether you are searching for an <strong>Undertale Soul Quiz</strong>, exploring <strong>Deltarune Soul Test</strong> theories, or seeking deep insight into your personal strengths, this assessment provides transparent, nuanced, and shareable results.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: Why Take the Soul Virtues Extractor? (新增 Why 结构与 H3 层级) -->
  <section class="py-16 px-4 sm:px-6 max-w-5xl mx-auto border-t border-gray-800/80">
    <div class="prose prose-invert max-w-none">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white font-mono tracking-wide mb-6 flex items-center gap-3">
        <span class="text-purple-400">#</span> Why Take the Soul Virtues Extractor?
      </h2>

      <p class="text-sm sm:text-base text-gray-300 leading-relaxed mb-8">
        Most internet quizzes treat personality as a multiple-choice lottery. Here is why the 66-question Soul Virtues assessment delivers a genuinely richer and more reflective self-discovery experience:
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="bg-[#121420] border border-gray-800 p-6 rounded-xl">
          <h3 class="text-base font-bold text-white font-mono mb-2 text-red-400">
            1. Beyond Single-Label Stereotypes
          </h3>
          <p class="text-xs sm:text-sm text-gray-400 leading-relaxed">
            Real individuals cannot be reduced to a single word. Our continuous mathematical model captures the nuance of having strong Determination alongside deep Kindness, highlighting how your primary and secondary virtues complement each other.
          </p>
        </div>

        <div class="bg-[#121420] border border-gray-800 p-6 rounded-xl">
          <h3 class="text-base font-bold text-white font-mono mb-2 text-amber-400">
            2. Illuminating Inner Value Conflicts
          </h3>
          <p class="text-xs sm:text-sm text-gray-400 leading-relaxed">
            Every difficult choice involves ethical friction: should you speak out immediately (Bravery) or pause and observe (Patience)? By deducting conflicting weights when appropriate, the test reveals your instinctive priorities under pressure.
          </p>
        </div>

        <div class="bg-[#121420] border border-gray-800 p-6 rounded-xl">
          <h3 class="text-base font-bold text-white font-mono mb-2 text-emerald-400">
            3. Philosophical & Narrative Depth
          </h3>
          <p class="text-xs sm:text-sm text-gray-400 leading-relaxed">
            Rooted in the timeless themes of Toby Fox's Undertale, each soul virtue reflects an enduring human philosophy: standing firm through adversity, upholding integrity in silence, or choosing mercy in a cynical world.
          </p>
        </div>

        <div class="bg-[#121420] border border-gray-800 p-6 rounded-xl">
          <h3 class="text-base font-bold text-white font-mono mb-2 text-cyan-400">
            4. 100% Client-Side Privacy Guarantee
          </h3>
          <p class="text-xs sm:text-sm text-gray-400 leading-relaxed">
            Your personal reflections belong to you alone. All 66 answers are calculated entirely inside your device's web browser, with zero server tracking, zero advertising cookies, and zero mandatory registration.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3: What Are the Seven Undertale Soul Traits? -->
  <section id="virtues" class="py-16 px-4 sm:px-6 max-w-6xl mx-auto border-t border-gray-800/80 scroll-mt-20">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-2xl sm:text-4xl font-extrabold text-white font-mono tracking-wide mb-3">
        What Are the Seven Undertale Soul Traits?
      </h2>
      <p class="text-xs sm:text-sm text-gray-400">
        In the world of Undertale, human souls are categorized into seven distinctive colors, each representing a core moral virtue and behavioral drive.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {SOUL_CODES.map((code) => (
        <SoulCard soul={SOULS[code]} />
      ))}
    </div>
  </section>

  <!-- Section 4: What Is Your Undertale Soul Color? -->
  <section class="py-16 px-4 sm:px-6 max-w-5xl mx-auto border-t border-gray-800/80">
    <div class="bg-[#121420] border border-gray-800 rounded-2xl p-6 sm:p-10">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white font-mono tracking-wide mb-4 flex items-center gap-3">
        <span class="text-amber-400">#</span> What Is Your Undertale Soul Color?
      </h2>
      <p class="text-sm sm:text-base text-gray-300 leading-relaxed mb-6">
        Your highest Soul Virtue determines your leading soul color, while the complete result shows all seven virtue percentages. Rather than assigning a simplistic single color, this assessment reveals how your dominant soul color interacts with supporting virtues:
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm text-gray-300">
        <div class="p-4 bg-[#0b0c13] rounded-xl border border-gray-800/80">
          <span class="font-bold text-red-400 font-mono">RED SOUL · Determination</span>
          <p class="text-gray-400 text-xs mt-1">Unyielding resolve to push forward when all odds are stacked against you.</p>
        </div>
        <div class="p-4 bg-[#0b0c13] rounded-xl border border-gray-800/80">
          <span class="font-bold text-orange-400 font-mono">ORANGE SOUL · Bravery</span>
          <p class="text-gray-400 text-xs mt-1">Taking direct action and leading the charge despite palpable fear.</p>
        </div>
        <div class="p-4 bg-[#0b0c13] rounded-xl border border-gray-800/80">
          <span class="font-bold text-yellow-400 font-mono">YELLOW SOUL · Justice</span>
          <p class="text-gray-400 text-xs mt-1">Uncompromising stand for fairness, equality, and correcting wrongdoing.</p>
        </div>
        <div class="p-4 bg-[#0b0c13] rounded-xl border border-gray-800/80">
          <span class="font-bold text-green-400 font-mono">GREEN SOUL · Kindness</span>
          <p class="text-gray-400 text-xs mt-1">Active empathy, care, and choosing compassion over conflict.</p>
        </div>
        <div class="p-4 bg-[#0b0c13] rounded-xl border border-gray-800/80">
          <span class="font-bold text-cyan-400 font-mono">CYAN SOUL · Patience</span>
          <p class="text-gray-400 text-xs mt-1">Emotional serenity, calm endurance, and waiting for the right moment.</p>
        </div>
        <div class="p-4 bg-[#0b0c13] rounded-xl border border-gray-800/80">
          <span class="font-bold text-blue-400 font-mono">BLUE SOUL · Integrity</span>
          <p class="text-gray-400 text-xs mt-1">Upholding moral honesty and staying true to your core principles.</p>
        </div>
        <div class="p-4 bg-[#0b0c13] rounded-xl border border-gray-800/80 sm:col-span-2">
          <span class="font-bold text-purple-400 font-mono">PURPLE SOUL · Perseverance</span>
          <p class="text-gray-400 text-xs mt-1">Quiet discipline, methodical study, and finishing what you started.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 5: How the Scoring Algorithm Works -->
  <section id="scoring" class="py-16 px-4 sm:px-6 max-w-5xl mx-auto border-t border-gray-800/80 scroll-mt-20">
    <div class="bg-[#121420] border border-gray-800 rounded-2xl p-6 sm:p-10">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white font-mono tracking-wide mb-6 flex items-center gap-3">
        <span class="text-emerald-400">#</span> How the Scoring Algorithm Works
      </h2>

      <div class="space-y-6 text-sm text-gray-300 leading-relaxed">
        <p>
          Unlike standard tests that simply add +1 to a single category, the <strong>Soul Virtues Extractor</strong> uses a continuous mathematical scoring matrix:
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 my-6">
          <div class="bg-[#0b0c13] border border-gray-800 p-4 rounded-xl">
            <h3 class="text-xs font-mono font-bold text-red-400 uppercase mb-1">Multi-Trait Weighting</h3>
            <p class="text-xs text-gray-400">
              Each statement can contribute positively to primary virtues while deducting points from conflicting virtues.
            </p>
          </div>

          <div class="bg-[#0b0c13] border border-gray-800 p-4 rounded-xl">
            <h3 class="text-xs font-mono font-bold text-cyan-400 uppercase mb-1">50% Neutral Baseline</h3>
            <p class="text-xs text-gray-400">
              50% represents exact neutrality. Scores above 50% indicate natural alignment, while scores below 50% reflect lower preference.
            </p>
          </div>

          <div class="bg-[#0b0c13] border border-gray-800 p-4 rounded-xl">
            <h3 class="text-xs font-mono font-bold text-purple-400 uppercase mb-1">Non-Linear Power Curve</h3>
            <p class="text-xs text-gray-400">
              A mathematical power curve (factor 0.6) prevents clustering near the center, delivering distinct and expressive percentages.
            </p>
          </div>
        </div>

        <p>
          Neutral responses attribute 0 points, functioning as an effortless skip mechanism. Honest responses, especially regarding personal flaws and tough choices, produce the most accurate character profile.
        </p>
      </div>
    </div>
  </section>

  <!-- Section 6: Key Features (核心特性概览) -->
  <section class="py-16 px-4 sm:px-6 max-w-5xl mx-auto border-t border-gray-800/80">
    <div class="text-center max-w-3xl mx-auto mb-10">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white font-mono tracking-wide mb-3">
        Key Features & Highlights
      </h2>
      <p class="text-xs sm:text-sm text-gray-400">
        Engineered for speed, precision, and privacy.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-center">
      <div class="bg-[#121420] border border-gray-800 p-5 rounded-xl">
        <div class="text-2xl mb-2 text-red-400 font-mono">66</div>
        <h3 class="text-sm font-bold text-white mb-1">Calibrated Items</h3>
        <p class="text-xs text-gray-400">Carefully structured statements measuring moral trade-offs.</p>
      </div>

      <div class="bg-[#121420] border border-gray-800 p-5 rounded-xl">
        <div class="text-2xl mb-2 text-yellow-400 font-mono">7</div>
        <h3 class="text-sm font-bold text-white mb-1">Full Dimensions</h3>
        <p class="text-xs text-gray-400">Continuous percentage scores for every Undertale soul trait.</p>
      </div>

      <div class="bg-[#121420] border border-gray-800 p-5 rounded-xl">
        <div class="text-2xl mb-2 text-green-400 font-mono">PNG</div>
        <h3 class="text-sm font-bold text-white mb-1">Instant Share Card</h3>
        <p class="text-xs text-gray-400">Client-side Canvas rendering ready for Twitter and Discord.</p>
      </div>

      <div class="bg-[#121420] border border-gray-800 p-5 rounded-xl">
        <div class="text-2xl mb-2 text-cyan-400 font-mono">0%</div>
        <h3 class="text-sm font-bold text-white mb-1">Tracking or Ads</h3>
        <p class="text-xs text-gray-400">100% private, free, and runs purely inside your browser.</p>
      </div>
    </div>
  </section>

  <!-- Section 7: FAQ -->
  <section id="faq" class="py-16 px-4 sm:px-6 max-w-5xl mx-auto border-t border-gray-800/80 scroll-mt-20">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-2xl sm:text-4xl font-extrabold text-white font-mono tracking-wide mb-3">
        Frequently Asked Questions
      </h2>
      <p class="text-xs sm:text-sm text-gray-400">
        Everything you need to know about the Soul Virtues Extractor, Undertale soul traits, and test scoring.
      </p>
    </div>

    <FAQ />
  </section>
</Layout>

