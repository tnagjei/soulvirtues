---
// input: soul object with code, name, label, hex, tag, description, optional lang
// output: Polished individual virtue card with glowing heart, rich description, and direct link to single-trait SEO page
// pos: src/components/SoulCard.astro (更新规则：文件变更需同步本注释与所属目录 README)

import type { SoulDefinition, SoulCode } from '../data/souls';

interface Props {
  soul: SoulDefinition;
  lang?: string;
}

const { soul, lang = 'en' } = Astro.props;

const CODE_TO_SLUG: Record<SoulCode, string> = {
  DET: 'determination',
  BRV: 'bravery',
  JUS: 'justice',
  KND: 'kindness',
  PAT: 'patience',
  INT: 'integrity',
  PER: 'perseverance',
};

const slug = (soul.code && CODE_TO_SLUG[soul.code]) || soul.name.toLowerCase();
const soulsPrefix = lang === 'en' ? '/souls' : `/${lang}/souls`;
const detailLink = `${soulsPrefix}/${slug}/`;
---

<div
  class="pixel-card-sub p-6 relative overflow-hidden group flex flex-col justify-between"
  style={`--soul-color: ${soul.hex}`}
>
  <div>
    <div class="absolute -right-8 -top-8 w-32 h-32 rounded-full opacity-10 blur-2xl pointer-events-none group-hover:opacity-20 transition-opacity" style={`background: ${soul.hex}`}></div>

    <div class="flex items-start justify-between gap-4 mb-4">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 flex-shrink-0 drop-shadow-[0_0_8px_var(--soul-color)]" style={`color: ${soul.hex}`}>
          <svg viewBox="0 0 16 16" fill="currentColor" class="w-full h-full" shape-rendering="crispEdges">
            <path d="M2 0h4v1H2zm8 0h4v1h-4zM1 1h6v1H1zm8 0h6v1H9zM0 2h7v1H0zm9 2h7v1H9zM0 3h7v1H0zm9 3h7v1H9zM0 4h16v6H0zm2 6h12v2H2zm2 2h8v2H4zm2 2h4v2H6z"/>
          </svg>
        </div>
        <div>
          <h3 class="text-lg font-extrabold text-white font-mono tracking-wide">
            {soul.name}
          </h3>
          <span class="text-[11px] font-semibold tracking-wider uppercase font-mono px-2 py-0.5" style={`color: ${soul.hex}; background: ${soul.hex}15; border: 1px solid ${soul.hex}30`}>
            {soul.label} SOUL · {soul.hex}
          </span>
        </div>
      </div>
    </div>

    <blockquote class="italic text-xs text-gray-300 border-l-2 pl-3 py-1 mb-4 border-gray-700 font-serif">
      "{soul.tag}"
    </blockquote>

    <p class="text-xs text-gray-400 leading-relaxed mb-4">
      {soul.description}
    </p>
  </div>

  <div class="pt-3 border-t border-gray-800/80 mt-2">
    <a
      href={detailLink}
      class="inline-flex items-center gap-1 text-xs font-mono font-semibold transition-colors hover:underline"
      style={`color: ${soul.hex}`}
    >
      Explore {soul.name} Lore & Items →
    </a>
  </div>
</div>
