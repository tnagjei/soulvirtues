---
// input: Adsterra Banner 468x60 广告位 31860296 的固定 key 与脚本地址
// output: 桌面端页脚上方的固定尺寸广告，用 sandbox iframe 隔离，手机端不加载
// pos: src/components/AdsterraBanner468x60.astro（更新规则：广告位 ID 或投放策略变化需同步本注释与所属目录 README）

const AD_KEY = '6c632540ced8e5286e5f9b205db48570';
const AD_SRC = `https://bauval.org/22/${AD_KEY}`;
const adDoc = `<!DOCTYPE html><html><head><meta charset="utf-8"><base target="_blank"><style>html,body{margin:0;padding:0;overflow:hidden;background:transparent}</style></head><body><script>atOptions=${JSON.stringify({ key: AD_KEY, format: 'iframe', height: 60, width: 468, params: {} })};<\/script><script src="${AD_SRC}"><\/script></body></html>`;
---

<!-- 468px 定宽放不进手机屏：小屏隐藏并在脚本中跳过加载，避免产生不可见曝光 -->
<div class="adsterra-468 hidden sm:flex justify-center my-10 max-w-5xl mx-auto" data-adsterra-468>
  <iframe
    class="h-[60px] w-[468px] border-0"
    title="Advertisement"
    loading="lazy"
    scrolling="no"
    sandbox="allow-scripts allow-popups allow-popups-to-escape-sandbox"
    data-ad-doc={adDoc}
  ></iframe>
</div>

<script>
  const banner = document.querySelector<HTMLElement>('[data-adsterra-468]');
  const iframe = banner?.querySelector('iframe');

  if (banner && iframe instanceof HTMLIFrameElement && !iframe.srcdoc && window.matchMedia('(min-width: 640px)').matches) {
    const observer = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      observer.disconnect();
      iframe.srcdoc = iframe.dataset.adDoc || '';
    }, { rootMargin: '400px' });
    observer.observe(banner);
  }
</script>
