---
// input: lang ('en' | 'ja' | 'es' | 'pt' | 'ru')
// output: Sticky pixel-styled top navigation bar with in-page smooth anchor routing, test starter, responsive mobile menu, and 5-language switcher. Desktop language dropdown opens on hover, click/tap (touch has no hover, FB-29) and keyboard (arrows/Escape) with aria-expanded state.
// pos: src/components/Header.astro (更新规则：文件变更需同步本注释与所属目录 README)

import { getTranslations, locales, localeNames, type Locale } from '../i18n';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = getTranslations(lang);

const homeLink = lang === 'en' ? '/' : `/${lang}/`;
const testLink = lang === 'en' ? '/#test' : `/${lang}/#test`;
const virtuesLink = lang === 'en' ? '/#virtues' : `/${lang}/#virtues`;
const scoringLink = lang === 'en' ? '/#scoring' : `/${lang}/#scoring`;
const faqLink = lang === 'en' ? '/#faq' : `/${lang}/#faq`;
const rawCurrentPath = Astro.url.pathname.replace(/^\/(ja|es|pt|ru)(?=\/|$)/, '') || '/';
const currentPath = rawCurrentPath.replace(/\/?$/, '/');
const UNLOCALIZED_ROUTES = new Set(['/about/', '/contact/', '/privacy/', '/terms/']);
const isUnlocalized = UNLOCALIZED_ROUTES.has(currentPath);

const englishPath = currentPath;
const japanesePath = isUnlocalized ? '/ja/' : `/ja${currentPath === '/' ? '/' : currentPath}`;
const spanishPath = isUnlocalized ? '/es/' : `/es${currentPath === '/' ? '/' : currentPath}`;
const portuguesePath = isUnlocalized ? '/pt/' : `/pt${currentPath === '/' ? '/' : currentPath}`;
const russianPath = isUnlocalized ? '/ru/' : `/ru${currentPath === '/' ? '/' : currentPath}`;
---

<header class="sticky top-0 z-40 bg-black/95 backdrop-blur-md border-b-2 border-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Logo -->
    <a href={homeLink} class="flex items-center gap-3 group">
      <div class="w-7 h-7 text-red-500 transition-transform group-hover:scale-110 drop-shadow-[0_0_8px_rgba(239,68,68,0.6)]">
        <svg viewBox="0 0 16 16" fill="currentColor" class="w-full h-full" shape-rendering="crispEdges">
          <path d="M2 0h4v1H2zm8 0h4v1h-4zM1 1h6v1H1zm8 0h6v1H9zM0 2h7v1H0zm9 2h7v1H9zM0 3h7v1H0zm9 3h7v1H9zM0 4h16v6H0zm2 6h12v2H2zm2 2h8v2H4zm2 2h4v2H6z"/>
        </svg>
      </div>
      <span class="font-extrabold tracking-wider text-base sm:text-xl text-white font-mono">
        SOUL <span class="text-red-500">VIRTUES</span>
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-gray-300">
      <a href={testLink} class="hover:text-red-400 transition-colors">{t.nav.startTest}</a>
      <a href={virtuesLink} class="hover:text-amber-400 transition-colors">{t.nav.sevenVirtues}</a>
      <a href={scoringLink} class="hover:text-emerald-400 transition-colors">{t.nav.howItWorks}</a>
      <a href={faqLink} class="hover:text-cyan-400 transition-colors">{t.nav.faq}</a>
      <a href="/about/" class="hover:text-purple-400 transition-colors">{t.nav.about}</a>
    </nav>

    <!-- Right Controls: Language Selector & CTA & Mobile Toggle -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Language Selector (Desktop & Tablet) -->
      <div class="hidden md:block relative group" id="lang-menu-desktop">
        <button
          type="button"
          id="lang-menu-desktop-toggle"
          class="flex items-center gap-1.5 px-2.5 py-1.5 min-h-11 text-xs font-mono font-bold uppercase tracking-wider text-gray-200 bg-black border-2 border-gray-600 hover:border-white hover:text-white transition-all cursor-pointer touch-manipulation shadow-[2px_2px_0px_rgba(255,255,255,0.2)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-yellow-400 focus-visible:ring-offset-2 focus-visible:ring-offset-black"
          aria-label="Select Language"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="lang-menu-desktop-list"
        >
          <span class="text-sm" aria-hidden="true">🌐</span>
          <span>{localeNames[lang]?.name || 'Language'}</span>
          <span class="text-[10px] text-gray-400" aria-hidden="true">▼</span>
        </button>

        <!-- Dropdown Menu: hover + click + keyboard. Tap-driven via data-open="true" (FB-29).
             The data variant MUST match the value ("true"), otherwise Tailwind emits [data-open]
             and the menu would stay display:block while closed, swallowing clicks. -->
        <div
          id="lang-menu-desktop-list"
          class="hidden group-hover:block hover:block focus-within:block data-[open='true']:block absolute right-0 top-full pt-1.5 w-36 z-50"
          data-open="false"
        >
          <div class="bg-black border-2 border-white shadow-[3px_3px_0px_#ffffff] py-1 text-xs font-mono">
            <a
              href={englishPath}
              lang="en"
              class="block px-3 py-2 min-h-11 flex items-center hover:bg-white hover:text-black transition-colors ${lang === 'en' ? 'text-yellow-400 font-bold bg-gray-900/60' : 'text-gray-300'}"
            >
              * English
            </a>
            <a
              href={japanesePath}
              lang="ja"
              class="block px-3 py-2 min-h-11 flex items-center hover:bg-white hover:text-black transition-colors ${lang === 'ja' ? 'text-yellow-400 font-bold bg-gray-900/60' : 'text-gray-300'}"
            >
              * 日本語
            </a>
            <a
              href={spanishPath}
              lang="es"
              class="block px-3 py-2 min-h-11 flex items-center hover:bg-white hover:text-black transition-colors ${lang === 'es' ? 'text-yellow-400 font-bold bg-gray-900/60' : 'text-gray-300'}"
            >
              * Español
            </a>
            <a
              href={portuguesePath}
              lang="pt"
              class="block px-3 py-2 min-h-11 flex items-center hover:bg-white hover:text-black transition-colors ${lang === 'pt' ? 'text-yellow-400 font-bold bg-gray-900/60' : 'text-gray-300'}"
            >
              * Português
            </a>
            <a
              href={russianPath}
              lang="ru"
              class="block px-3 py-2 min-h-11 flex items-center hover:bg-white hover:text-black transition-colors ${lang === 'ru' ? 'text-yellow-400 font-bold bg-gray-900/60' : 'text-gray-300'}"
            >
              * Русский
            </a>
          </div>
        </div>
      </div>

      <!-- Take Quiz CTA Button -->
      <a
        href={testLink}
        class="hidden sm:inline-flex items-center justify-center px-3.5 py-1.5 text-xs font-bold uppercase tracking-wider text-black bg-white hover:bg-gray-200 transition-all shadow-[2px_2px_0px_rgba(255,255,255,0.4)] active:scale-95 font-mono"
      >
        {t.nav.takeQuiz}
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        id="btn-mobile-menu"
        type="button"
        class="md:hidden p-2 text-gray-300 hover:text-white border-2 border-gray-600 hover:border-white bg-black cursor-pointer shadow-[2px_2px_0px_rgba(255,255,255,0.2)]"
        aria-label="Toggle navigation menu"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Panel -->
  <div id="mobile-menu-panel" class="hidden md:hidden bg-black border-b-2 border-white px-4 py-4 space-y-3 font-mono text-sm">
    <nav class="flex flex-col space-y-2 border-b border-gray-800 pb-3">
      <a href={testLink} class="mobile-nav-link text-gray-200 hover:text-red-400 py-1">* {t.nav.startTest}</a>
      <a href={virtuesLink} class="mobile-nav-link text-gray-200 hover:text-amber-400 py-1">* {t.nav.sevenVirtues}</a>
      <a href={scoringLink} class="mobile-nav-link text-gray-200 hover:text-emerald-400 py-1">* {t.nav.howItWorks}</a>
      <a href={faqLink} class="mobile-nav-link text-gray-200 hover:text-cyan-400 py-1">* {t.nav.faq}</a>
      <a href="/about/" class="mobile-nav-link text-gray-200 hover:text-purple-400 py-1">* {t.nav.about}</a>
    </nav>

    <!-- Mobile Language Switcher (2x2 Grid) -->
    <div class="pt-2">
      <div class="text-xs text-gray-400 uppercase tracking-widest mb-2 flex items-center gap-1.5">
        <span>🌐</span> Language / Idioma / 言語 / Язык
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-xs">
        <a
          href={englishPath}
          class={`px-3 py-2 text-center border-2 transition-colors ${lang === 'en' ? 'border-yellow-400 text-yellow-400 bg-gray-900 font-bold' : 'border-gray-700 text-gray-400 hover:border-white hover:text-white'}`}
        >
          English
        </a>
        <a
          href={japanesePath}
          class={`px-3 py-2 text-center border-2 transition-colors ${lang === 'ja' ? 'border-yellow-400 text-yellow-400 bg-gray-900 font-bold' : 'border-gray-700 text-gray-400 hover:border-white hover:text-white'}`}
        >
          日本語
        </a>
        <a
          href={spanishPath}
          class={`px-3 py-2 text-center border-2 transition-colors ${lang === 'es' ? 'border-yellow-400 text-yellow-400 bg-gray-900 font-bold' : 'border-gray-700 text-gray-400 hover:border-white hover:text-white'}`}
        >
          Español
        </a>
        <a
          href={portuguesePath}
          class={`px-3 py-2 text-center border-2 transition-colors ${lang === 'pt' ? 'border-yellow-400 text-yellow-400 bg-gray-900 font-bold' : 'border-gray-700 text-gray-400 hover:border-white hover:text-white'}`}
        >
          Português
        </a>
        <a
          href={russianPath}
          class={`px-3 py-2 text-center border-2 transition-colors ${lang === 'ru' ? 'border-yellow-400 text-yellow-400 bg-gray-900 font-bold' : 'border-gray-700 text-gray-400 hover:border-white hover:text-white'}`}
        >
          Русский
        </a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  function initHeaderNav() {
    const btn = document.getElementById('btn-mobile-menu');
    const panel = document.getElementById('mobile-menu-panel');
    if (btn && panel && !btn.dataset.bound) {
      btn.dataset.bound = 'true';
      btn.addEventListener('click', () => {
        panel.classList.toggle('hidden');
      });
      panel.querySelectorAll('.mobile-nav-link').forEach(link => {
        link.addEventListener('click', () => {
          panel.classList.add('hidden');
        });
      });
    }

    initLangSwitcher();

    if (!document.documentElement.dataset.anchorBound) {
      document.documentElement.dataset.anchorBound = 'true';
      document.addEventListener('click', (e) => {
        const link = e.target.closest('a');
        if (!link) return;
        const href = link.getAttribute('href');
        if (!href || href.startsWith('http://') || href.startsWith('https://')) return;

        const hashIndex = href.indexOf('#');
        if (hashIndex === -1) return;

        const targetHash = href.slice(hashIndex);
        const targetPath = href.slice(0, hashIndex);
        const currentPath = window.location.pathname;

        const isCurrentPage = targetPath === '' ||
                              targetPath === currentPath ||
                              (targetPath === '/' && (currentPath === '' || currentPath === '/'));

        if (isCurrentPage) {
          const targetId = targetHash.slice(1);
          const targetEl = document.getElementById(targetId);
          if (targetEl) {
            e.preventDefault();
            if (window.location.hash !== targetHash) {
              history.pushState(null, '', targetHash);
            }
            targetEl.scrollIntoView({ behavior: 'smooth' });

            if (targetId === 'test' && typeof window.startSoulQuiz === 'function') {
              window.startSoulQuiz();
            }
          }
        }
      });
    }
  }

  // Desktop language dropdown: hover (CSS) + click/tap + keyboard (JS).
  // Touch devices have no hover, so click must open it on its own — FB-29.
  function initLangSwitcher() {
    const wrap = document.getElementById('lang-menu-desktop');
    const toggle = document.getElementById('lang-menu-desktop-toggle');
    const list = document.getElementById('lang-menu-desktop-list');
    if (!wrap || !toggle || !list || toggle.dataset.langBound) return;
    toggle.dataset.langBound = 'true';
    // Start closed and inert so the five options never precede the toggle in tab order.
    list.setAttribute('inert', '');

    const setOpen = (open) => {
      list.dataset.open = open ? 'true' : 'false';
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      // Keep the closed options out of the tab order, otherwise keyboard users
      // tab into invisible links before ever reaching the toggle itself.
      if (open) {
        list.removeAttribute('inert');
      } else {
        list.setAttribute('inert', '');
      }
    };

    const close = (returnFocus) => {
      setOpen(false);
      if (returnFocus) toggle.focus();
    };

    // Click / tap toggles the menu. No preventDefault() here on purpose: this button
    // has no default action, and cancelling the event would suppress the native
    // keyboard activation (Enter/Space on a <button> fires click) that keyboard
    // users rely on. Touch browsers also synthesise hover on tap, so the visible
    // state is driven by data-open rather than by pointer position.
    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    // Enter/Space are handled explicitly rather than relying on native button
    // activation: behaviour for synthetic key events is inconsistent across
    // browsers, and a keyboard user must always be able to open this menu.
    toggle.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ' || e.key === 'Spacebar') {
        e.preventDefault();
        setOpen(toggle.getAttribute('aria-expanded') !== 'true');
        return;
      }
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        setOpen(true);
        const links = list.querySelectorAll('a');
        if (links.length) {
          const idx = e.key === 'ArrowDown' ? 0 : links.length - 1;
          links[idx].focus();
        }
      } else if (e.key === 'Escape') {
        e.preventDefault();
        close(false);
      }
    });

    list.addEventListener('keydown', (e) => {
      const links = Array.from(list.querySelectorAll('a'));
      const idx = links.indexOf(document.activeElement);
      if (e.key === 'Escape') {
        e.preventDefault();
        close(true);
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        links[(idx + 1) % links.length]?.focus();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        links[(idx - 1 + links.length) % links.length]?.focus();
      } else if (e.key === 'Tab' && idx === links.length - 1 && !e.shiftKey) {
        close(false);
      }
    });

    // Pointer leaves the whole control without selecting anything -> collapse.
    wrap.addEventListener('mouseleave', () => setOpen(false));

    // Dismiss when tapping/clicking anywhere outside the control.
    if (!document.documentElement.dataset.langDismissBound) {
      document.documentElement.dataset.langDismissBound = 'true';
      document.addEventListener('click', (e) => {
        const control = document.getElementById('lang-menu-desktop');
        if (!control) return;
        const open = control.querySelector('[data-open="true"]');
        if (!open) return;
        if (!control.contains(e.target)) closeState(control, false);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        const control = document.getElementById('lang-menu-desktop');
        if (!control) return;
        const open = control.querySelector('[data-open="true"]');
        if (!open) return;
        closeState(control, false);
      });
    }
  }

  // Shared close path so aria-expanded and inert always move together.
  function closeState(control, returnFocus) {
    const list = control.querySelector('[id$="-list"]');
    const toggle = control.querySelector('[id$="-toggle"]');
    if (list) list.dataset.open = 'false';
    if (toggle) toggle.setAttribute('aria-expanded', 'false');
    if (list) list.setAttribute('inert', '');
    if (returnFocus && toggle) toggle.focus();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeaderNav);
  } else {
    initHeaderNav();
  }
  document.addEventListener('astro:page-load', initHeaderNav);
</script>
