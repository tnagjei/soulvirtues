---
// input: lang ('en' | 'ja' | 'es' | 'pt'), static scoring data, localized dictionaries, and six approved comparison pairs
// output: Four-language 66-question quiz with explicit mobile answer controls, localized results, comparison links, review, gallery, and share card
// pos: src/components/Quiz.astro (更新规则：文件变更需同步本注释与所属目录 README)

import { getTranslations, type Locale } from '../i18n';
import { SOUL_CODES } from '../data/souls';
import { MAXP } from '../data/scoring';
import { SOUL_DETAILS } from '../data/soulDetails';
import { SOUL_COMPARISONS } from '../data/soulComparisons';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = getTranslations(lang);

const questionsJson = JSON.stringify(t.questions);
const soulsJson = JSON.stringify(t.souls);
const soulCodesJson = JSON.stringify(SOUL_CODES);
const maxpJson = JSON.stringify(MAXP);
const quizUIJson = JSON.stringify(t.quizUI);
const comparisonPairsJson = JSON.stringify(Object.fromEntries(
  SOUL_COMPARISONS.map((comparison) => {
    const key = [SOUL_DETAILS[comparison.leftSlug].code, SOUL_DETAILS[comparison.rightSlug].code].sort().join('-');
    const prefix = lang === 'en' ? '' : `/${lang}`;
    return [key, {
      path: `${prefix}/compare/${comparison.slug}`,
      label: `${comparison.copy[lang].heading} →`,
    }];
  }),
));
---

<div
  id="quiz-root"
  class="w-full max-w-4xl mx-auto my-6 font-mono text-white select-none relative"
  data-lang={lang}
  data-questions={questionsJson}
  data-souls={soulsJson}
  data-soul-codes={soulCodesJson}
  data-maxp={maxpJson}
  data-quiz-ui={quizUIJson}
  data-comparison-pairs={comparisonPairsJson}
>
  <!-- Background Audio Elements -->
  <audio id="audio-bgm" loop preload="auto" src="/audio/AUDIO_ANOTHERHIM.ogg"></audio>
  <audio id="audio-move" preload="auto" src="/audio/snd_menumove.wav"></audio>
  <audio id="audio-select" preload="auto" src="/audio/snd_select.wav"></audio>
  <audio id="audio-appear" preload="auto" src="/audio/AUDIO_APPEARANCE.wav"></audio>

  <!-- Top Bar: Title & Pixel Settings Button -->
  <div class="flex items-center justify-between mb-4 px-2 text-xs text-gray-300">
    <div class="flex items-center gap-2">
      <span class="inline-block w-2.5 h-2.5 rounded-full bg-red-500 animate-pulse"></span>
      <span class="tracking-widest uppercase text-xs font-bold font-sans">{t.quizUI.title}</span>
    </div>

    <!-- SETTINGS Button -->
    <div class="relative">
      <button
        id="btn-open-settings"
        type="button"
        class="px-3 py-1.5 bg-black border-2 sm:border-3 border-white hover:bg-white hover:text-black text-white rounded-none text-xs sm:text-sm font-mono tracking-widest uppercase transition-all cursor-pointer flex items-center gap-2 active:scale-95 shadow-[2px_2px_0px_#ffffff]"
        title="Audio and Sound Settings"
      >
        <span id="sound-indicator-icon">🔊</span>
        <span>{t.quizUI.settingsBtn}</span>
      </button>

      <!-- Settings Dropdown / Modal -->
      <div
        id="settings-modal"
        class="hidden absolute right-0 top-full mt-2 w-72 sm:w-80 bg-black border-4 border-white p-4 shadow-[4px_4px_0px_rgba(255,255,255,0.4)] z-50 text-white font-mono"
      >
        <div class="flex items-center justify-between border-b-2 border-gray-700 pb-2 mb-4">
          <span class="font-bold text-sm tracking-widest text-yellow-400 uppercase">{t.quizUI.audioSettingsTitle}</span>
          <button id="btn-close-settings" class="text-xs text-gray-400 hover:text-white border border-gray-600 px-1.5 py-0.5 cursor-pointer">
            ✕
          </button>
        </div>

        <!-- BGM Volume Slider -->
        <div class="mb-4">
          <div class="flex justify-between items-center text-xs mb-1.5">
            <span class="text-gray-300 tracking-wider">{t.quizUI.musicBgmLabel}</span>
            <span id="label-vol-music" class="text-red-400 font-bold">30%</span>
          </div>
          <div class="flex items-center gap-3">
            <input
              id="slider-vol-music"
              type="range"
              min="0"
              max="100"
              value="30"
              class="pixel-slider flex-1"
            />
            <button
              id="btn-toggle-music-mute"
              class="px-2 py-1 text-[11px] bg-black border border-gray-500 hover:border-white text-gray-300 cursor-pointer"
            >
              {t.quizUI.muteBtn}
            </button>
          </div>
        </div>

        <!-- SFX Volume Slider -->
        <div class="mb-4">
          <div class="flex justify-between items-center text-xs mb-1.5">
            <span class="text-gray-300 tracking-wider">{t.quizUI.soundSfxLabel}</span>
            <span id="label-vol-sfx" class="text-yellow-400 font-bold">40%</span>
          </div>
          <div class="flex items-center gap-3">
            <input
              id="slider-vol-sfx"
              type="range"
              min="0"
              max="100"
              value="40"
              class="pixel-slider flex-1"
            />
            <button
              id="btn-toggle-sfx-mute"
              class="px-2 py-1 text-[11px] bg-black border border-gray-500 hover:border-white text-gray-300 cursor-pointer"
            >
              {t.quizUI.muteBtn}
            </button>
          </div>
        </div>

        <div class="pt-2 border-t border-gray-800 text-[10px] text-gray-400 text-center font-sans">
          {t.quizUI.soundEngineNote}
        </div>
      </div>
    </div>
  </div>

  <!-- 0. Void Intro Sequence -->
  <div id="quiz-intro" class="hidden min-h-[300px] sm:min-h-[360px] relative cursor-pointer" title="Click or press Z to continue">
    <div class="absolute inset-0 flex items-center justify-center px-4">
      <div class="text-xl sm:text-3xl font-normal leading-relaxed text-white tracking-widest text-center max-w-2xl">
        <span id="intro-type" class="inline"></span>
      </div>
    </div>
    <div class="absolute bottom-1 right-1 sm:bottom-2 sm:right-2 flex items-center gap-3 sm:gap-4">
      <span class="text-[11px] sm:text-xs text-gray-500 tracking-wider font-sans">{t.quizUI.introContinueHint}</span>
      <button
        id="btn-skip-intro"
        type="button"
        class="px-3 py-1.5 bg-black border-2 border-gray-600 hover:border-white text-gray-300 hover:text-white text-xs tracking-widest uppercase cursor-pointer active:scale-95 transition-all"
      >
        {t.quizUI.skipBtn}
      </button>
    </div>
  </div>

  <!-- 1. Start Screen -->
  <div id="quiz-start" class="pixel-box p-6 sm:p-12 text-center relative overflow-hidden">
    <div class="w-16 h-16 mx-auto mb-6 text-red-500 drop-shadow-[0_0_18px_rgba(255,0,0,0.85)] animate-pulse">
      <svg viewBox="0 0 16 16" fill="currentColor" class="w-full h-full" shape-rendering="crispEdges">
        <path d="M2 0h4v1H2zm8 0h4v1h-4zM1 1h6v1H1zm8 0h6v1H9zM0 2h7v1H0zm9 2h7v1H9zM0 3h7v1H0zm9 3h7v1H9zM0 4h16v6H0zm2 6h12v2H2zm2 2h8v2H4zm2 2h4v2H6z"/>
      </svg>
    </div>

    <h2 class="text-2xl sm:text-4xl font-extrabold text-white tracking-widest uppercase mb-4">
      {t.quizUI.startTitle}
    </h2>
    <p class="text-xs sm:text-sm text-gray-300 max-w-xl mx-auto mb-8 leading-relaxed font-sans">
      {t.quizUI.startDesc}
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <button
        id="btn-start-fresh"
        class="w-full sm:w-auto px-8 py-4 bg-black border-4 border-white hover:bg-white hover:text-black text-white font-bold text-base uppercase tracking-widest active:scale-95 transition-all cursor-pointer shadow-[4px_4px_0px_rgba(255,255,255,0.4)]"
      >
        {t.quizUI.startProceedBtn}
      </button>

      <button
        id="btn-resume-quiz"
        class="hidden w-full sm:w-auto px-6 py-4 bg-black border-4 border-yellow-400 text-yellow-400 hover:bg-yellow-400 hover:text-black font-bold text-sm uppercase tracking-widest active:scale-95 transition-all cursor-pointer shadow-[4px_4px_0px_rgba(250,204,21,0.4)]"
      >
        {t.quizUI.startResumeBtn} (<span id="resume-count">0</span>/66)
      </button>
    </div>

    <div class="mt-8 pt-6 border-t border-gray-800 flex flex-wrap items-center justify-center gap-6 text-xs text-gray-400 font-sans">
      {t.quizUI.startFeatures.map(feat => (
        <span>{feat}</span>
      ))}
    </div>
  </div>

  <!-- 2. Active Quiz Screen (Undertale Style) -->
  <div id="quiz-active" class="hidden">
    <!-- HUD Header -->
    <div id="hud" class="flex items-center gap-3 sm:gap-4 mb-4">
      <span id="hud-index" class="text-xl sm:text-2xl font-bold tracking-widest text-white whitespace-nowrap">01 / 66</span>
      <div id="completion-bar-track" class="flex-1 h-7 border-4 border-white bg-black p-0.5">
        <div id="progress-fill" class="h-full bg-red-600 w-0 transition-all duration-150"></div>
      </div>
      <button
        id="btn-quiz-reset"
        class="px-2.5 py-1 text-xs text-gray-400 hover:text-white border-2 border-gray-700 hover:border-white bg-black uppercase tracking-wider cursor-pointer"
        title="Reset all progress"
      >
        {t.quizUI.hudResetBtn}
      </button>
    </div>

    <!-- Dialogue Box (Authentic Undertale Typewriter text) -->
    <div
      id="dialogue-box"
      class="pixel-box p-6 sm:p-8 mb-6 min-h-[140px] sm:min-h-[160px] cursor-pointer"
      title={t.quizUI.dialogueHint}
    >
      <div id="questions-text" class="text-xl sm:text-3xl font-normal leading-relaxed text-white tracking-wide break-words">
        <span class="text-white mr-3 font-bold select-none">*</span>
        <span id="questions-type" class="inline"></span>
      </div>
    </div>

    <!-- Answers Box (5-point Scale with Animated Red Heart Selector) -->
    <div id="answers-box" class="pixel-box p-6 sm:p-8 mb-6">
      <p id="tap-answer-hint" class="sm:hidden mb-4 text-center text-xs font-bold uppercase tracking-widest text-yellow-400">
        * {t.quizUI.tapAnswerHint}
      </p>

      <!-- Extremes labels -->
      <div class="flex justify-between items-baseline text-[10px] sm:text-sm text-gray-400 tracking-wider mb-4 sm:mb-6">
        <span id="label-extreme-left" class="uppercase">{t.quizUI.extremeLeft}</span>
        <span id="label-extreme-right" class="uppercase">{t.quizUI.extremeRight}</span>
      </div>

      <!-- 5-Point Scale Row -->
      <div id="scale-row" class="flex items-stretch justify-between gap-1 sm:gap-2 relative py-2 sm:py-4 sm:px-8">
        <!-- Scale points generated via JS -->
      </div>

      <!-- Centered Selected Option Label -->
      <div class="text-center mt-6 min-h-[2em] flex items-center justify-center">
        <span id="selected-label-text" class="text-xl sm:text-3xl font-bold text-white tracking-widest uppercase">
          {t.quizUI.likertLabels[2]}
        </span>
      </div>
    </div>

    <!-- Footer Controls & Hints -->
    <div id="question-footer" class="flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-gray-400">
      <div class="flex items-center gap-3 w-full sm:w-auto">
        <button
          id="btn-prev"
          class="flex-1 sm:flex-none px-5 py-2.5 bg-black border-2 border-gray-600 hover:border-white text-gray-300 hover:text-white uppercase tracking-wider disabled:opacity-30 disabled:pointer-events-none cursor-pointer active:scale-95 transition-all"
        >
          [X] {t.quizUI.backBtn}
        </button>
        <button
          id="btn-next"
          class="hidden sm:inline-flex px-7 py-2.5 bg-black border-2 border-red-500 hover:bg-red-500 hover:text-white text-red-400 font-bold uppercase tracking-wider cursor-pointer active:scale-95 transition-all"
        >
          [Z] {t.quizUI.confirmBtn}
        </button>
      </div>

      <div class="hidden sm:block text-[11px] text-gray-400 text-center sm:text-right font-sans">
        <span>LEFT / RIGHT move &nbsp;·&nbsp; 1-5 jump &nbsp;·&nbsp; Z or ENTER confirm &nbsp;·&nbsp; X back</span>
      </div>
    </div>
  </div>

  <!-- 3. Result Screen -->
  <div id="quiz-result" class="hidden pixel-box p-6 sm:p-12 relative overflow-hidden">
    <!-- Top Result Banner -->
    <div class="text-center mb-10">
      <div id="result-heart" class="w-24 h-24 mx-auto mb-4 drop-shadow-[0_0_25px_var(--res-color)]" style="--res-color: #ff0000; color: #ff0000;">
        <svg viewBox="0 0 16 16" fill="currentColor" class="w-full h-full" shape-rendering="crispEdges">
          <path d="M2 0h4v1H2zm8 0h4v1h-4zM1 1h6v1H1zm8 0h6v1H9zM0 2h7v1H0zm9 2h7v1H9zM0 3h7v1H0zm9 3h7v1H9zM0 4h16v6H0zm2 6h12v2H2zm2 2h8v2H4zm2 2h4v2H6z"/>
        </svg>
      </div>

      <div class="inline-block px-3 py-1 text-xs font-mono font-bold tracking-widest uppercase mb-2 border-2" id="result-badge" style="color: #ff0000; border-color: #ff0000;">
        {t.quizUI.primaryVirtue}
      </div>

      <h3 id="result-trait-name" class="text-3xl sm:text-5xl font-black tracking-widest text-white mb-2 uppercase">
        DETERMINATION
      </h3>

      <p id="result-color-label" class="text-xs sm:text-sm text-gray-400 tracking-widest mb-4">
        RED SOUL · #FF0000
      </p>

      <blockquote id="result-tagline" class="italic text-sm sm:text-base text-gray-300 max-w-xl mx-auto font-serif border-y border-gray-800 py-3">
        "Despite how many times I fell, I always got back up."
      </blockquote>

      <p id="result-description" class="text-xs sm:text-sm text-gray-300 max-w-2xl mx-auto mt-6 leading-relaxed font-sans text-left bg-black/60 border-2 border-gray-800 p-5">
        <!-- Injected via JS -->
      </p>

      <!-- Direct High-Converting Soul Trait Subpage Internal Link -->
      <div class="mt-6 text-center">
        <a
          id="btn-explore-dominant-soul"
          href="/souls/determination/"
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-black border-2 border-yellow-400 hover:bg-yellow-400 hover:text-black text-yellow-400 font-bold font-mono text-xs sm:text-sm tracking-wider uppercase shadow-[3px_3px_0px_rgba(250,204,21,0.5)] active:translate-x-[2px] active:translate-y-[2px] transition-all group"
        >
          <span class="text-base group-hover:scale-110 transition-transform">📖</span>
          <span id="btn-explore-dominant-text">Explore Determination Lore, Items & Combat Mechanics →</span>
        </a>
      </div>
    </div>

    <!-- Secondary Virtue / Shadow Trait Callout -->
    <div id="secondary-callout" class="mb-10 p-5 bg-black border-3 border-gray-700 relative">
      <div class="flex items-start gap-4">
        <div id="secondary-heart" class="w-8 h-8 flex-shrink-0 mt-0.5" style="color: #42fcff;">
          <svg viewBox="0 0 16 16" fill="currentColor" class="w-full h-full" shape-rendering="crispEdges">
            <path d="M2 0h4v1H2zm8 0h4v1h-4zM1 1h6v1H1zm8 0h6v1H9zM0 2h7v1H0zm9 2h7v1H9zM0 3h7v1H0zm9 3h7v1H9zM0 4h16v6H0zm2 6h12v2H2zm2 2h8v2H4zm2 2h4v2H6z"/>
          </svg>
        </div>
        <div class="flex-1">
          <div class="text-[11px] text-gray-400 uppercase tracking-widest font-bold mb-1">{t.quizUI.secondaryVirtue}</div>
          <div class="text-base sm:text-lg font-bold text-white mb-1">
            <span id="secondary-name">PATIENCE</span> · <span id="secondary-pct" class="text-yellow-400">78.4%</span>
          </div>
          <p id="secondary-desc" class="text-xs text-gray-300 leading-relaxed font-sans">
            <!-- Injected via JS -->
          </p>
          <a
            id="btn-compare-top-souls"
            href={lang === 'en' ? '/compare/bravery-vs-determination/' : `/${lang}/compare/bravery-vs-determination/`}
            class="hidden mt-4 items-center gap-2 border-2 border-purple-500 px-4 py-2.5 text-xs font-mono font-bold text-purple-300 hover:bg-purple-500 hover:text-black transition-colors"
          >
            Compare top two traits →
          </a>
        </div>
      </div>
    </div>

    <!-- 7 Virtues Breakdown Progress Bars -->
    <div class="mb-10">
      <h4 class="text-center font-bold text-sm sm:text-base tracking-widest text-white uppercase mb-6 flex items-center justify-center gap-3">
        <span class="text-red-500">★</span> {t.quizUI.breakdownTitle} <span class="text-red-500">★</span>
      </h4>
      <div id="virtue-bars" class="space-y-4 max-w-2xl mx-auto">
        <!-- 7 Bars injected via JS -->
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="flex flex-col sm:flex-row flex-wrap items-center justify-center gap-3 pt-6 border-t-2 border-gray-800">
      <button
        id="btn-download-card"
        class="w-full sm:w-auto px-5 py-3 bg-black border-3 border-green-500 hover:bg-green-500 hover:text-black text-green-400 font-bold text-xs uppercase tracking-widest active:scale-95 transition-all cursor-pointer shadow-[3px_3px_0px_rgba(34,197,94,0.4)]"
      >
        💾 {t.quizUI.downloadCardBtn}
      </button>

      <button
        id="btn-copy-result"
        class="w-full sm:w-auto px-5 py-3 bg-black border-3 border-yellow-400 hover:bg-yellow-400 hover:text-black text-yellow-400 font-bold text-xs uppercase tracking-widest active:scale-95 transition-all cursor-pointer shadow-[3px_3px_0px_rgba(250,204,21,0.4)]"
      >
        📋 {t.quizUI.copyResultBtn}
      </button>

      <button
        id="btn-review-answers"
        class="w-full sm:w-auto px-5 py-3 bg-black border-3 border-cyan-400 hover:bg-cyan-400 hover:text-black text-cyan-400 font-bold text-xs uppercase tracking-widest active:scale-95 transition-all cursor-pointer shadow-[3px_3px_0px_rgba(6,182,212,0.4)]"
      >
        📝 {t.quizUI.reviewAnswersBtn}
      </button>

      <button
        id="btn-browse-souls"
        class="w-full sm:w-auto px-5 py-3 bg-black border-3 border-purple-400 hover:bg-purple-400 hover:text-black text-purple-400 font-bold text-xs uppercase tracking-widest active:scale-95 transition-all cursor-pointer shadow-[3px_3px_0px_rgba(192,132,252,0.4)]"
      >
        📖 {t.quizUI.browseSoulsBtn}
      </button>

      <button
        id="btn-retake"
        class="w-full sm:w-auto px-5 py-3 bg-black border-3 border-white hover:bg-white hover:text-black text-white font-bold text-xs uppercase tracking-widest active:scale-95 transition-all cursor-pointer shadow-[3px_3px_0px_rgba(255,255,255,0.4)]"
      >
        ↺ {t.quizUI.retakeBtn}
      </button>
    </div>
  </div>

  <!-- 4. Review Screen -->
  <div id="quiz-review" class="hidden pixel-box p-6 sm:p-10 relative">
    <div class="flex items-center justify-between border-b-2 border-gray-700 pb-4 mb-6">
      <h3 class="text-lg sm:text-xl font-bold tracking-widest text-cyan-400 uppercase">
        {t.quizUI.reviewTitle}
      </h3>
      <button
        id="btn-review-back"
        class="px-4 py-2 bg-black border-2 border-white hover:bg-white hover:text-black text-white text-xs uppercase tracking-wider cursor-pointer active:scale-95"
      >
        ← {t.quizUI.reviewBackBtn}
      </button>
    </div>

    <div id="review-list" class="space-y-4 max-h-[500px] overflow-y-auto pr-2 text-xs sm:text-sm font-sans">
      <!-- 66 questions and answers injected via JS -->
    </div>
  </div>

  <!-- 5. Souls Gallery Screen -->
  <div id="quiz-souls" class="hidden pixel-box p-6 sm:p-10 relative">
    <div class="flex items-center justify-between border-b-2 border-gray-700 pb-4 mb-6">
      <h3 class="text-lg sm:text-xl font-bold tracking-widest text-purple-400 uppercase">
        {t.quizUI.soulsGalleryTitle}
      </h3>
      <button
        id="btn-souls-back"
        class="px-4 py-2 bg-black border-2 border-white hover:bg-white hover:text-black text-white text-xs uppercase tracking-wider cursor-pointer active:scale-95"
      >
        ← {t.quizUI.soulsBackBtn}
      </button>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6" id="souls-grid">
      <!-- Injected via JS -->
    </div>

    <div id="soul-detail" class="hidden p-6 bg-black border-3 border-white">
      <div class="flex items-center gap-4 mb-4">
        <div id="soul-detail-heart" class="w-12 h-12 flex-shrink-0">
          <svg viewBox="0 0 16 16" fill="currentColor" class="w-full h-full" shape-rendering="crispEdges">
            <path d="M2 0h4v1H2zm8 0h4v1h-4zM1 1h6v1H1zm8 0h6v1H9zM0 2h7v1H0zm9 2h7v1H9zM0 3h7v1H0zm9 3h7v1H9zM0 4h16v6H0zm2 6h12v2H2zm2 2h8v2H4zm2 2h4v2H6z"/>
          </svg>
        </div>
        <div>
          <h4 id="soul-detail-name" class="text-xl font-black tracking-widest text-white uppercase">DETERMINATION</h4>
          <span id="soul-detail-label" class="text-xs font-mono text-gray-400 uppercase">RED SOUL</span>
        </div>
      </div>
      <blockquote id="soul-detail-tag" class="italic text-xs text-gray-300 border-l-2 pl-3 py-1 mb-4 border-gray-700 font-serif"></blockquote>
      <p id="soul-detail-desc" class="text-xs text-gray-300 leading-relaxed font-sans"></p>
    </div>
  </div>
</div>

<script is:inline>
  function initQuiz() {
    const root = document.getElementById("quiz-root");
    if (!root) return;
    if (root.dataset.initialized === "true") return;
    root.dataset.initialized = "true";

    const LANG = root.getAttribute("data-lang") || "en";
    const QUESTIONS = JSON.parse(root.getAttribute("data-questions") || "[]");
    const SOULS = JSON.parse(root.getAttribute("data-souls") || "{}");
    const SOUL_CODES = JSON.parse(root.getAttribute("data-soul-codes") || "[]");
    const MAXP = JSON.parse(root.getAttribute("data-maxp") || "{}");
    const QUIZ_UI = JSON.parse(root.getAttribute("data-quiz-ui") || "{}");
    const COMPARISON_PAIRS = JSON.parse(root.getAttribute("data-comparison-pairs") || "{}");

    const STORAGE_KEY = "soulvirtues_answers_" + LANG;
    const SETTINGS_KEY = "soulvirtues_audio_settings";

    // -------------------------------------------------------------
    // Audio Engine & Settings
    // -------------------------------------------------------------
    let audioSettings = {
      volMusic: 30,
      volSfx: 40,
      musicMuted: false,
      sfxMuted: false,
    };

    try {
      const savedSettings = localStorage.getItem(SETTINGS_KEY);
      if (savedSettings) {
        audioSettings = { ...audioSettings, ...JSON.parse(savedSettings) };
      }
    } catch (e) {}

    const audioBgm = document.getElementById("audio-bgm");
    const audioMove = document.getElementById("audio-move");
    const audioSelect = document.getElementById("audio-select");
    const audioAppear = document.getElementById("audio-appear");

    const TYPE_POOL_SIZE = 6;
    const typeAudioPool = [];
    for (let i = 0; i < TYPE_POOL_SIZE; i++) {
      const a = new Audio("/audio/snd_text.wav");
      a.preload = "auto";
      typeAudioPool.push(a);
    }
    let typePoolIndex = 0;

    const MOVE_POOL_SIZE = 4;
    const moveAudioPool = [];
    for (let i = 0; i < MOVE_POOL_SIZE; i++) {
      const a = new Audio("/audio/snd_menumove.wav");
      a.preload = "auto";
      moveAudioPool.push(a);
    }
    let movePoolIndex = 0;

    function saveAudioSettings() {
      try {
        localStorage.setItem(SETTINGS_KEY, JSON.stringify(audioSettings));
      } catch (e) {}
      updateAudioVolumes();
    }

    function updateAudioVolumes() {
      if (audioBgm) {
        if (audioSettings.musicMuted || audioSettings.volMusic === 0) {
          audioBgm.volume = 0;
        } else {
          audioBgm.volume = audioSettings.volMusic / 100;
        }
      }

      const labelMusic = document.getElementById("label-vol-music");
      const labelSfx = document.getElementById("label-vol-sfx");
      const sliderMusic = document.getElementById("slider-vol-music");
      const sliderSfx = document.getElementById("slider-vol-sfx");
      const btnMusicMute = document.getElementById("btn-toggle-music-mute");
      const btnSfxMute = document.getElementById("btn-toggle-sfx-mute");
      const soundIndicator = document.getElementById("sound-indicator-icon");

      if (labelMusic) labelMusic.textContent = audioSettings.musicMuted ? "MUTED" : `${audioSettings.volMusic}%`;
      if (labelSfx) labelSfx.textContent = audioSettings.sfxMuted ? "MUTED" : `${audioSettings.volSfx}%`;
      if (sliderMusic) sliderMusic.value = audioSettings.volMusic;
      if (sliderSfx) sliderSfx.value = audioSettings.volSfx;
      if (btnMusicMute) btnMusicMute.textContent = audioSettings.musicMuted ? "UNMUTE" : QUIZ_UI.muteBtn;
      if (btnSfxMute) btnSfxMute.textContent = audioSettings.sfxMuted ? "UNMUTE" : QUIZ_UI.muteBtn;
      if (soundIndicator) soundIndicator.textContent = (audioSettings.musicMuted && audioSettings.sfxMuted) ? "🔇" : "🔊";
    }

    function playSound(type) {
      if (audioSettings.sfxMuted || audioSettings.volSfx === 0) return;
      const sfxVol = audioSettings.volSfx / 100;

      try {
        if (type === "text") {
          const audio = typeAudioPool[typePoolIndex];
          typePoolIndex = (typePoolIndex + 1) % TYPE_POOL_SIZE;
          audio.volume = Math.min(1, sfxVol * 0.7);
          audio.currentTime = 0;
          audio.play().catch(() => {});
        } else if (type === "move") {
          const audio = moveAudioPool[movePoolIndex];
          movePoolIndex = (movePoolIndex + 1) % MOVE_POOL_SIZE;
          audio.volume = sfxVol;
          audio.currentTime = 0;
          audio.play().catch(() => {});
        } else if (type === "select" && audioSelect) {
          audioSelect.volume = sfxVol;
          audioSelect.currentTime = 0;
          audioSelect.play().catch(() => {});
        } else if (type === "appear" && audioAppear) {
          audioAppear.volume = sfxVol;
          audioAppear.currentTime = 0;
          audioAppear.play().catch(() => {});
        }
      } catch (e) {}
    }

    let bgmStarted = false;
    function startBgm() {
      if (bgmStarted && audioBgm && !audioBgm.paused) return;
      if (audioBgm) {
        updateAudioVolumes();
        audioBgm.play().then(() => {
          bgmStarted = true;
        }).catch(() => {});
      }
    }

    // -------------------------------------------------------------
    // Typewriter System
    // -------------------------------------------------------------
    function setTypedContent(el, fullText, count) {
      let onSpan = el.querySelector(".typewriter-on");
      let offSpan = el.querySelector(".typewriter-off");
      if (!onSpan || !offSpan) {
        el.innerHTML = '<span class="typewriter-on"></span><span class="typewriter-off" style="visibility:hidden"></span>';
        onSpan = el.querySelector(".typewriter-on");
        offSpan = el.querySelector(".typewriter-off");
      }
      onSpan.textContent = fullText.slice(0, count);
      offSpan.textContent = fullText.slice(count);
    }

    let typeInterval = null;
    let isTyping = false;
    let currentFullText = "";

    function typeOut(el, text, speed = 25, onComplete) {
      if (typeInterval) clearInterval(typeInterval);
      currentFullText = text;
      isTyping = true;
      let i = 0;
      setTypedContent(el, text, 0);

      typeInterval = setInterval(() => {
        if (i < text.length) {
          i++;
          setTypedContent(el, text, i);
          const char = text[i - 1];
          if (char !== " " && char !== "\n") {
            playSound("text");
          }
        } else {
          clearInterval(typeInterval);
          typeInterval = null;
          isTyping = false;
          if (onComplete) onComplete();
        }
      }, speed);
    }

    function skipTyping() {
      if (isTyping && typeInterval) {
        clearInterval(typeInterval);
        typeInterval = null;
        isTyping = false;
        const target = document.getElementById("questions-type");
        if (target) {
          setTypedContent(target, currentFullText, currentFullText.length);
        }
      }
    }

    // -------------------------------------------------------------
    // Void Intro Sequence
    // -------------------------------------------------------------
    let introStep = 0;
    const introScenes = QUIZ_UI.introScenes || [
      "ARE WE CONNECTED?",
      "VERY INTERESTING. A SOUL IN THE VOID...",
      "LET US EXTRACT YOUR TRUE VIRTUE.",
    ];

    function runIntroScene(step) {
      const typeEl = document.getElementById("intro-type");
      if (!typeEl) return;
      if (step >= introScenes.length) {
        showScreen("start");
        return;
      }
      typeOut(typeEl, introScenes[step], 50);
    }

    function advanceIntro() {
      if (isTyping) {
        if (typeInterval) clearInterval(typeInterval);
        typeInterval = null;
        isTyping = false;
        const typeEl = document.getElementById("intro-type");
        if (typeEl) setTypedContent(typeEl, currentFullText, currentFullText.length);
      } else {
        introStep++;
        runIntroScene(introStep);
      }
    }

    // -------------------------------------------------------------
    // Quiz State & Progression
    // -------------------------------------------------------------
    let currentIndex = 0;
    let userAnswers = new Array(QUESTIONS.length).fill(null);
    let currentSelection = 2; // Default Neutral

    try {
      const savedAnswers = localStorage.getItem(STORAGE_KEY);
      if (savedAnswers) {
        const parsed = JSON.parse(savedAnswers);
        if (Array.isArray(parsed) && parsed.length === QUESTIONS.length) {
          userAnswers = parsed;
        }
      }
    } catch (e) {}

    function showScreen(screen) {
      ["intro", "start", "active", "result", "review", "souls"].forEach(s => {
        const el = document.getElementById("quiz-" + s);
        if (el) {
          if (s === screen) {
            el.classList.remove("hidden");
          } else {
            el.classList.add("hidden");
          }
        }
      });
      window.scrollTo({ top: document.getElementById("quiz-root").offsetTop - 80, behavior: "smooth" });
    }

    // Initial Screen Decision
    const answeredCount = userAnswers.filter(a => a !== null).length;
    if (answeredCount === QUESTIONS.length) {
      showScreen("result");
      showResults();
    } else {
      showScreen("intro");
      runIntroScene(0);
      if (answeredCount > 0) {
        const resumeBtn = document.getElementById("btn-resume-quiz");
        const resumeCount = document.getElementById("resume-count");
        if (resumeBtn && resumeCount) {
          resumeBtn.classList.remove("hidden");
          resumeCount.textContent = answeredCount;
        }
      }
    }

    function renderQuestion(index) {
      currentIndex = index;
      const q = QUESTIONS[index];
      if (!q) return;

      currentSelection = userAnswers[index] !== null ? userAnswers[index] : 2;

      // Update HUD
      const hudIndex = document.getElementById("hud-index");
      const progressFill = document.getElementById("progress-fill");
      if (hudIndex) hudIndex.textContent = `${String(index + 1).padStart(2, "0")} / ${QUESTIONS.length}`;
      if (progressFill) progressFill.style.width = `${((index) / QUESTIONS.length) * 100}%`;

      const prevBtn = document.getElementById("btn-prev");
      if (prevBtn) prevBtn.disabled = index === 0;

      // Extremes labels
      const extremeLeft = document.getElementById("label-extreme-left");
      const extremeRight = document.getElementById("label-extreme-right");
      if (extremeLeft && q.labels) extremeLeft.textContent = q.labels[0];
      if (extremeRight && q.labels) extremeRight.textContent = q.labels[q.labels.length - 1];

      buildScalePoints(q);

      const target = document.getElementById("questions-type");
      if (target) {
        typeOut(target, q.q, 20);
      }
    }

    function buildScalePoints(q) {
      const scaleRow = document.getElementById("scale-row");
      if (!scaleRow) return;
      scaleRow.innerHTML = "";

      q.labels.forEach((label, optIdx) => {
        const btn = document.createElement("button");
        btn.type = "button";
        const isSelected = currentSelection === optIdx;
        btn.className = `flex-1 min-w-0 min-h-16 flex flex-col items-center justify-center gap-1 py-2 border-2 cursor-pointer group outline-none transition-colors active:scale-95 focus-visible:border-white ${
          isSelected
            ? "border-red-500 bg-red-950/30"
            : "border-gray-700 bg-black hover:border-white"
        }`;
        btn.setAttribute("aria-label", label);
        btn.setAttribute("aria-describedby", "tap-answer-hint");

        btn.innerHTML = `
          <span class="text-[10px] font-bold text-gray-400" aria-hidden="true">${optIdx + 1}</span>
          <div class="w-10 h-10 sm:w-12 sm:h-12 flex items-center justify-center">
            ${isSelected
              ? '<div class="w-8 h-8 sm:w-9 sm:h-9 text-red-600 drop-shadow-[0_0_12px_rgba(255,0,0,0.9)] animate-pulse transition-transform scale-110"><svg viewBox="0 0 16 16" fill="currentColor" class="w-full h-full" shape-rendering="crispEdges"><path d="M2 0h4v1H2zm8 0h4v1h-4zM1 1h6v1H1zm8 0h6v1H9zM0 2h7v1H0zm9 2h7v1H9zM0 3h7v1H0zm9 3h7v1H9zM0 4h16v6H0zm2 6h12v2H2zm2 2h8v2H4zm2 2h4v2H6z"/></svg></div>'
              : '<div class="w-5 h-5 sm:w-6 sm:h-6 bg-black border-3 sm:border-4 border-gray-600 group-hover:border-white transition-colors"></div>'
            }
          </div>
        `;

        btn.addEventListener("click", () => {
          selectAndAdvance(optIdx);
        });

        scaleRow.appendChild(btn);
      });

      updateSelectedLabel(q);
    }

    function selectAndAdvance(optIdx) {
      if (optIdx < 0 || optIdx > 4) return;
      currentSelection = optIdx;
      confirmAndAdvance();
    }

    function setSelection(optIdx) {
      if (optIdx < 0 || optIdx > 4) return;
      if (currentSelection !== optIdx) {
        playSound("move");
      }
      currentSelection = optIdx;
      const q = QUESTIONS[currentIndex];
      buildScalePoints(q);
    }

    function updateSelectedLabel(q) {
      const labelEl = document.getElementById("selected-label-text");
      if (labelEl && q.labels && q.labels[currentSelection]) {
        labelEl.textContent = q.labels[currentSelection];
      }
    }

    function confirmAndAdvance() {
      playSound("select");
      userAnswers[currentIndex] = currentSelection;
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(userAnswers));
      } catch (e) {}

      if (currentIndex < QUESTIONS.length - 1) {
        renderQuestion(currentIndex + 1);
      } else {
        showResults();
      }
    }

    function goBack() {
      if (currentIndex > 0) {
        playSound("move");
        renderQuestion(currentIndex - 1);
      }
    }

    // -------------------------------------------------------------
    // Mathematical Scoring Engine
    // -------------------------------------------------------------
    function computeScores() {
      const scores = { DET: 0, BRV: 0, JUS: 0, KND: 0, PAT: 0, INT: 0, PER: 0 };
      const CHOICE_FACTORS = [-1.0, -0.5, 0.0, 0.5, 1.0];

      userAnswers.forEach((ans, qIdx) => {
        if (ans === null || ans === undefined) return;
        const factor = CHOICE_FACTORS[ans];
        const q = QUESTIONS[qIdx];
        if (!q || !q.load) return;

        Object.entries(q.load).forEach(([trait, weight]) => {
          if (scores[trait] !== undefined) {
            scores[trait] += factor * weight;
          }
        });
      });

      const pct = {};
      SOUL_CODES.forEach(code => {
        const raw = scores[code];
        const max = MAXP[code] || 1;
        const normalized = Math.max(-1, Math.min(1, raw / max));
        const sign = normalized >= 0 ? 1 : -1;
        const curved = sign * Math.pow(Math.abs(normalized), 0.6);
        const finalPct = 50 + curved * 50;
        pct[code] = Math.max(0, Math.min(100, finalPct));
      });

      const ranked = [...SOUL_CODES].sort((a, b) => pct[b] - pct[a]);
      return { pct, ranked };
    }

    // -------------------------------------------------------------
    // Results Rendering & Exports
    // -------------------------------------------------------------
    function showResults() {
      playSound("appear");
      const { pct, ranked } = computeScores();
      const dominantCode = ranked[0];
      const dominantSoul = SOULS[dominantCode];

      const heartEl = document.getElementById("result-heart");
      const badgeEl = document.getElementById("result-badge");
      const nameEl = document.getElementById("result-trait-name");
      const colorLabelEl = document.getElementById("result-color-label");
      const taglineEl = document.getElementById("result-tagline");
      const descEl = document.getElementById("result-description");

      if (heartEl) {
        heartEl.style.color = dominantSoul.hex;
        heartEl.style.setProperty("--res-color", dominantSoul.hex);
      }
      if (badgeEl) {
        badgeEl.style.color = dominantSoul.hex;
        badgeEl.style.borderColor = dominantSoul.hex;
      }
      if (nameEl) nameEl.textContent = dominantSoul.name;
      if (colorLabelEl) colorLabelEl.textContent = `${dominantSoul.label} · ${dominantSoul.hex.toUpperCase()}`;
      if (taglineEl) taglineEl.textContent = `"${dominantSoul.tag}"`;
      if (descEl) descEl.textContent = dominantSoul.description;

      // Secondary Virtue / Shadow Trait
      const secondaryCode = ranked[1];
      const secondarySoul = SOULS[secondaryCode];
      const secHeart = document.getElementById("secondary-heart");
      const secName = document.getElementById("secondary-name");
      const secPct = document.getElementById("secondary-pct");
      const secDesc = document.getElementById("secondary-desc");

      if (secHeart) secHeart.style.color = secondarySoul.hex;
      if (secName) secName.textContent = secondarySoul.name;
      if (secPct) secPct.textContent = `${pct[secondaryCode].toFixed(1)}%`;
      if (secDesc) secDesc.textContent = secondarySoul.description;

      const compareBtn = document.getElementById("btn-compare-top-souls");
      const comparison = COMPARISON_PAIRS[[dominantCode, secondaryCode].sort().join("-")];
      if (compareBtn) {
        compareBtn.classList.toggle("hidden", !comparison);
        compareBtn.classList.toggle("inline-flex", Boolean(comparison));
        if (comparison) {
          compareBtn.href = comparison.path;
          compareBtn.textContent = comparison.label;
        }
      }

      // Direct Internal Link to Dominant Soul Subpage
      const exploreBtn = document.getElementById("btn-explore-dominant-soul");
      const exploreText = document.getElementById("btn-explore-dominant-text");
      if (exploreBtn && exploreText) {
        const soulSlugMap = {
          DET: 'determination',
          BRV: 'bravery',
          JUS: 'justice',
          KND: 'kindness',
          PAT: 'patience',
          INT: 'integrity',
          PER: 'perseverance'
        };
        const slug = soulSlugMap[dominantCode] || 'determination';
        const langPrefix = LANG === 'en' ? '' : `/${LANG}`;
        exploreBtn.href = `${langPrefix}/souls/${slug}/`;
        exploreBtn.style.borderColor = dominantSoul.hex;
        exploreBtn.style.color = dominantSoul.hex;
        exploreText.textContent = `Explore ${dominantSoul.name} Lore, Items & Combat Secrets →`;
      }

      // 7 Trait Bars
      const barsContainer = document.getElementById("virtue-bars");
      if (barsContainer) {
        barsContainer.innerHTML = "";
        ranked.forEach(code => {
          const s = SOULS[code];
          const val = pct[code].toFixed(1);
          const row = document.createElement("div");
          row.className = "space-y-1";
          row.innerHTML = `
            <div class="flex justify-between items-center text-xs font-mono">
              <span class="font-bold tracking-wider" style="color: ${s.hex}">${s.name} (${s.label})</span>
              <span class="text-white font-bold">${val}%</span>
            </div>
            <div class="h-4 border-2 border-gray-700 bg-black p-0.5">
              <div class="h-full transition-all duration-500" style="width: ${val}%; background: ${s.hex}"></div>
            </div>
          `;
          barsContainer.appendChild(row);
        });
      }

      showScreen("result");
    }

    // Share Card Canvas Generator
    function drawResultCard() {
      playSound("select");
      const { pct, ranked } = computeScores();
      const dominant = SOULS[ranked[0]];

      const canvas = document.createElement("canvas");
      canvas.width = 1200;
      canvas.height = 630;
      const ctx = canvas.getContext("2d");

      // Black Void Background
      ctx.fillStyle = "#050505";
      ctx.fillRect(0, 0, 1200, 630);

      // Pixel border frame
      ctx.strokeStyle = "#ffffff";
      ctx.lineWidth = 8;
      ctx.strokeRect(16, 16, 1168, 598);

      ctx.strokeStyle = dominant.hex;
      ctx.lineWidth = 2;
      ctx.strokeRect(28, 28, 1144, 574);

      // Header Brand
      ctx.fillStyle = "#ffffff";
      ctx.font = "bold 24px monospace";
      ctx.fillText("SOUL VIRTUES EXTRACTOR", 60, 75);

      ctx.fillStyle = "#888888";
      ctx.font = "16px monospace";
      ctx.fillText("soulvirtues.org · 66-Question Test", 60, 105);

      // Dominant Trait Callout
      ctx.fillStyle = dominant.hex;
      ctx.font = "bold 64px monospace";
      ctx.fillText(dominant.name, 60, 200);

      ctx.fillStyle = "#aaaaaa";
      ctx.font = "bold 20px monospace";
      ctx.fillText(`${dominant.label} SOUL · ${dominant.hex.toUpperCase()}`, 60, 240);

      // Tagline
      ctx.fillStyle = "#e0e0e0";
      ctx.font = "italic 22px serif";
      ctx.fillText(`"${dominant.tag}"`, 60, 300);

      // 7 Virtues Bars on the Right Column
      ctx.fillStyle = "#ffffff";
      ctx.font = "bold 18px monospace";
      ctx.fillText(QUIZ_UI.breakdownTitle, 680, 80);

      const startY = 120;
      ranked.forEach((code, idx) => {
        const s = SOULS[code];
        const val = pct[code];
        const y = startY + idx * 60;

        ctx.fillStyle = s.hex;
        ctx.font = "bold 16px monospace";
        ctx.fillText(s.name, 680, y);

        ctx.fillStyle = "#ffffff";
        ctx.font = "bold 16px monospace";
        ctx.fillText(`${val.toFixed(1)}%`, 1080, y);

        // Track
        ctx.fillStyle = "#1a1a1a";
        ctx.fillRect(680, y + 10, 440, 16);
        ctx.strokeStyle = "#333333";
        ctx.lineWidth = 1;
        ctx.strokeRect(680, y + 10, 440, 16);

        // Fill
        ctx.fillStyle = s.hex;
        ctx.fillRect(682, y + 12, (436 * val) / 100, 12);
      });

      // Footer disclaimer
      ctx.fillStyle = "#666666";
      ctx.font = "14px monospace";
      ctx.fillText("Undertale-inspired Fan Analytical Assessment · 100% Client-Side", 60, 560);

      const link = document.createElement("a");
      link.download = `soul-virtues-${dominant.name.toLowerCase()}-${LANG}.png`;
      link.href = canvas.toDataURL("image/png");
      link.click();
    }

    function copySummaryText() {
      const { pct, ranked } = computeScores();
      const dominant = SOULS[ranked[0]];
      const text = [
        "✨ My Undertale Soul Virtues Result:",
        `Dominant Soul: ${dominant.name} (${dominant.label} SOUL)`,
        `Tagline: "${dominant.tag}"`,
        "",
        `📊 ${QUIZ_UI.breakdownTitle}:`,
        ranked.map(t => `${SOULS[t].name}: ${pct[t].toFixed(1)}%`).join("\n"),
        "",
        `Take the free 66-question test at: https://soulvirtues.org${LANG === 'ja' ? '/ja/' : '/'}`
      ].join("\n");

      navigator.clipboard.writeText(text).then(() => {
        const btn = document.getElementById("btn-copy-result");
        if (btn) {
          const orig = btn.innerHTML;
          btn.innerHTML = `✓ ${QUIZ_UI.copiedNotice}`;
          setTimeout(() => { btn.innerHTML = orig; }, 2000);
        }
      });
    }

    // Answers Review List
    function buildReviewList() {
      const list = document.getElementById("review-list");
      if (!list) return;
      list.innerHTML = "";
      QUESTIONS.forEach((q, i) => {
        const ans = userAnswers[i];
        const label = (ans !== null && ans !== undefined && q.labels && q.labels[ans]) ? q.labels[ans] : "Unanswered";
        const item = document.createElement("div");
        item.innerHTML = `
          <div class="text-sm sm:text-base text-white leading-relaxed tracking-wide">
            <span class="text-gray-500 mr-2">${String(i + 1).padStart(2, "0")}.</span>${q.q}
          </div>
          <div class="text-yellow-400 text-xs sm:text-sm tracking-widest uppercase mt-1 pl-7">&gt; ${label}</div>
        `;
        list.appendChild(item);
      });
    }

    // Souls Gallery
    function buildSoulsGallery() {
      const grid = document.getElementById("souls-grid");
      if (!grid) return;
      grid.innerHTML = "";
      SOUL_CODES.forEach(code => {
        const soul = SOULS[code];
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "flex items-center gap-2 px-3 py-2 bg-black border-2 border-gray-600 hover:border-white text-xs sm:text-sm font-bold tracking-widest uppercase cursor-pointer active:scale-95 transition-all";
        btn.style.color = soul.hex;
        btn.innerHTML = `
          <span class="w-4 h-4 inline-block"><svg viewBox="0 0 16 16" fill="currentColor" class="w-full h-full" shape-rendering="crispEdges"><path d="M2 0h4v1H2zm8 0h4v1h-4zM1 1h6v1H1zm8 0h6v1H9zM0 2h7v1H0zm9 2h7v1H9zM0 3h7v1H0zm9 3h7v1H9zM0 4h16v6H0zm2 6h12v2H2zm2 2h8v2H4zm2 2h4v2H6z"/></svg></span>
          <span>${soul.name}</span>
        `;
        btn.addEventListener("click", () => {
          playSound("select");
          const detail = document.getElementById("soul-detail");
          const heartEl = document.getElementById("soul-detail-heart");
          const nameEl = document.getElementById("soul-detail-name");
          const labelEl = document.getElementById("soul-detail-label");
          const tagEl = document.getElementById("soul-detail-tag");
          const descEl = document.getElementById("soul-detail-desc");

          if (heartEl) heartEl.style.color = soul.hex;
          if (nameEl) {
            nameEl.textContent = soul.name;
            nameEl.style.color = soul.hex;
          }
          if (labelEl) labelEl.textContent = `${soul.label} SOUL · ${soul.hex.toUpperCase()}`;
          if (tagEl) tagEl.textContent = `"${soul.tag}"`;
          if (descEl) descEl.textContent = soul.description;
          if (detail) detail.classList.remove("hidden");
        });
        grid.appendChild(btn);
      });
    }

    // -------------------------------------------------------------
    // Event Listeners
    // -------------------------------------------------------------
    const btnOpenSettings = document.getElementById("btn-open-settings");
    const btnCloseSettings = document.getElementById("btn-close-settings");
    const settingsModal = document.getElementById("settings-modal");

    btnOpenSettings?.addEventListener("click", (e) => {
      e.stopPropagation();
      playSound("select");
      settingsModal?.classList.toggle("hidden");
    });

    btnCloseSettings?.addEventListener("click", () => {
      playSound("move");
      settingsModal?.classList.add("hidden");
    });

    document.addEventListener("click", (e) => {
      if (settingsModal && !settingsModal.contains(e.target) && e.target !== btnOpenSettings) {
        settingsModal.classList.add("hidden");
      }
    });

    document.getElementById("slider-vol-music")?.addEventListener("input", (e) => {
      audioSettings.volMusic = parseInt(e.target.value, 10);
      audioSettings.musicMuted = false;
      saveAudioSettings();
      startBgm();
    });

    document.getElementById("slider-vol-sfx")?.addEventListener("input", (e) => {
      audioSettings.volSfx = parseInt(e.target.value, 10);
      audioSettings.sfxMuted = false;
      saveAudioSettings();
      playSound("move");
    });

    document.getElementById("btn-toggle-music-mute")?.addEventListener("click", () => {
      audioSettings.musicMuted = !audioSettings.musicMuted;
      saveAudioSettings();
      if (!audioSettings.musicMuted) startBgm();
    });

    document.getElementById("btn-toggle-sfx-mute")?.addEventListener("click", () => {
      audioSettings.sfxMuted = !audioSettings.sfxMuted;
      saveAudioSettings();
      if (!audioSettings.sfxMuted) playSound("select");
    });

    document.getElementById("btn-start-fresh")?.addEventListener("click", () => {
      userAnswers = new Array(QUESTIONS.length).fill(null);
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(userAnswers)); } catch (e) {}
      startBgm();
      playSound("select");
      showScreen("active");
      renderQuestion(0);
    });

    document.getElementById("quiz-intro")?.addEventListener("click", advanceIntro);
    document.getElementById("btn-skip-intro")?.addEventListener("click", (e) => {
      e.stopPropagation();
      playSound("select");
      showScreen("start");
    });

    document.getElementById("btn-review-answers")?.addEventListener("click", () => {
      playSound("select");
      buildReviewList();
      showScreen("review");
    });
    document.getElementById("btn-review-back")?.addEventListener("click", () => {
      playSound("move");
      showScreen("result");
    });
    document.getElementById("btn-browse-souls")?.addEventListener("click", () => {
      playSound("select");
      buildSoulsGallery();
      document.getElementById("soul-detail")?.classList.add("hidden");
      showScreen("souls");
    });
    document.getElementById("btn-souls-back")?.addEventListener("click", () => {
      playSound("move");
      showScreen("result");
    });

    document.getElementById("btn-resume-quiz")?.addEventListener("click", () => {
      startBgm();
      playSound("select");
      const firstUnanswered = userAnswers.findIndex(a => a === null);
      showScreen("active");
      renderQuestion(firstUnanswered !== -1 ? firstUnanswered : 0);
    });

    document.getElementById("dialogue-box")?.addEventListener("click", skipTyping);

    document.getElementById("btn-quiz-reset")?.addEventListener("click", () => {
      if (confirm(QUIZ_UI.resetConfirm || "Reset all 66 questions?")) {
        userAnswers = new Array(QUESTIONS.length).fill(null);
        try { localStorage.setItem(STORAGE_KEY, JSON.stringify(userAnswers)); } catch (e) {}
        showScreen("start");
      }
    });

    document.getElementById("btn-prev")?.addEventListener("click", goBack);
    document.getElementById("btn-next")?.addEventListener("click", confirmAndAdvance);

    document.getElementById("btn-download-card")?.addEventListener("click", drawResultCard);
    document.getElementById("btn-copy-result")?.addEventListener("click", copySummaryText);
    document.getElementById("btn-retake")?.addEventListener("click", () => {
      showScreen("start");
    });

    // Keyboard navigation
    window.addEventListener("keydown", (e) => {
      const introScreen = document.getElementById("quiz-intro");
      if (introScreen && !introScreen.classList.contains("hidden")) {
        if (e.key === "Enter" || e.key.toLowerCase() === "z" || e.key === " ") {
          e.preventDefault();
          advanceIntro();
        }
        return;
      }

      const activeScreen = document.getElementById("quiz-active");
      if (!activeScreen || activeScreen.classList.contains("hidden")) return;

      if (e.key === "ArrowLeft" || e.key.toLowerCase() === "a") {
        e.preventDefault();
        setSelection(Math.max(0, currentSelection - 1));
      } else if (e.key === "ArrowRight" || e.key.toLowerCase() === "d") {
        e.preventDefault();
        setSelection(Math.min(4, currentSelection + 1));
      } else if (e.key >= "1" && e.key <= "5") {
        e.preventDefault();
        selectAndAdvance(parseInt(e.key) - 1);
      } else if (e.key === "Enter" || e.key.toLowerCase() === "z" || e.key === " ") {
        e.preventDefault();
        if (isTyping) {
          skipTyping();
        } else {
          confirmAndAdvance();
        }
      } else if (e.key === "Backspace" || e.key.toLowerCase() === "x") {
        e.preventDefault();
        goBack();
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initQuiz);
  } else {
    initQuiz();
  }
  document.addEventListener("astro:page-load", initQuiz);
</script>
