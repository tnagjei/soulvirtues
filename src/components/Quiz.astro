---
// input: lang ('en' | 'ja' | 'es' | 'pt' | 'ru'), static scoring data, localized dictionaries, and six approved comparison pairs
// output: Five-language V2 quiz with versioned shared progress, mean scoring, neutral/tied readings, matching versioned cards, touch-accessible start actions, and private answer evidence
// pos: src/components/Quiz.astro (更新规则：文件变更需同步本注释与所属目录 README)

import { ASSESSMENT_COPY } from '../data/assessmentContent';

import { getTranslations, type Locale } from '../i18n';
import { SOUL_CODES } from '../data/souls';
import { SOUL_DETAILS } from '../data/soulDetails';
import { SOUL_COMPARISONS } from '../data/soulComparisons';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = getTranslations(lang);

const questionsJson = JSON.stringify(t.questions);
const soulsJson = JSON.stringify(t.souls);
const soulCodesJson = JSON.stringify(SOUL_CODES);
const quizUIJson = JSON.stringify(t.quizUI);
const comparisonPairsJson = JSON.stringify(Object.fromEntries(
  SOUL_COMPARISONS.map((comparison) => {
    const key = [SOUL_DETAILS[comparison.leftSlug].code, SOUL_DETAILS[comparison.rightSlug].code].sort().join('-');
    const prefix = lang === 'en' ? '' : `/${lang}`;
    return [key, {
      path: `${prefix}/compare/${comparison.slug}/`,
      label: `${comparison.copy[lang].heading} →`,
    }];
  }),
));
---

<div
  id="quiz-root"
  class="w-full max-w-4xl mx-auto my-6 font-mono text-white select-none relative"
  data-lang={lang}
  data-questions={questionsJson}
  data-souls={soulsJson}
  data-soul-codes={soulCodesJson}
  data-clarity-mask="true"
  data-quiz-ui={quizUIJson}
  data-comparison-pairs={comparisonPairsJson}
>
  <div class="border border-gray-800 bg-black px-4 py-1 mb-4 text-xs text-gray-400 leading-relaxed">
    <a href={lang === 'en' ? '/method/' : '/' + lang + '/method/'} class="flex min-h-11 items-center text-cyan-300 underline">{ASSESSMENT_COPY[lang].methodLink}</a>
    <p id="quiz-bank-update" class="hidden mt-2 text-amber-300" role="status">{ASSESSMENT_COPY[lang].versionNotice}</p>
    <p id="quiz-storage-error" class="hidden mt-2 text-amber-300" role="status">{ASSESSMENT_COPY[lang].storageError}</p>
  </div>

  <!-- Background Audio Elements -->
  <audio id="audio-bgm" loop preload="auto" src="/audio/bgm_ambient.m4a"></audio>
  <audio id="audio-move" preload="auto" src="/audio/sfx_move.wav"></audio>
  <audio id="audio-select" preload="auto" src="/audio/sfx_select.wav"></audio>
  <audio id="audio-appear" preload="auto" src="/audio/sfx_appear.wav"></audio>

  <!-- Top Bar: Title & Pixel Settings Button -->
  <div class="flex items-center justify-between mb-4 px-2 text-xs text-gray-300">
    <div class="flex items-center gap-2">
      <span class="inline-block w-2.5 h-2.5 rounded-full bg-red-500 animate-pulse"></span>
      <span class="tracking-widest uppercase text-xs font-bold font-sans">{t.quizUI.title}</span>
    </div>

    <!-- SETTINGS Button -->
    <div class="relative">
      <button
        id="btn-open-settings"
        type="button"
        class="px-3 py-1.5 bg-black border-2 sm:border-3 border-white hover:bg-white hover:text-black text-white rounded-none text-xs sm:text-sm font-mono tracking-widest uppercase transition-all cursor-pointer flex items-center gap-2 active:scale-95 shadow-[2px_2px_0px_#ffffff]"
        title="Audio and Sound Settings"
      >
        <span id="sound-indicator-icon">🔊</span>
        <span>{t.quizUI.settingsBtn}</span>
      </button>

      <!-- Settings Dropdown / Modal -->
      <div
        id="settings-modal"
        class="hidden absolute right-0 top-full mt-2 w-72 sm:w-80 bg-black border-4 border-white p-4 shadow-[4px_4px_0px_rgba(255,255,255,0.4)] z-50 text-white font-mono"
      >
        <div class="flex items-center justify-between border-b-2 border-gray-700 pb-2 mb-4">
          <span class="font-bold text-sm tracking-widest text-yellow-400 uppercase">{t.quizUI.audioSettingsTitle}</span>
          <button id="btn-close-settings" class="text-xs text-gray-400 hover:text-white border border-gray-600 px-1.5 py-0.5 cursor-pointer">
            ✕
          </button>
        </div>

        <!-- BGM Volume Slider -->
        <div class="mb-4">
          <div class="flex justify-between items-center text-xs mb-1.5">
            <span class="text-gray-300 tracking-wider">{t.quizUI.musicBgmLabel}</span>
            <span id="label-vol-music" class="text-red-400 font-bold">30%</span>
          </div>
          <div class="flex items-center gap-3">
            <input
              id="slider-vol-music"
              type="range"
              min="0"
              max="100"
              value="30"
              class="pixel-slider flex-1"
            />
            <button
              id="btn-toggle-music-mute"
              class="px-2 py-1 text-[11px] bg-black border border-gray-500 hover:border-white text-gray-300 cursor-pointer"
            >
              {t.quizUI.muteBtn}
            </button>
          </div>
        </div>

       <!-- SFX Volume Slider -->
       <div class="mb-4">
         <div class="flex justify-between items-center text-xs mb-1.5">
           <span class="text-gray-300 tracking-wider">{t.quizUI.soundSfxLabel}</span>
           <span id="label-vol-sfx" class="text-yellow-400 font-bold">40%</span>
         </div>
         <div class="flex items-center gap-3">
           <input
             id="slider-vol-sfx"
             type="range"
             min="0"
             max="100"
             value="40"
             class="pixel-slider flex-1"
           />
           <button
             id="btn-toggle-sfx-mute"
             class="px-2 py-1 text-[11px] bg-black border border-gray-500 hover:border-white text-gray-300 cursor-pointer"
           >
             {t.quizUI.muteBtn}
           </button>
         </div>
       </div>

        <!-- Language Switcher in Settings Modal -->
        <div class="mb-4 pt-3 border-t border-gray-800">
          <div class="flex justify-between items-center text-xs mb-2">
            <span class="text-gray-300 tracking-wider">🌐 IDIOMA / LANGUAGE:</span>
          </div>
          <div class="grid grid-cols-2 gap-1.5 text-xs font-mono">
            <a
              href="/#test"
              class={`px-2 py-1.5 text-center border transition-colors ${lang === 'en' ? 'border-yellow-400 text-yellow-400 bg-gray-900 font-bold' : 'border-gray-700 text-gray-400 hover:border-white hover:text-white'}`}
            >
              * English
            </a>
            <a
              href="/es/#test"
              class={`px-2 py-1.5 text-center border transition-colors ${lang === 'es' ? 'border-yellow-400 text-yellow-400 bg-gray-900 font-bold' : 'border-gray-700 text-gray-400 hover:border-white hover:text-white'}`}
            >
              * Español
            </a>
            <a
              href="/ja/#test"
              class={`px-2 py-1.5 text-center border transition-colors ${lang === 'ja' ? 'border-yellow-400 text-yellow-400 bg-gray-900 font-bold' : 'border-gray-700 text-gray-400 hover:border-white hover:text-white'}`}
            >
              * 日本語
            </a>
            <a
              href="/pt/#test"
              class={`px-2 py-1.5 text-center border transition-colors ${lang === 'pt' ? 'border-yellow-400 text-yellow-400 bg-gray-900 font-bold' : 'border-gray-700 text-gray-400 hover:border-white hover:text-white'}`}
            >
              * Português
            </a>
          </div>
        </div>

       <div class="pt-2 border-t border-gray-800 text-[10px] text-gray-400 text-center font-sans">
         {t.quizUI.soundEngineNote}
       </div>
      </div>
    </div>
  </div>

  <!-- 0. Void Intro Sequence -->
  <div id="quiz-intro" class="hidden min-h-[300px] sm:min-h-[360px] relative cursor-pointer" title="Click or press Z to continue">
    <div class="absolute inset-0 flex items-center justify-center px-4">
      <div class="text-xl sm:text-3xl font-normal leading-relaxed text-white tracking-widest text-center max-w-2xl">
        <span id="intro-type" class="inline"></span>
      </div>
    </div>
    <div class="absolute bottom-1 right-1 sm:bottom-2 sm:right-2 flex items-center gap-3 sm:gap-4">
      <span class="text-[11px] sm:text-xs text-gray-500 tracking-wider font-sans">{t.quizUI.introContinueHint}</span>
      <button
        id="btn-skip-intro"
        type="button"
        class="px-3 py-1.5 bg-black border-2 border-gray-600 hover:border-white text-gray-300 hover:text-white text-xs tracking-widest uppercase cursor-pointer active:scale-95 transition-all"
      >
        {t.quizUI.skipBtn}
      </button>
    </div>
  </div>

  <!-- 1. Start Screen -->
  <div id="quiz-start" class="pixel-box p-6 sm:p-12 text-center relative overflow-hidden">
    <div
      id="quiz-start-heart"
      class="w-16 h-16 mx-auto mb-6 text-red-500 drop-shadow-[0_0_18px_rgba(255,0,0,0.85)] animate-pulse cursor-pointer touch-manipulation hover:scale-110 active:scale-95 transition-transform"
      title={t.quizUI.startProceedBtn}
    >
      <svg viewBox="0 0 16 16" fill="currentColor" class="w-full h-full" shape-rendering="crispEdges">
        <path d="M2 0h4v1H2zm8 0h4v1h-4zM1 1h6v1H1zm8 0h6v1H9zM0 2h7v1H0zm9 2h7v1H9zM0 3h7v1H0zm9 3h7v1H9zM0 4h16v6H0zm2 6h12v2H2zm2 2h8v2H4zm2 2h4v2H6z"/>
      </svg>
    </div>

    <h2
      id="quiz-start-title"
      class="text-2xl sm:text-4xl font-extrabold text-white tracking-widest uppercase mb-4 cursor-pointer touch-manipulation hover:text-yellow-400 transition-colors"
      title={t.quizUI.startProceedBtn}
    >
      {t.quizUI.startTitle}
    </h2>
    <p class="text-xs sm:text-sm text-gray-300 max-w-xl mx-auto mb-8 leading-relaxed font-sans">
      {t.quizUI.startDesc}
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <button
        id="btn-start-fresh"
        class="w-full sm:w-auto px-8 py-4 bg-black border-4 border-yellow-400 hover:bg-yellow-400 hover:text-black text-yellow-300 font-bold text-base uppercase tracking-widest active:scale-95 transition-all cursor-pointer shadow-[4px_4px_0px_rgba(250,204,21,0.4)] flex items-center justify-center gap-2 group"
      >
        <span class="text-red-500 inline-block transition-transform group-hover:scale-125 animate-pulse" aria-hidden="true">❤</span>
        <span>{t.quizUI.startProceedBtn}</span>
      </button>

      <button
        id="btn-resume-quiz"
        class="hidden w-full sm:w-auto px-6 py-4 bg-black border-4 border-yellow-400 text-yellow-400 hover:bg-yellow-400 hover:text-black font-bold text-sm uppercase tracking-widest active:scale-95 transition-all cursor-pointer shadow-[4px_4px_0px_rgba(250,204,21,0.4)]"
      >
        {t.quizUI.startResumeBtn} (<span id="resume-count">0</span>/66)
      </button>
    </div>

   <div class="mt-8 pt-6 border-t border-gray-800 flex flex-wrap items-center justify-center gap-6 text-xs text-gray-400 font-sans">
     {t.quizUI.startFeatures.map(feat => (
       <span>{feat}</span>
     ))}
   </div>

    <!-- Start Screen Quick Language Selector -->
    <div class="mt-4 flex flex-wrap items-center justify-center gap-2 text-xs font-mono">
      <span class="text-gray-500">🌐 Language / Idioma:</span>
      <a href="/#test" class={`px-2 py-0.5 border ${lang === 'en' ? 'border-yellow-400 text-yellow-400 font-bold' : 'border-gray-700 text-gray-400 hover:text-white'}`}>English</a>
      <a href="/es/#test" class={`px-2 py-0.5 border ${lang === 'es' ? 'border-yellow-400 text-yellow-400 font-bold' : 'border-gray-700 text-gray-400 hover:text-white'}`}>Español</a>
      <a href="/ja/#test" class={`px-2 py-0.5 border ${lang === 'ja' ? 'border-yellow-400 text-yellow-400 font-bold' : 'border-gray-700 text-gray-400 hover:text-white'}`}>日本語</a>
      <a href="/pt/#test" class={`px-2 py-0.5 border ${lang === 'pt' ? 'border-yellow-400 text-yellow-400 font-bold' : 'border-gray-700 text-gray-400 hover:text-white'}`}>Português</a>
    </div>
 </div>

 <!-- 2. Active Quiz Screen (Undertale Style) -->
  <div id="quiz-active" class="hidden">
    <!-- HUD Header -->
    <div id="hud" class="flex items-center gap-3 sm:gap-4 mb-4">
      <span id="hud-index" class="text-xl sm:text-2xl font-bold tracking-widest text-white whitespace-nowrap">01 / 66</span>
      <div id="completion-bar-track" class="flex-1 h-7 border-4 border-white bg-black p-0.5">
        <div id="progress-fill" class="h-full bg-red-600 w-0 transition-all duration-150"></div>
      </div>
      <button
        id="btn-quiz-reset"
        class="invisible px-2.5 py-1 text-xs text-gray-400 hover:text-white border-2 border-gray-700 hover:border-white bg-black uppercase tracking-wider cursor-pointer"
        title="Reset all progress"
      >
        {t.quizUI.hudResetBtn}
      </button>
    </div>

    <!-- Dialogue Box (Authentic Undertale Typewriter text) -->
    <div
      id="dialogue-box"
      class="pixel-box p-6 sm:p-8 mb-6 min-h-[140px] sm:min-h-[160px] cursor-pointer"
      title={t.quizUI.dialogueHint}
    >
      <div id="questions-text" class="text-xl sm:text-3xl font-normal leading-relaxed text-white tracking-wide break-words">
        <span class="text-white mr-3 font-bold select-none">*</span>
        <span id="questions-type" class="inline">{t.questions[0].q}</span>
      </div>
    </div>

    <!-- Answers Box (5-point Scale with Animated Red Heart Selector) -->
    <div id="answers-box" class="pixel-box p-6 sm:p-8 mb-6">
      <p id="tap-answer-hint" class="mb-4 text-center text-xs font-bold uppercase tracking-widest text-yellow-400 cursor-pointer touch-manipulation hover:text-white transition-colors" title={t.quizUI.tapAnswerHint}>
        * {t.quizUI.tapAnswerHint}
      </p>

     <!-- Extremes labels -->
      <div class="flex justify-between items-baseline gap-2 text-[9px] sm:text-xs text-gray-400 tracking-wider mb-3 sm:mb-6">
        <button
          type="button"
          id="label-extreme-left"
          class="uppercase whitespace-nowrap overflow-hidden text-ellipsis text-left cursor-pointer touch-manipulation hover:text-white hover:underline transition-colors active:scale-95 py-1"
        >
          {t.quizUI.extremeLeft}
        </button>
        <button
          type="button"
          id="label-extreme-right"
          class="uppercase whitespace-nowrap overflow-hidden text-ellipsis text-right cursor-pointer touch-manipulation hover:text-white hover:underline transition-colors active:scale-95 py-1"
        >
          {t.quizUI.extremeRight}
        </button>
     </div>

     <!-- 5-Point Scale Row -->
      <div id="scale-row" class="flex items-stretch justify-between gap-1 sm:gap-2 relative py-2 sm:py-4 sm:px-8">
        <!-- Scale points generated via JS -->
      </div>

      <!-- Centered Selected Option Label -->
      <div class="text-center mt-6 min-h-[2em] flex items-center justify-center">
        <button
          type="button"
          id="selected-label-text"
          class="text-xl sm:text-3xl font-bold text-white tracking-widest uppercase cursor-pointer touch-manipulation hover:text-red-400 hover:underline transition-colors active:scale-95 py-1 px-3"
        >
          {t.quizUI.likertLabels[2]}
        </button>
      </div>
    </div>

    <!-- Footer Controls & Hints -->
    <div id="question-footer" class="flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-gray-400">
      <div class="flex items-center gap-3 w-full sm:w-auto">
        <button
          id="btn-prev"
          class="flex-1 sm:flex-none px-5 py-2.5 bg-black border-2 border-gray-600 hover:border-white text-gray-300 hover:text-white uppercase tracking-wider disabled:opacity-30 disabled:pointer-events-none cursor-pointer active:scale-95 transition-all"
        >
          [X] {t.quizUI.backBtn}
        </button>
        <button
          id="btn-next"
          class="flex-1 sm:flex-none px-6 sm:px-7 py-2.5 bg-black border-2 border-red-500 hover:bg-red-500 hover:text-white text-red-400 font-bold uppercase tracking-wider cursor-pointer active:scale-95 transition-all text-center"
        >
          [Z] {t.quizUI.confirmBtn}
        </button>
      </div>

      <div class="hidden sm:block text-[11px] text-gray-400 text-center sm:text-right font-sans">
        <span>LEFT / RIGHT move &nbsp;·&nbsp; 1-5 jump &nbsp;·&nbsp; Z or ENTER confirm &nbsp;·&nbsp; X back</span>
      </div>
    </div>
  </div>

  <!-- 3. Result Screen -->
  <div id="quiz-result" class="hidden pixel-box p-6 sm:p-12 relative overflow-hidden">
    <!-- Top Result Banner -->
    <div class="text-center mb-10">
      <div id="result-heart" class="w-24 h-24 mx-auto mb-4 drop-shadow-[0_0_25px_var(--res-color)]" style="--res-color: #ff0000; color: #ff0000;">
        <svg viewBox="0 0 16 16" fill="currentColor" class="w-full h-full" shape-rendering="crispEdges">
          <path d="M2 0h4v1H2zm8 0h4v1h-4zM1 1h6v1H1zm8 0h6v1H9zM0 2h7v1H0zm9 2h7v1H9zM0 3h7v1H0zm9 3h7v1H9zM0 4h16v6H0zm2 6h12v2H2zm2 2h8v2H4zm2 2h4v2H6z"/>
        </svg>
      </div>

      <div class="inline-block px-3 py-1 text-xs font-mono font-bold tracking-widest uppercase mb-2 border-2" id="result-badge" style="color: #ff0000; border-color: #ff0000;">
        {t.quizUI.primaryVirtue}
      </div>

      <h3 id="result-trait-name" class="text-2xl sm:text-4xl font-black tracking-wide text-white mb-2 uppercase break-words">
        DETERMINATION
      </h3>

      <p id="result-color-label" class="text-xs sm:text-sm text-gray-400 tracking-widest mb-4">
        RED SOUL · #FF0000
      </p>

      <blockquote id="result-tagline" class="italic text-sm sm:text-base text-gray-300 max-w-xl mx-auto font-serif border-y border-gray-800 py-3">
        "Despite how many times I fell, I always got back up."
      </blockquote>

      <p id="result-description" class="text-xs sm:text-sm text-gray-300 max-w-2xl mx-auto mt-6 leading-relaxed font-sans text-left bg-black/60 border-2 border-gray-800 p-5">
        <!-- Injected via JS -->
      </p>

      <!-- First Screen Premium Card with Blurred Preview -->
      <div id="premium-unlock-card" class="mt-8 mb-8 max-w-2xl mx-auto p-5 sm:p-7 bg-gradient-to-b from-yellow-950/50 via-black to-black border-2 border-yellow-400 shadow-[0_0_30px_rgba(250,204,21,0.3)] text-center relative overflow-hidden">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-yellow-500/20 border border-yellow-400 text-yellow-300 text-xs font-mono font-bold uppercase tracking-widest mb-3">
          <span>⚡ LIMITED PROMO</span>
          <span>·</span>
          <span id="discount-timer" class="text-white font-mono font-bold">09:59</span>
        </div>
        
        <h4 class="text-xl sm:text-3xl font-black font-mono tracking-tight text-white uppercase mb-2">
          Unlock Full AI Deep Soul Archive
        </h4>
        <p class="text-xs sm:text-sm text-gray-300 max-w-lg mx-auto mb-4 leading-relaxed font-sans">
          Deep behavioral paradox analysis, Undertale battle dynamics, and verified PDF dossier based on your 66-item responses.
        </p>

        <!-- Blurred Sample Preview Area -->
        <div class="relative bg-black/80 border border-yellow-500/40 p-4 mb-5 text-left font-sans text-xs text-gray-300 rounded overflow-hidden">
          <p class="font-bold text-yellow-400 font-mono text-[11px] uppercase tracking-wider mb-1">
            ✦ AI PSYCHOLOGICAL DOSSIER PREVIEW:
          </p>
          <p class="leading-relaxed text-gray-200">
            "Your decision engine operates on a sharp internal locus of autonomy. When confronted by external pressure, your baseline strategy is not to retreat..."
          </p>
          <p class="blur-[4px] select-none opacity-40 leading-relaxed mt-1">
            ...however, under sustained crisis your secondary virtue triggers an unspoken friction point. You perceive vulnerability as compromise, silently bearing relational costs until situational rigidity threatens the very outcome you are fighting to protect...
          </p>
          <div class="absolute inset-0 flex items-center justify-center bg-black/50 backdrop-blur-[2px]">
            <div class="px-3.5 py-1.5 bg-black/95 border-2 border-yellow-400 text-yellow-300 font-mono font-bold text-xs uppercase tracking-widest shadow-[0_0_15px_rgba(250,204,21,0.6)] flex items-center gap-2">
              <span>🔒</span>
              <span>CLASSIFIED AI DOSSIER LOCKED</span>
            </div>
          </div>
        </div>

        <!-- Price Anchor -->
        <div class="flex items-center justify-center gap-3 mb-4 font-mono">
          <span class="text-xs text-gray-500 line-through">US$14.93</span>
          <span class="text-2xl sm:text-3xl font-black text-yellow-400">US$4.93</span>
          <span class="text-[10px] px-2 py-0.5 bg-red-600 text-white font-bold uppercase">67% OFF</span>
        </div>

        <button
          id="btn-checkout-waffo"
          type="button"
          class="w-full sm:w-auto px-8 py-3.5 bg-yellow-400 hover:bg-yellow-300 text-black font-mono font-black text-xs sm:text-sm uppercase tracking-wider shadow-[4px_4px_0_rgba(255,255,255,0.5)] active:translate-x-[2px] active:translate-y-[2px] cursor-pointer transition-all flex items-center justify-center gap-2 mx-auto"
        >
          <span id="btn-checkout-spinner" class="hidden animate-spin">✦</span>
          <span id="btn-checkout-text">UNLOCK FULL ARCHIVE NOW ($4.93) →</span>
        </button>

        <p class="text-[11px] text-gray-400 mt-3 font-sans">
          Instant Delivery · Multi-Page Verified Dossier · 100% Secure via Waffo
        </p>
      </div>

      <!-- Direct High-Converting Soul Trait Subpage Internal Link -->
      <div class="mt-6 text-center">
        <a
          id="btn-explore-dominant-soul"
          href="/souls/determination/"
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-black border-2 border-yellow-400 hover:bg-yellow-400 hover:text-black text-yellow-400 font-bold font-mono text-xs sm:text-sm tracking-wider uppercase shadow-[3px_3px_0px_rgba(250,204,21,0.5)] active:translate-x-[2px] active:translate-y-[2px] transition-all group"
        >
          <span class="text-base group-hover:scale-110 transition-transform">📖</span>
          <span id="btn-explore-dominant-text">Explore Determination Lore, Items & Combat Mechanics →</span>
        </a>
      </div>
    </div>

    <!-- Secondary Virtue / Shadow Trait Callout -->
    <div id="secondary-callout" class="mb-10 p-5 bg-black border-3 border-gray-700 relative">
      <div class="flex items-start gap-4">
        <div id="secondary-heart" class="w-8 h-8 flex-shrink-0 mt-0.5" style="color: #42fcff;">
          <svg viewBox="0 0 16 16" fill="currentColor" class="w-full h-full" shape-rendering="crispEdges">
