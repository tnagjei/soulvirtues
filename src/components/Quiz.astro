<script>
  import { computeScores as scoreAnswers } from "../data/scoring";
  import { ANSWER_STORAGE_KEY, BANK_VERSION, encodeAnswers, decodeAnswers } from "../data/quizSession";
  function initQuiz() {
    const root = document.getElementById("quiz-root");
    if (!root) return;
    if (root.dataset.initialized === "true") return;
    root.dataset.initialized = "true";

    const LANG = root.getAttribute("data-lang") || "en";
    const QUESTIONS = JSON.parse(root.getAttribute("data-questions") || "[]");
    const SOULS = JSON.parse(root.getAttribute("data-souls") || "{}");
    const SOUL_CODES = JSON.parse(root.getAttribute("data-soul-codes") || "[]");
    const QUIZ_UI = JSON.parse(root.getAttribute("data-quiz-ui") || "{}");
    const COMPARISON_PAIRS = JSON.parse(root.getAttribute("data-comparison-pairs") || "{}");

    const STORAGE_KEY = ANSWER_STORAGE_KEY;
    root.dataset.bankVersion = BANK_VERSION;
    const SETTINGS_KEY = "soulvirtues_audio_settings";

    // -------------------------------------------------------------
    // Audio Engine & Settings
    // -------------------------------------------------------------
    let audioSettings = {
      volMusic: 30,
      volSfx: 40,
      musicMuted: false,
      sfxMuted: false,
    };

    try {
      const savedSettings = localStorage.getItem(SETTINGS_KEY);
      if (savedSettings) {
        audioSettings = { ...audioSettings, ...JSON.parse(savedSettings) };
      }
    } catch (e) {}

    const audioBgm = document.getElementById("audio-bgm");
    const audioMove = document.getElementById("audio-move");
    const audioSelect = document.getElementById("audio-select");
    const audioAppear = document.getElementById("audio-appear");

    const TYPE_POOL_SIZE = 6;
    const typeAudioPool = [];
    for (let i = 0; i < TYPE_POOL_SIZE; i++) {
      const a = new Audio("/audio/sfx_text.wav");
      a.preload = "auto";
      typeAudioPool.push(a);
    }
    let typePoolIndex = 0;

    const MOVE_POOL_SIZE = 4;
    const moveAudioPool = [];
    for (let i = 0; i < MOVE_POOL_SIZE; i++) {
      const a = new Audio("/audio/sfx_move.wav");
      a.preload = "auto";
      moveAudioPool.push(a);
    }
    let movePoolIndex = 0;

    function saveAudioSettings() {
      try {
        localStorage.setItem(SETTINGS_KEY, JSON.stringify(audioSettings));
      } catch (e) {}
      updateAudioVolumes();
    }

    function updateAudioVolumes() {
      if (audioBgm) {
        audioBgm.muted = audioSettings.musicMuted;
        audioBgm.volume = audioSettings.volMusic / 100;
      }

      const labelMusic = document.getElementById("label-vol-music");
      const labelSfx = document.getElementById("label-vol-sfx");
      const sliderMusic = document.getElementById("slider-vol-music");
      const sliderSfx = document.getElementById("slider-vol-sfx");
      const btnMusicMute = document.getElementById("btn-toggle-music-mute");
      const btnSfxMute = document.getElementById("btn-toggle-sfx-mute");
      const soundIndicator = document.getElementById("sound-indicator-icon");

      if (labelMusic) labelMusic.textContent = audioSettings.musicMuted ? "MUTED" : `${audioSettings.volMusic}%`;
      if (labelSfx) labelSfx.textContent = audioSettings.sfxMuted ? "MUTED" : `${audioSettings.volSfx}%`;
      if (sliderMusic) sliderMusic.value = audioSettings.volMusic;
      if (sliderSfx) sliderSfx.value = audioSettings.volSfx;
      if (btnMusicMute) btnMusicMute.textContent = audioSettings.musicMuted ? "UNMUTE" : QUIZ_UI.muteBtn;
      if (btnSfxMute) btnSfxMute.textContent = audioSettings.sfxMuted ? "UNMUTE" : QUIZ_UI.muteBtn;
      if (soundIndicator) soundIndicator.textContent = (audioSettings.musicMuted && audioSettings.sfxMuted) ? "🔇" : "🔊";
    }

    function safePlay(audioEl) {
      if (!audioEl) return;
      try {
        const p = audioEl.play();
        if (p && typeof p.then === "function") {
          p.catch(() => {});
        }
      } catch (e) {}
    }

    function playSound(type) {
      if (audioSettings.sfxMuted || audioSettings.volSfx === 0) return;
      const sfxVol = audioSettings.volSfx / 100;

      try {
        if (type === "text") {
          const audio = typeAudioPool[typePoolIndex];
          typePoolIndex = (typePoolIndex + 1) % TYPE_POOL_SIZE;
          audio.volume = Math.min(1, sfxVol * 0.7);
          audio.currentTime = 0;
          safePlay(audio);
        } else if (type === "move") {
          const audio = moveAudioPool[movePoolIndex];
          movePoolIndex = (movePoolIndex + 1) % MOVE_POOL_SIZE;
          audio.volume = sfxVol;
          audio.currentTime = 0;
          safePlay(audio);
        } else if (type === "select" && audioSelect) {
          audioSelect.volume = sfxVol;
          audioSelect.currentTime = 0;
          safePlay(audioSelect);
        } else if (type === "appear" && audioAppear) {
          audioAppear.volume = sfxVol;
          audioAppear.currentTime = 0;
          safePlay(audioAppear);
        }
      } catch (e) {}
    }

    let bgmStarted = false;
    function startBgm() {
      if (audioSettings.musicMuted) return;
      if (bgmStarted && audioBgm && !audioBgm.paused) return;
      if (audioBgm) {
        updateAudioVolumes();
        try {
          const p = audioBgm.play();
          if (p && typeof p.then === "function") {
            p.then(() => {
              bgmStarted = true;
            }).catch(() => {});
          } else {
            bgmStarted = true;
          }
        } catch (e) {}
      }
    }

    // -------------------------------------------------------------
    // Typewriter System
    // -------------------------------------------------------------
    function setTypedContent(el, fullText, count) {
      el.textContent = fullText.slice(0, count);
    }

    let typeInterval = null;
    let isTyping = false;
    let currentFullText = "";

    function typeOut(el, text, speed = 25, onComplete) {
      if (typeInterval) clearInterval(typeInterval);
      currentFullText = text;
      isTyping = true;
      let i = 0;
      setTypedContent(el, text, 0);

      typeInterval = setInterval(() => {
        if (i < text.length) {
          i++;
          setTypedContent(el, text, i);
          const char = text[i - 1];
          if (char !== " " && char !== "\n") {
            playSound("text");
          }
        } else {
          clearInterval(typeInterval);
          typeInterval = null;
          isTyping = false;
          if (onComplete) onComplete();
        }
      }, speed);
    }

    function skipTyping() {
      if (typeInterval) {
        clearInterval(typeInterval);
        typeInterval = null;
      }
      isTyping = false;
      const target = document.getElementById("questions-type");
      const currentQ = QUESTIONS[currentIndex];
      if (target && currentQ) {
        target.textContent = currentQ.q;
      }
    }

    // -------------------------------------------------------------
    // Void Intro Sequence
    // -------------------------------------------------------------
    let introStep = 0;
    const introScenes = QUIZ_UI.introScenes || [
      "ARE WE CONNECTED?",
      "VERY INTERESTING. A SOUL IN THE VOID...",
      "LET US EXTRACT YOUR TRUE VIRTUE.",
    ];

    function runIntroScene(step) {
      const typeEl = document.getElementById("intro-type");
      if (!typeEl) return;
      if (step >= introScenes.length) {
        showScreen("start");
        return;
      }
      typeOut(typeEl, introScenes[step], 50);
    }

    function advanceIntro() {
      if (isTyping) {
        if (typeInterval) clearInterval(typeInterval);
        typeInterval = null;
        isTyping = false;
        const typeEl = document.getElementById("intro-type");
        if (typeEl) typeEl.textContent = currentFullText;
      } else {
        introStep++;
        runIntroScene(introStep);
      }
    }

    // -------------------------------------------------------------
    // Quiz State & Progression
    // -------------------------------------------------------------
    let currentIndex = 0;
    let userAnswers = new Array(QUESTIONS.length).fill(null);
    let currentSelection = 2; // Default Neutral
    let isAdvancing = false;
    let advanceTimer = null;
    let advanceStartTime = 0;

    function showPersistenceError() {
      document.getElementById("quiz-storage-error")?.classList.remove("hidden");
    }

    function saveProgress() {
      try {
        localStorage.setItem(STORAGE_KEY, encodeAnswers(userAnswers, QUESTIONS));
      } catch {
        showPersistenceError();
      }
    }

    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      const restored = saved ? decodeAnswers(saved, QUESTIONS) : null;
      if (restored) {
        userAnswers = restored;
      } else {
        const hasOlderProgress = ["en", "ja", "es", "pt", "ru"].some(locale =>
          localStorage.getItem("soulvirtues_answers_" + locale) !== null);
        if (saved || hasOlderProgress) document.getElementById("quiz-bank-update")?.classList.remove("hidden");
      }
    } catch {
      showPersistenceError();
    }

    function showScreen(screen) {
      ["intro", "start", "active", "result", "review", "souls"].forEach(s => {
        const el = document.getElementById("quiz-" + s);
        if (el) {
          if (s === screen) {
            el.classList.remove("hidden");
          } else {
            el.classList.add("hidden");
          }
        }
      });
      const testSection = document.getElementById("test") || document.getElementById("quiz-root");
      if (testSection) {
        testSection.scrollIntoView({ behavior: "smooth" });
      }
    }

    window.startSoulQuiz = function() {
      const activeScreen = document.getElementById("quiz-active");
      const resultScreen = document.getElementById("quiz-result");
      const testSection = document.getElementById("test") || document.getElementById("quiz-root");

      if (testSection) {
        testSection.scrollIntoView({ behavior: "smooth" });
      }

      if (resultScreen && !resultScreen.classList.contains("hidden")) {
        return;
      }

      if (activeScreen && !activeScreen.classList.contains("hidden")) {
        return;
      }

      const firstUnanswered = userAnswers.findIndex(a => a === null);
      showScreen("active");
      renderQuestion(firstUnanswered !== -1 ? firstUnanswered : 0);
      startBgm();
      playSound("select");
    };

    // Initial Screen Decision
    const isDebugResult = import.meta.env.DEV && (window.location.search.includes("debug=result") || window.location.hash === "#debug-result");
    if (isDebugResult && userAnswers.filter(a => a !== null).length < QUESTIONS.length) {
      userAnswers = new Array(QUESTIONS.length).fill(1);
      saveProgress();
    }

    const answeredCount = userAnswers.filter(a => a !== null).length;
    if (answeredCount === QUESTIONS.length) {
      showScreen("result");
      showResults();
    } else if (window.location.hash === "#test") {
      window.startSoulQuiz();
    } else {
      showScreen("intro");
      runIntroScene(0);
      if (answeredCount > 0) {
        const resumeBtn = document.getElementById("btn-resume-quiz");
        const resumeCount = document.getElementById("resume-count");
        if (resumeBtn && resumeCount) {
          resumeBtn.classList.remove("hidden");
          resumeCount.textContent = answeredCount;
        }
      }
    }

    function renderQuestion(index) {
      if (advanceTimer) {
        clearTimeout(advanceTimer);
        advanceTimer = null;
      }
      isAdvancing = false;
      currentIndex = index;
      const q = QUESTIONS[index];
      if (!q) return;
      root.dataset.questionId = q.id;

      currentSelection = userAnswers[index] !== null ? userAnswers[index] : 2;

      // Update HUD
      const hudIndex = document.getElementById("hud-index");
      const progressFill = document.getElementById("progress-fill");
      if (hudIndex) hudIndex.textContent = `${String(index + 1).padStart(2, "0")} / ${QUESTIONS.length}`;
      if (progressFill) progressFill.style.width = `${((index) / QUESTIONS.length) * 100}%`;

      const prevBtn = document.getElementById("btn-prev");
      if (prevBtn) prevBtn.disabled = index === 0;

      const resetBtn = document.getElementById("btn-quiz-reset");
      if (resetBtn) resetBtn.classList.toggle("invisible", index === 0);

      // Extremes labels
      const extremeLeft = document.getElementById("label-extreme-left");
      const extremeRight = document.getElementById("label-extreme-right");
      if (extremeLeft && q.labels) {
        extremeLeft.textContent = q.labels[0];
        extremeLeft.title = q.labels[0];
      }
      if (extremeRight && q.labels) {
        extremeRight.textContent = q.labels[q.labels.length - 1];
        extremeRight.title = q.labels[q.labels.length - 1];
      }

      buildScalePoints(q);

      const target = document.getElementById("questions-type");
      if (target) {
        target.textContent = q.q;
      }
      const dialogue = document.getElementById("dialogue-box");
      if (dialogue) {
        dialogue.classList.add("border-yellow-400");
        setTimeout(() => dialogue.classList.remove("border-yellow-400"), 200);
      }
    }

    function buildScalePoints(q) {
      const scaleRow = document.getElementById("scale-row");
      if (!scaleRow) return;
      scaleRow.innerHTML = "";

      q.labels.forEach((label, optIdx) => {
       const btn = document.createElement("button");
       btn.type = "button";
       const isSelected = currentSelection === optIdx;
        btn.className = `flex-1 min-w-0 min-h-16 flex flex-col items-center justify-center gap-1 py-2 border-2 cursor-pointer group outline-none transition-all active:scale-95 focus-visible:border-white touch-manipulation ${
         isSelected
            ? "border-red-500 bg-red-950/30 shadow-[0_0_10px_rgba(239,68,68,0.4)]"
           : "border-gray-700 bg-black hover:border-white"
       }`;
       btn.setAttribute("aria-label", label);
        btn.setAttribute("aria-describedby", "tap-answer-hint");

        btn.innerHTML = `
          <span class="text-[10px] font-bold text-gray-400 pointer-events-none" aria-hidden="true">${optIdx + 1}</span>
          <div class="w-10 h-10 sm:w-12 sm:h-12 flex items-center justify-center pointer-events-none">
            ${isSelected
              ? '<div class="w-8 h-8 sm:w-9 sm:h-9 text-red-600 drop-shadow-[0_0_12px_rgba(255,0,0,0.9)] animate-pulse transition-transform scale-110"><svg viewBox="0 0 16 16" fill="currentColor" class="w-full h-full" shape-rendering="crispEdges"><path d="M2 0h4v1H2zm8 0h4v1h-4zM1 1h6v1H1zm8 0h6v1H9zM0 2h7v1H0zm9 2h7v1H9zM0 3h7v1H0zm9 3h7v1H9zM0 4h16v6H0zm2 6h12v2H2zm2 2h8v2H4zm2 2h4v2H6z"/></svg></div>'
              : '<div class="w-5 h-5 sm:w-6 sm:h-6 bg-black border-3 sm:border-4 border-gray-600 group-hover:border-white transition-colors"></div>'
            }
          </div>
          <span class="hidden sm:block text-[9px] sm:text-[11px] text-gray-300 font-sans text-center px-1 leading-tight pointer-events-none line-clamp-2">${label}</span>
        `;

        btn.addEventListener("mouseenter", () => {
          const labelEl = document.getElementById("selected-label-text");
          if (labelEl) {
            labelEl.textContent = label;
            labelEl.title = label;
          }
        });

        btn.addEventListener("click", () => {
          selectAndAdvance(optIdx);
        });

        scaleRow.appendChild(btn);
      });

      scaleRow.addEventListener("mouseleave", () => {
        updateSelectedLabel(q);
      });

      updateSelectedLabel(q);
   }

   function selectAndAdvance(optIdx) {
      const now = Date.now();
      if (isAdvancing && now - advanceStartTime < 500) return;
     if (optIdx < 0 || optIdx > 4) return;
      if (advanceTimer) {
        clearTimeout(advanceTimer);
        advanceTimer = null;
      }
      isAdvancing = true;
      advanceStartTime = now;
     currentSelection = optIdx;
     buildScalePoints(QUESTIONS[currentIndex]);
      advanceTimer = setTimeout(() => {
        try {
          confirmAndAdvance();
        } finally {
          isAdvancing = false;
          advanceTimer = null;
        }
      }, 300);
   }

   function setSelection(optIdx) {
      if (optIdx < 0 || optIdx > 4) return;
      if (currentSelection !== optIdx) {
        playSound("move");
      }
      currentSelection = optIdx;
      const q = QUESTIONS[currentIndex];
      buildScalePoints(q);
    }

    function updateSelectedLabel(q) {
      const labelEl = document.getElementById("selected-label-text");
      if (labelEl && q.labels && q.labels[currentSelection]) {
        labelEl.textContent = q.labels[currentSelection];
        labelEl.title = q.labels[currentSelection];
      }
    }

    function confirmAndAdvance() {
      playSound("select");
      userAnswers[currentIndex] = currentSelection;
      saveProgress();

      if (currentIndex < QUESTIONS.length - 1) {
        renderQuestion(currentIndex + 1);
      } else {
        trackEvent("quiz_complete", { language: LANG });
        showResults();
      }
    }

    function goBack() {
      if (advanceTimer) {
        clearTimeout(advanceTimer);
        advanceTimer = null;
      }
      isAdvancing = false;
      if (currentIndex > 0) {
        playSound("move");
        renderQuestion(currentIndex - 1);
      }
    }

    // -------------------------------------------------------------
    // Mathematical Scoring Engine
    // -------------------------------------------------------------
    function computeScores() {
      return scoreAnswers(userAnswers, QUESTIONS);
    }

    function getResultDisplay(score) {
      const copy = QUIZ_UI.resultReading;
      if (score.kind === "balanced" || score.kind === "incomplete") {
        return {
          name: score.kind === "incomplete" ? copy.incompleteTitle : copy.noPreferenceTitle,
          label: copy.summaryBadge, hex: "#94a3b8",
          tag: copy.cardScaleNote,
          description: score.kind === "incomplete" ? copy.incompleteBody : copy.noPreferenceBody,
        };
      }
      const leading = SOULS[score.ranked[0]];
      if (score.kind === "tied") {
        return { ...leading, name: copy.tieTitle, tag: score.leaders.map(code => SOULS[code].name).join(" / "),
          label: copy.summaryBadge, description: copy.tieBody };
      }
      if (score.kind === "close") {
        return { ...leading, name: score.leaders.map(code => SOULS[code].name).join(" / "),
          label: copy.summaryBadge, tag: copy.closeBody, description: copy.closeBody };
      }
      return leading;
    }

    // -------------------------------------------------------------
    // Results Rendering & Exports
    // -------------------------------------------------------------
    function showResults() {
      playSound("appear");
      const score = computeScores();
      const { pct, ranked } = score;
      const dominantCode = ranked[0];
      try {
        localStorage.setItem("soul_virtues_last_result", JSON.stringify({
          pct,
          dominant: dominantCode,
          secondary: score.secondarySoul,
          lang: typeof LANG !== 'undefined' ? LANG : 'en'
        }));
      } catch (e) {}
      const dominantSoul = getResultDisplay(score);

      const heartEl = document.getElementById("result-heart");
      const badgeEl = document.getElementById("result-badge");
      const nameEl = document.getElementById("result-trait-name");
      const colorLabelEl = document.getElementById("result-color-label");
      const taglineEl = document.getElementById("result-tagline");
      const descEl = document.getElementById("result-description");

      if (heartEl) {
        heartEl.style.color = dominantSoul.hex;
        heartEl.style.setProperty("--res-color", dominantSoul.hex);
      }
      if (badgeEl) {
        badgeEl.textContent = score.kind === "dominant" ? QUIZ_UI.primaryVirtue : QUIZ_UI.resultReading.summaryBadge;
        badgeEl.style.color = dominantSoul.hex;
        badgeEl.style.borderColor = dominantSoul.hex;
      }
      if (nameEl) nameEl.textContent = dominantSoul.name;
      if (colorLabelEl) colorLabelEl.textContent = `${dominantSoul.label} · ${dominantSoul.hex.toUpperCase()}`;
      colorLabelEl?.classList.toggle("hidden", score.kind !== "dominant");
      taglineEl?.classList.toggle("hidden", score.kind !== "dominant" && score.kind !== "tied");
      if (taglineEl) taglineEl.textContent = `"${dominantSoul.tag}"`;
      if (descEl) descEl.textContent = dominantSoul.description;
      root.dataset.resultKind = score.kind;
      document.getElementById("result-score-note").textContent = QUIZ_UI.resultReading.scoreScaleNote;
      document.getElementById("secondary-callout").classList.toggle("hidden", score.secondarySoul === null);
      for (const id of ["btn-share-card", "btn-download-card"]) {
        document.getElementById(id).disabled = score.kind === "incomplete";
      }
      const evidenceList = document.getElementById("result-answer-evidence");
      evidenceList.replaceChildren();
      const evidence = score.contributions.filter(item => item.trait === dominantCode)
        .sort((a, b) => Math.abs(b.points) - Math.abs(a.points)).slice(0, 3);
      document.getElementById("result-evidence").classList.toggle("hidden", !evidence.length || score.kind === "incomplete");
      for (const item of evidence) {
        const q = QUESTIONS[item.questionIndex];
        const row = document.createElement("li");
        const question = document.createElement("p");
        const effect = document.createElement("p");
        question.textContent = `${item.questionIndex + 1}. ${q.q}`;
        effect.className = "mt-1 text-gray-400";
        effect.textContent = `${q.labels[item.answerIndex]} — ${SOULS[item.trait].name}: ${item.points > 0 ? QUIZ_UI.resultReading.evidenceRaised : QUIZ_UI.resultReading.evidenceLowered} (${item.points > 0 ? "+" : ""}${item.points})`;
        row.append(question, effect);
        evidenceList.appendChild(row);
      }

      // Secondary Virtue / Shadow Trait
      const secondaryCode = ranked[1];
      const secondarySoul = SOULS[secondaryCode];
      const secHeart = document.getElementById("secondary-heart");
      const secName = document.getElementById("secondary-name");
      const secPct = document.getElementById("secondary-pct");
      const secDesc = document.getElementById("secondary-desc");

      if (secHeart) secHeart.style.color = secondarySoul.hex;
      if (secName) secName.textContent = secondarySoul.name;
      if (secPct) secPct.textContent = `${pct[secondaryCode].toFixed(1)}%`;
      if (secDesc) secDesc.textContent = secondarySoul.description;

      const compareBtn = document.getElementById("btn-compare-top-souls");
      const comparison = score.kind === "balanced" || score.kind === "incomplete" || (score.kind === "tied" && score.leaders.length > 2) || (score.kind === "dominant" && score.secondarySoul === null)
        ? null : COMPARISON_PAIRS[[dominantCode, secondaryCode].sort().join("-")];
      if (compareBtn) {
        compareBtn.classList.toggle("hidden", !comparison);
        compareBtn.classList.toggle("inline-flex", Boolean(comparison));
        if (comparison) {
          compareBtn.href = comparison.path;
          compareBtn.textContent = comparison.label;
        }
      }

      // Direct Internal Link to Dominant Soul Subpage
      const exploreBtn = document.getElementById("btn-explore-dominant-soul");
      const exploreText = document.getElementById("btn-explore-dominant-text");
      if (exploreBtn && exploreText) {
        const soulSlugMap = {
          DET: 'determination',
          BRV: 'bravery',
          JUS: 'justice',
          KND: 'kindness',
          PAT: 'patience',
          INT: 'integrity',
          PER: 'perseverance'
        };
        const slug = soulSlugMap[dominantCode] || 'determination';
        const langPrefix = LANG === 'en' ? '' : `/${LANG}`;
        exploreBtn.href = score.kind === "dominant" ? `${langPrefix}/souls/${slug}/` : `${langPrefix}/souls/`;
        exploreBtn.style.borderColor = dominantSoul.hex;
        exploreBtn.style.color = dominantSoul.hex;
        exploreText.textContent = score.kind === "dominant" ? `${dominantSoul.name} →` : QUIZ_UI.resultReading.allSoulsLink;
      }

      // 7 Trait Bars
      const barsContainer = document.getElementById("virtue-bars");
      if (barsContainer) {
        barsContainer.innerHTML = "";
        ranked.forEach(code => {
          const s = SOULS[code];
          const val = pct[code].toFixed(1);
          const row = document.createElement("div");
          row.className = "space-y-1";
          row.innerHTML = `
            <div class="flex justify-between items-center text-xs font-mono">
              <span class="font-bold tracking-wider" style="color: ${s.hex}">${s.name} (${s.label})</span>
              <span class="text-white font-bold">${val}%</span>
            </div>
            <div class="h-4 border-2 border-gray-700 bg-black p-0.5">
              <div class="h-full transition-all duration-500" style="width: ${val}%; background: ${s.hex}"></div>
            </div>
          `;
          barsContainer.appendChild(row);
        });
      }

      // Refresh Feedback Roadmap Card View
      const voteKey = "soulvirtues_roadmap_vote_v1";
      const formEl = document.getElementById("feedback-vote-form");
      const successEl = document.getElementById("feedback-vote-success");
      const savedVote = localStorage.getItem(voteKey);
      if (savedVote && !window.location.search.includes("debug=result")) {
        formEl?.classList.add("hidden");
        successEl?.classList.remove("hidden");
      } else {
        formEl?.classList.remove("hidden");
        successEl?.classList.add("hidden");
      }

      showScreen("result");
    }

    // Share Card Canvas Generator
    function showCardModal(dataUrl) {
      const modal = document.getElementById("card-preview-modal");
      const img = document.getElementById("card-preview-img");
      if (modal && img) {
        img.src = dataUrl;
        modal.classList.remove("hidden");
      }
    }

    function trackEvent(eventName, params = {}) {
      if (typeof window.gtag === "function") {
        // 只允许固定统计维度，避免结果、题目或自由输入进入 Analytics。
        const allowed = ["language", "method", "content_type", "choice"];
        const safeParams = Object.fromEntries(Object.entries(params).filter(([key]) => allowed.includes(key)));
        window.gtag("event", eventName, safeParams);
      }
    }

    function getShareUrl() {
      const localePath = LANG === "en" ? "/" : `/${LANG}/`;
      return `https://soulvirtues.org${localePath}?utm_source=share_sheet&utm_medium=share&utm_campaign=result_card`;
    }

    function buildResultCard() {
      const score = computeScores();
      const { pct, ranked } = score;
      const dominant = getResultDisplay(score);

      const canvas = document.createElement("canvas");
      canvas.width = 1080;
      canvas.height = 1350;
      const ctx = canvas.getContext("2d");
      if (!ctx) throw new Error("Canvas 2D context unavailable");

      // Off-black background keeps the card legible without flattening every layer.
      ctx.fillStyle = "#080909";
      ctx.fillRect(0, 0, 1080, 1350);

      ctx.strokeStyle = "#f4f4ef";
      ctx.lineWidth = 12;
      ctx.strokeRect(18, 18, 1044, 1314);

      ctx.strokeStyle = dominant.hex;
      ctx.lineWidth = 3;
      ctx.strokeRect(34, 34, 1012, 1282);

      ctx.fillStyle = "#f4f4ef";
      ctx.font = "bold 28px monospace";
      ctx.textAlign = "left";
      ctx.fillText("SOUL VIRTUES EXTRACTOR", 70, 82);

      ctx.fillStyle = "#9da19e";
      ctx.font = "18px monospace";
      ctx.fillText("soulvirtues.org", 70, 118);

      ctx.fillStyle = "#c9ccc9";
      ctx.font = "bold 17px monospace";
      ctx.textAlign = "right";
      ctx.fillText("V" + BANK_VERSION.split("-")[0] + " · " + QUIZ_UI.shareCardMeta, 1010, 82, 410);

      ctx.strokeStyle = "#343936";
      ctx.lineWidth = 3;
      ctx.beginPath();
      ctx.moveTo(70, 165);
      ctx.lineTo(1010, 165);
      ctx.stroke();

      // Pixel heart
      ctx.fillStyle = dominant.hex;
      const heart = new Path2D("M2 0h4v1H2zm8 0h4v1h-4zM1 1h6v1H1zm8 0h6v1H9zM0 2h7v1H0zm9 0h7v1H9zM0 3h7v1H0zm9 0h7v1H9zM0 4h16v6H0zm2 6h12v2H2zm2 2h8v2H4zm2 2h4v2H6z");
      ctx.save();
      ctx.translate(75, 220);
      ctx.scale(11, 11);
      ctx.fill(heart);
      ctx.restore();

      // Dominant trait
      ctx.textAlign = "left";
      ctx.fillStyle = "#9da19e";
      ctx.font = "bold 17px monospace";
      ctx.fillText(score.kind === "dominant" ? QUIZ_UI.primaryVirtue : QUIZ_UI.resultReading.summaryBadge, 315, 225, 695);

      ctx.fillStyle = dominant.hex;
      ctx.font = "bold 68px monospace";
      ctx.fillText(dominant.name, 315, 305, 695);

      ctx.fillStyle = "#d7dad7";
      ctx.font = "bold 22px monospace";
      if (score.kind === "dominant") ctx.fillText(`${dominant.label} · ${dominant.hex.toUpperCase()}`, 315, 350, 695);

      ctx.fillStyle = "#f4f4ef";
      ctx.font = "bold 42px monospace";
      ctx.fillText(`${pct[ranked[0]].toFixed(1)}%`, 315, 420);

      // Keep the localized tagline on one bounded line so it cannot overlap the bars.
      ctx.fillStyle = "#101211";
      ctx.fillRect(70, 465, 940, 80);
      ctx.strokeStyle = "#39403b";
      ctx.lineWidth = 2;
      ctx.strokeRect(70, 465, 940, 80);
      ctx.fillStyle = "#e3e5e2";
      ctx.font = "bold 22px monospace";
      ctx.fillText(dominant.tag, 94, 515, 892);

      // 7 virtues
      ctx.fillStyle = "#f4f4ef";
      ctx.font = "bold 21px monospace";
      ctx.fillText(QUIZ_UI.breakdownTitle, 70, 595, 940);

      const startY = 650;
      ranked.forEach((code, idx) => {
        const s = SOULS[code];
        const val = pct[code];
        const y = startY + idx * 68;

        ctx.fillStyle = s.hex;
        ctx.font = "bold 17px monospace";
        ctx.textAlign = "left";
        ctx.fillText(s.name, 70, y, 740);

        ctx.fillStyle = "#f4f4ef";
        ctx.textAlign = "right";
        ctx.fillText(`${val.toFixed(1)}%`, 1010, y);

        ctx.fillStyle = "#1c1f1d";
        ctx.fillRect(70, y + 14, 940, 16);
        ctx.strokeStyle = "#454945";
        ctx.lineWidth = 1;
        ctx.strokeRect(70, y + 14, 940, 16);

        ctx.fillStyle = s.hex;
        ctx.fillRect(72, y + 16, (936 * val) / 100, 12);
      });

      // Clear call to action keeps the typed domain visible even when a share target drops text.
      ctx.fillStyle = "#061d09";
      ctx.fillRect(70, 1135, 940, 135);
      ctx.strokeStyle = dominant.hex;
      ctx.lineWidth = 3;
      ctx.strokeRect(70, 1135, 940, 135);

      ctx.textAlign = "left";
      ctx.fillStyle = "#f4f4ef";
      ctx.font = "bold 25px monospace";
      ctx.fillText(QUIZ_UI.shareCardQuestion, 95, 1182, 800);

      ctx.fillStyle = dominant.hex;
      ctx.font = "bold 20px monospace";
      ctx.fillText(`${QUIZ_UI.shareCardCta} · soulvirtues.org`, 95, 1225, 800);

      ctx.textAlign = "right";
      ctx.font = "bold 44px monospace";
      ctx.fillText("→", 970, 1215);

      ctx.fillStyle = "#676b68";
      ctx.font = "13px monospace";
      ctx.textAlign = "left";
      ctx.fillText("SOUL VIRTUES EXTRACTOR", 70, 1305);
      ctx.textAlign = "right";
      ctx.fillText("PRIVATE · CLIENT-SIDE", 1010, 1305);

      const filename = `soul-virtues-${score.kind === "dominant" ? ranked[0].toLowerCase() : score.kind}-${LANG}.png`;
      const dataUrl = canvas.toDataURL("image/png");
      return { dataUrl, dominant, filename };
    }

    async function downloadResultCard() {
      playSound("select");
      const { dataUrl, filename } = buildResultCard();
      trackEvent("result_card_download", { language: LANG });

      // iOS browsers and in-app WebViews (e.g. Instagram, Facebook, TikTok, Line, Android wv) ignore or block <a download>.
      const ua = navigator.userAgent || "";
      const isIOS = /iPad|iPhone|iPod/.test(ua) || (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);
      const isWebView = /;\s*wv\b|Android.*Version\/|Instagram|FBAN|FBAV|Twitter|Line|MicroMessenger|Weibo|TikTok|BytedanceWebview/i.test(ua);
      if (isIOS || isWebView) {
        showCardModal(dataUrl);
        return;
      }

      const link = document.createElement("a");
      link.download = filename;
      link.href = dataUrl;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }

    async function shareResultCard() {
      playSound("select");
      const { dataUrl, dominant, filename } = buildResultCard();
      const shareUrl = getShareUrl();
      trackEvent("share_open", { method: "native", content_type: "result_card" });
      const shareData = {
        title: "Soul Virtues Extractor",
        text: `${dominant.name} · ${QUIZ_UI.shareCardQuestion} ${shareUrl}`,
        url: shareUrl,
      };

      if (typeof navigator !== "undefined" && typeof navigator.share === "function" && typeof File !== "undefined") {
        try {
          const res = await fetch(dataUrl);
          const blob = await res.blob();
          const file = new File([blob], filename, { type: "image/png" });
          const fileShareData = { ...shareData, files: [file] };
          if (navigator.canShare && navigator.canShare(fileShareData)) {
            await navigator.share(fileShareData);
          } else {
            await navigator.share(shareData);
          }
          trackEvent("share", {
            method: "native",
            content_type: "result_card",
            item_id: dominant.name,
          });
          return;
        } catch (err) {
          if (err && err.name === "AbortError") {
            return;
          }
        }
      }

      await copyShareLink(document.getElementById("btn-share-card"));
    }

    async function copyShareLink(eventOrButton) {
      if (eventOrButton?.currentTarget) playSound("select");
      const button = eventOrButton?.currentTarget || eventOrButton || document.getElementById("btn-copy-link");
      const shareUrl = getShareUrl();

      try {
        if (!navigator.clipboard?.writeText) throw new Error("Clipboard unavailable");
        await navigator.clipboard.writeText(shareUrl);
        trackEvent("share_link_copy", { language: LANG });
        const btn = button;
        if (btn) {
          const orig = btn.innerHTML;
          btn.textContent = `✓ ${QUIZ_UI.linkCopiedNotice}`;
          setTimeout(() => { btn.innerHTML = orig; }, 2000);
        }
      } catch (error) {
        window.prompt(QUIZ_UI.copyLinkBtn, shareUrl);
      }
    }

    // Answers Review List
    function buildReviewList() {
      const list = document.getElementById("review-list");
      if (!list) return;
      list.innerHTML = "";
      QUESTIONS.forEach((q, i) => {
        const ans = userAnswers[i];
        const label = (ans !== null && ans !== undefined && q.labels && q.labels[ans]) ? q.labels[ans] : "Unanswered";
        const item = document.createElement("div");
        item.innerHTML = `
          <div class="text-sm sm:text-base text-white leading-relaxed tracking-wide">
            <span class="text-gray-500 mr-2">${String(i + 1).padStart(2, "0")}.</span>${q.q}
          </div>
          <div class="text-yellow-400 text-xs sm:text-sm tracking-widest uppercase mt-1 pl-7">&gt; ${label}</div>
        `;
        list.appendChild(item);
      });
    }

    // Souls Gallery
    function buildSoulsGallery() {
      const grid = document.getElementById("souls-grid");
      if (!grid) return;
      grid.innerHTML = "";
      SOUL_CODES.forEach(code => {
        const soul = SOULS[code];
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "flex items-center gap-2 px-3 py-2 bg-black border-2 border-gray-600 hover:border-white text-xs sm:text-sm font-bold tracking-widest uppercase cursor-pointer active:scale-95 transition-all";
        btn.style.color = soul.hex;
        btn.innerHTML = `
          <span class="w-4 h-4 inline-block"><svg viewBox="0 0 16 16" fill="currentColor" class="w-full h-full" shape-rendering="crispEdges"><path d="M2 0h4v1H2zm8 0h4v1h-4zM1 1h6v1H1zm8 0h6v1H9zM0 2h7v1H0zm9 2h7v1H9zM0 3h7v1H0zm9 3h7v1H9zM0 4h16v6H0zm2 6h12v2H2zm2 2h8v2H4zm2 2h4v2H6z"/></svg></span>
          <span>${soul.name}</span>
        `;
        btn.addEventListener("click", () => {
          playSound("select");
          const detail = document.getElementById("soul-detail");
          const heartEl = document.getElementById("soul-detail-heart");
          const nameEl = document.getElementById("soul-detail-name");
          const labelEl = document.getElementById("soul-detail-label");
          const tagEl = document.getElementById("soul-detail-tag");
          const descEl = document.getElementById("soul-detail-desc");

          if (heartEl) heartEl.style.color = soul.hex;
          if (nameEl) {
            nameEl.textContent = soul.name;
            nameEl.style.color = soul.hex;
          }
          if (labelEl) labelEl.textContent = `${soul.label} SOUL · ${soul.hex.toUpperCase()}`;
          if (tagEl) tagEl.textContent = `"${soul.tag}"`;
          if (descEl) descEl.textContent = soul.description;
          if (detail) detail.classList.remove("hidden");
        });
        grid.appendChild(btn);
      });
    }

    // -------------------------------------------------------------
    // Event Listeners
    // -------------------------------------------------------------
    const btnOpenSettings = document.getElementById("btn-open-settings");
    const btnCloseSettings = document.getElementById("btn-close-settings");
    const settingsModal = document.getElementById("settings-modal");

    btnOpenSettings?.addEventListener("click", (e) => {
      e.stopPropagation();
      playSound("select");
      settingsModal?.classList.toggle("hidden");
    });

    btnCloseSettings?.addEventListener("click", () => {
      playSound("move");
      settingsModal?.classList.add("hidden");
    });

    document.addEventListener("click", (e) => {
      if (settingsModal && !settingsModal.contains(e.target) && e.target !== btnOpenSettings) {
        settingsModal.classList.add("hidden");
      }
    });

    document.getElementById("slider-vol-music")?.addEventListener("input", (e) => {
      audioSettings.volMusic = parseInt(e.target.value, 10);
      audioSettings.musicMuted = false;
      saveAudioSettings();
      startBgm();
    });

    document.getElementById("slider-vol-sfx")?.addEventListener("input", (e) => {
      audioSettings.volSfx = parseInt(e.target.value, 10);
      audioSettings.sfxMuted = false;
      saveAudioSettings();
      playSound("move");
    });

    document.getElementById("btn-toggle-music-mute")?.addEventListener("click", () => {
      audioSettings.musicMuted = !audioSettings.musicMuted;
      saveAudioSettings();
      if (!audioSettings.musicMuted) startBgm();
    });

    document.getElementById("btn-toggle-sfx-mute")?.addEventListener("click", () => {
      audioSettings.sfxMuted = !audioSettings.sfxMuted;
      saveAudioSettings();
      if (!audioSettings.sfxMuted) playSound("select");
    });

    document.getElementById("btn-start-fresh")?.addEventListener("click", () => {
      userAnswers = new Array(QUESTIONS.length).fill(null);
      try {
        saveProgress();
        localStorage.removeItem("soulvirtues_roadmap_vote_v1");
      } catch (e) {}
      showScreen("active");
      renderQuestion(0);
      startBgm();
      playSound("select");
    });

    function triggerStartFromIntroOrCard() {
      const resumeBtn = document.getElementById("btn-resume-quiz");
      if (resumeBtn && !resumeBtn.classList.contains("hidden")) {
        resumeBtn.click();
      } else {
        document.getElementById("btn-start-fresh")?.click();
      }
    }
    document.getElementById("quiz-start-title")?.addEventListener("click", triggerStartFromIntroOrCard);
    document.getElementById("quiz-start-heart")?.addEventListener("click", triggerStartFromIntroOrCard);

    document.getElementById("quiz-intro")?.addEventListener("click", advanceIntro);
    document.getElementById("btn-skip-intro")?.addEventListener("click", (e) => {
      e.stopPropagation();
      playSound("select");
      showScreen("start");
    });

    document.getElementById("btn-review-answers")?.addEventListener("click", () => {
      playSound("select");
      buildReviewList();
      showScreen("review");
    });
    document.getElementById("btn-review-back")?.addEventListener("click", () => {
      playSound("move");
      showScreen("result");
    });
    document.getElementById("btn-browse-souls")?.addEventListener("click", () => {
      playSound("select");
      buildSoulsGallery();
      document.getElementById("soul-detail")?.classList.add("hidden");
      showScreen("souls");
    });
    document.getElementById("btn-souls-back")?.addEventListener("click", () => {
      playSound("move");
      showScreen("result");
    });

    document.getElementById("btn-resume-quiz")?.addEventListener("click", () => {
      const firstUnanswered = userAnswers.findIndex(a => a === null);
      showScreen("active");
      renderQuestion(firstUnanswered !== -1 ? firstUnanswered : 0);
      startBgm();
      playSound("select");
    });

    document.getElementById("dialogue-box")?.addEventListener("click", skipTyping);

    document.getElementById("btn-quiz-reset")?.addEventListener("click", () => {
      if (confirm(QUIZ_UI.resetConfirm || "Reset all 66 questions?")) {
        userAnswers = new Array(QUESTIONS.length).fill(null);
        saveProgress();
        showScreen("start");
      }
    });

    document.getElementById("btn-prev")?.addEventListener("click", goBack);
    document.getElementById("btn-next")?.addEventListener("click", confirmAndAdvance);

    document.getElementById("label-extreme-left")?.addEventListener("click", () => {
      selectAndAdvance(0);
    });
    document.getElementById("label-extreme-right")?.addEventListener("click", () => {
      selectAndAdvance(4);
    });
    document.getElementById("selected-label-text")?.addEventListener("click", () => {
      selectAndAdvance(currentSelection);
    });
    document.getElementById("tap-answer-hint")?.addEventListener("click", () => {
      selectAndAdvance(currentSelection);
    });

    document.getElementById("label-extreme-left")?.addEventListener("mouseenter", () => {
      const labelEl = document.getElementById("selected-label-text");
      const q = QUESTIONS[currentIndex];
      if (labelEl && q && q.labels) {
        labelEl.textContent = q.labels[0];
        labelEl.title = q.labels[0];
      }
    });
    document.getElementById("label-extreme-left")?.addEventListener("mouseleave", () => {
      const q = QUESTIONS[currentIndex];
      if (q) updateSelectedLabel(q);
    });
    document.getElementById("label-extreme-right")?.addEventListener("mouseenter", () => {
      const labelEl = document.getElementById("selected-label-text");
      const q = QUESTIONS[currentIndex];
      if (labelEl && q && q.labels) {
        labelEl.textContent = q.labels[q.labels.length - 1];
        labelEl.title = q.labels[q.labels.length - 1];
      }
    });
    document.getElementById("label-extreme-right")?.addEventListener("mouseleave", () => {
      const q = QUESTIONS[currentIndex];
      if (q) updateSelectedLabel(q);
    });

    document.getElementById("btn-share-card")?.addEventListener("click", shareResultCard);
    document.getElementById("btn-download-card")?.addEventListener("click", downloadResultCard);
    document.getElementById("btn-copy-link")?.addEventListener("click", copyShareLink);

    // Waffo Checkout Handler
    const checkoutBtn = document.getElementById("btn-checkout-waffo");
    if (checkoutBtn) {
      checkoutBtn.addEventListener("click", async () => {
        const textEl = document.getElementById("btn-checkout-text");
        const spinner = document.getElementById("btn-checkout-spinner");
        if (textEl) textEl.textContent = "CONNECTING SECURE CHECKOUT...";
        if (spinner) spinner.classList.remove("hidden");
        checkoutBtn.disabled = true;

        try {
          const res = await fetch("/api/create-checkout", { method: "POST" });
          const data = await res.json();
          if (data.checkoutUrl) {
            window.open(data.checkoutUrl, "_blank", "noopener,noreferrer");
          } else {
            throw new Error(data.error || "No checkout URL");
          }
        } catch (e) {
          window.open("https://pancake.waffo.ai/store/tangjei-v8slaj4n", "_blank", "noopener,noreferrer");
        } finally {
          if (textEl) textEl.textContent = "UNLOCK YOUR AI REPORT ($4.93) →";
          if (spinner) spinner.classList.add("hidden");
          checkoutBtn.disabled = false;
        }
      });
    }

    let secondsLeft = 599;
    const timerEl = document.getElementById("discount-timer");
    if (timerEl) {
      setInterval(() => {
        if (secondsLeft > 0) {
          secondsLeft--;
          const m = String(Math.floor(secondsLeft / 60)).padStart(2, "0");
          const s = String(secondsLeft % 60).padStart(2, "0");
          timerEl.textContent = `${m}:${s}`;
        }
      }, 1000);
    }
    document.getElementById("btn-retake")?.addEventListener("click", () => {
      try { localStorage.removeItem("soulvirtues_roadmap_vote_v1"); } catch (e) {}
      showScreen("start");
    });

    // Community Feedback Roadmap Vote Handler
    function initFeedbackVote() {
      const voteKey = "soulvirtues_roadmap_vote_v1";
      const formEl = document.getElementById("feedback-vote-form");
      const successEl = document.getElementById("feedback-vote-success");
      const changeVoteBtn = document.getElementById("btn-change-vote");

      if (!formEl || !successEl) return;

      function refreshVoteState() {
        const savedVote = localStorage.getItem(voteKey);
        if (savedVote && !window.location.search.includes("debug=result")) {
          formEl.classList.add("hidden");
          successEl.classList.remove("hidden");
        } else {
          formEl.classList.remove("hidden");
          successEl.classList.add("hidden");
        }
      }
      refreshVoteState();

      changeVoteBtn?.addEventListener("click", () => {
        formEl.classList.remove("hidden");
        successEl.classList.add("hidden");
        document.getElementById("btn-submit-other-vote")?.focus();
      });

      function submitVote(choice) {
        playSound("click");
        trackEvent("feedback_roadmap_vote", {
          choice,
          language: LANG,
        });
        try {
          localStorage.setItem(voteKey, choice);
        } catch (e) {}

        formEl.classList.add("hidden");
        successEl.classList.remove("hidden");
        successEl.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }

      document.querySelectorAll(".feedback-vote-opt").forEach((btn) => {
        btn.addEventListener("click", () => {
          const vote = btn.getAttribute("data-vote");
          if (vote) submitVote(vote);
        });
      });


    }
    initFeedbackVote();

    document.getElementById("btn-close-card-modal")?.addEventListener("click", () => {
      document.getElementById("card-preview-modal")?.classList.add("hidden");
    });
    document.getElementById("btn-done-card-modal")?.addEventListener("click", () => {
      document.getElementById("card-preview-modal")?.classList.add("hidden");
    });
    document.getElementById("card-preview-modal")?.addEventListener("click", (e) => {
      if (e.target === document.getElementById("card-preview-modal")) {
        document.getElementById("card-preview-modal")?.classList.add("hidden");
      }
    });

    // Keyboard navigation
    window.addEventListener("keydown", (e) => {
      const introScreen = document.getElementById("quiz-intro");
      if (introScreen && !introScreen.classList.contains("hidden")) {
        if (e.key === "Enter" || e.key.toLowerCase() === "z" || e.key === " ") {
          e.preventDefault();
          advanceIntro();
        }
        return;
      }

      const startScreen = document.getElementById("quiz-start");
      if (startScreen && !startScreen.classList.contains("hidden")) {
        if (e.key === "Enter" || e.key.toLowerCase() === "z" || e.key === " ") {
          e.preventDefault();
          triggerStartFromIntroOrCard();
        }
        return;
      }

      const activeScreen = document.getElementById("quiz-active");
      if (!activeScreen || activeScreen.classList.contains("hidden")) return;

      if (e.key === "ArrowLeft" || e.key.toLowerCase() === "a") {
        e.preventDefault();
        setSelection(Math.max(0, currentSelection - 1));
      } else if (e.key === "ArrowRight" || e.key.toLowerCase() === "d") {
        e.preventDefault();
        setSelection(Math.min(4, currentSelection + 1));
      } else if (e.key >= "1" && e.key <= "5") {
        e.preventDefault();
        selectAndAdvance(parseInt(e.key) - 1);
      } else if (e.key === "Enter" || e.key.toLowerCase() === "z" || e.key === " ") {
        e.preventDefault();
        if (isTyping) {
          skipTyping();
        } else {
          confirmAndAdvance();
        }
      } else if (e.key === "Backspace" || e.key.toLowerCase() === "x") {
        e.preventDefault();
        goBack();
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initQuiz);
  } else {
    initQuiz();
  }
  document.addEventListener("astro:page-load", initQuiz);
</script>
