---
// input: lang ('en' | 'ja' | 'es' | 'pt')
// output: Comprehensive pixel-styled footer with localized navigation, official domain email, fan disclaimer, 4-language switcher, and external friend links
// pos: src/components/Footer.astro (更新规则：文件变更需同步本注释与所属目录 README)

import { getTranslations, type Locale } from '../i18n';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = getTranslations(lang);

const homeLink = lang === 'en' ? '/' : `/${lang}/`;
const testLink = lang === 'en' ? '/#test' : `/${lang}/#test`;
const virtuesLink = lang === 'en' ? '/#virtues' : `/${lang}/#virtues`;
const scoringLink = lang === 'en' ? '/#scoring' : `/${lang}/#scoring`;
const faqLink = lang === 'en' ? '/#faq' : `/${lang}/#faq`;
const soulsPrefix = lang === 'en' ? '/souls' : `/${lang}/souls`;
const rawCurrentPath = Astro.url.pathname.replace(/^\/(ja|es|pt)(?=\/|$)/, '') || '/';
const currentPath = rawCurrentPath === '/' ? '/' : rawCurrentPath.replace(/\/$/, '');
const englishPath = currentPath;
const japanesePath = `/ja${currentPath}`;
const spanishPath = `/es${currentPath}`;
const portuguesePath = `/pt${currentPath}`;
---

<footer class="bg-black border-t-2 border-white text-gray-400 text-sm mt-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
      <!-- Col 1 & 2: Site Info & Description -->
      <div class="md:col-span-2">
        <a href={homeLink} class="flex items-center gap-2 mb-4 group inline-block">
          <div class="w-6 h-6 text-red-500 transition-transform group-hover:scale-110">
            <svg viewBox="0 0 16 16" fill="currentColor" class="w-full h-full" shape-rendering="crispEdges">
              <path d="M2 0h4v1H2zm8 0h4v1h-4zM1 1h6v1H1zm8 0h6v1H9zM0 2h7v1H0zm9 2h7v1H9zM0 3h7v1H0zm9 3h7v1H9zM0 4h16v6H0zm2 6h12v2H2zm2 2h8v2H4zm2 2h4v2H6z"/>
            </svg>
          </div>
          <span class="font-bold text-white tracking-wider font-mono text-base">{t.footer.title}</span>
        </a>
        <p class="text-gray-400 text-xs leading-relaxed max-w-md">
          {t.footer.desc}
        </p>
        <p class="text-gray-500 text-xs mt-3 font-mono">
          {t.footer.contact} <a href="mailto:contact@soulvirtues.org" class="text-gray-400 hover:text-white underline font-mono">contact@soulvirtues.org</a>
        </p>

        <!-- Footer Language Quick Selector -->
        <div class="mt-4 flex flex-wrap items-center gap-2 text-xs font-mono">
          <span class="text-gray-500">🌐 Language:</span>
          <a
            href={englishPath}
            class={`px-2 py-0.5 border ${lang === 'en' ? 'border-yellow-400 text-yellow-400 bg-gray-900 font-bold' : 'border-gray-700 text-gray-400 hover:text-white hover:border-white'}`}
          >
            English
          </a>
          <a
            href={japanesePath}
            class={`px-2 py-0.5 border ${lang === 'ja' ? 'border-yellow-400 text-yellow-400 bg-gray-900 font-bold' : 'border-gray-700 text-gray-400 hover:text-white hover:border-white'}`}
          >
            日本語
          </a>
          <a
            href={spanishPath}
            class={`px-2 py-0.5 border ${lang === 'es' ? 'border-yellow-400 text-yellow-400 bg-gray-900 font-bold' : 'border-gray-700 text-gray-400 hover:text-white hover:border-white'}`}
          >
            Español
          </a>
          <a
            href={portuguesePath}
            class={`px-2 py-0.5 border ${lang === 'pt' ? 'border-yellow-400 text-yellow-400 bg-gray-900 font-bold' : 'border-gray-700 text-gray-400 hover:text-white hover:border-white'}`}
          >
            Português
          </a>
        </div>
      </div>

      <!-- Col 3: Explore Links -->
      <div>
        <h4 class="text-white font-semibold text-xs uppercase tracking-wider mb-3 font-mono">{t.footer.exploreTitle}</h4>
        <ul class="space-y-2 text-xs">
          <li><a href={testLink} class="hover:text-white transition-colors">{t.footer.testLink}</a></li>
          <li><a href={virtuesLink} class="hover:text-white transition-colors">{t.footer.traitsLink}</a></li>
          <li><a href={scoringLink} class="hover:text-white transition-colors">{t.footer.scoringLink}</a></li>
          <li><a href={faqLink} class="hover:text-white transition-colors">{t.footer.faqLink}</a></li>
        </ul>
      </div>

      <!-- Col 4: Legal & About Links -->
      <div>
        <h4 class="text-white font-semibold text-xs uppercase tracking-wider mb-3 font-mono">{t.footer.legalTitle}</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/about" class="hover:text-white transition-colors">{t.footer.aboutLink}</a></li>
          <li><a href="/privacy" class="hover:text-white transition-colors">{t.footer.privacyLink}</a></li>
          <li><a href="/terms" class="hover:text-white transition-colors">{t.footer.termsLink}</a></li>
          <li><a href="/contact" class="hover:text-white transition-colors">{t.footer.contactLink}</a></li>
          <li><a href="https://soulvirtues.makethisbetter.dev" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">{t.footer.feedbackLink}</a></li>
          <li><a href="https://aiblog.tools" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Find us on AIBlog.tools</a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-gray-800/80 py-4 overflow-hidden" aria-label="FrogDR domain rating monitor">
      <div class="frogdr-marquee">
        <div class="frogdr-marquee__track">
          <a href="https://frogdr.com/soulvirtues.org?utm_source=soulvirtues.org" target="_blank" rel="noopener noreferrer" aria-label="Monitor your Domain Rating with FrogDR">
            <img src="https://frogdr.com/soulvirtues.org/badge-white.svg" alt="Monitor your Domain Rating with FrogDR" width="125" height="27" />
          </a>
          <a href="https://frogdr.com/soulvirtues.org?utm_source=soulvirtues.org" target="_blank" rel="noopener noreferrer" aria-hidden="true" tabindex="-1">
            <img src="https://frogdr.com/soulvirtues.org/badge-white.svg" alt="" width="125" height="27" />
          </a>
        </div>
      </div>
    </div>

    <!-- 7 Undertale Soul Traits Internal Link Hub -->
    <div class="border-t border-gray-800/80 pt-6 pb-6">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 mb-3">
        <span class="text-xs font-mono font-bold text-white uppercase tracking-wider">The 7 Undertale SOUL Traits:</span>
        <span class="text-[11px] text-gray-500 font-mono">Detailed lore, items & battle mechanics</span>
      </div>
      <div class="flex flex-wrap gap-2 text-xs font-mono">
        <a href={`${soulsPrefix}/determination`} class="px-2.5 py-1 bg-black border border-red-900/60 text-red-400 hover:border-red-500 hover:text-white transition-colors">
          ❤️ Determination (Red)
        </a>
        <a href={`${soulsPrefix}/bravery`} class="px-2.5 py-1 bg-black border border-amber-900/60 text-amber-400 hover:border-amber-500 hover:text-white transition-colors">
          🧡 Bravery (Orange)
        </a>
        <a href={`${soulsPrefix}/justice`} class="px-2.5 py-1 bg-black border border-yellow-900/60 text-yellow-400 hover:border-yellow-500 hover:text-white transition-colors">
          💛 Justice (Yellow)
        </a>
        <a href={`${soulsPrefix}/kindness`} class="px-2.5 py-1 bg-black border border-emerald-900/60 text-emerald-400 hover:border-emerald-500 hover:text-white transition-colors">
          💚 Kindness (Green)
        </a>
        <a href={`${soulsPrefix}/patience`} class="px-2.5 py-1 bg-black border border-cyan-900/60 text-cyan-400 hover:border-cyan-500 hover:text-white transition-colors">
          🩵 Patience (Cyan)
        </a>
        <a href={`${soulsPrefix}/integrity`} class="px-2.5 py-1 bg-black border border-blue-900/60 text-blue-400 hover:border-blue-500 hover:text-white transition-colors">
          💙 Integrity (Blue)
        </a>
        <a href={`${soulsPrefix}/perseverance`} class="px-2.5 py-1 bg-black border border-purple-900/60 text-purple-400 hover:border-purple-500 hover:text-white transition-colors">
          💜 Perseverance (Purple)
        </a>
      </div>
    </div>

    <!-- Bottom Disclaimer & Copyright -->
    <div class="border-t border-gray-800/80 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-gray-500">
      <p>{t.footer.copyright}</p>
      <p class="text-center sm:text-right max-w-lg text-[11px] text-gray-600">
        {t.footer.disclaimer}
      </p>
    </div>
  </div>
</footer>

<style>
  .frogdr-marquee {
    width: min(100%, 250px);
    margin: 0 auto;
    overflow: hidden;
  }

  .frogdr-marquee__track {
    display: flex;
    width: max-content;
    gap: 2rem;
    animation: frogdr-marquee 14s linear infinite;
  }

  .frogdr-marquee__track a {
    display: block;
    flex: 0 0 auto;
  }

  .frogdr-marquee__track img {
    display: block;
    width: 125px;
    height: 27px;
  }

  @keyframes frogdr-marquee {
    to { transform: translateX(calc(-125px - 2rem)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .frogdr-marquee__track { animation: none; }
  }
</style>
