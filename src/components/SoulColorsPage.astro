---
// input: The approved English soul color copy and the existing /souls/ data source
// output: Soul color landing page with the existing 66-question quiz and seven color links
// pos: src/components/SoulColorsPage.astro（更新规则：文件变更需同步本注释与所属目录 README）

import Layout from '../layouts/Layout.astro';
import Quiz from './Quiz.astro';
import FAQ from './FAQ.astro';
import { SOUL_COLORS_COPY } from '../data/soulColorsCopy';
import { soulColorCopyKey } from '../data/soulColorsCopyMeta';
import { SOUL_CODES, SOUL_SLUGS_BY_CODE, SOULS, type SoulCode } from '../data/souls';
import { ASSESSMENT_COPY } from '../data/assessmentContent';
import type { Locale } from '../i18n';

const lang = 'en';
const copy = SOUL_COLORS_COPY;
const siteUrl = 'https://soulvirtues.org';
const pagePath = '/soul-colors/';
const pageUrl = `${siteUrl}${pagePath}`;
const colorLabels: Record<SoulCode, string> = {
  DET: 'red',
  BRV: 'orange',
  JUS: 'yellow',
  KND: 'green',
  PAT: 'cyan',
  INT: 'blue',
  PER: 'purple',
};
const colorCards = SOUL_CODES.map(code => ({
  code,
  color: colorLabels[code],
  name: SOULS[code].name,
  hex: SOULS[code].hex,
  path: `/souls/${SOUL_SLUGS_BY_CODE[code]}/`,
  copyKey: soulColorCopyKey(code),
  anchor: `${colorLabels[code]} soul color test`,
}));
const faqs = copy.faq.map((faq, index) => index === 1
  ? { ...faq, a: ASSESSMENT_COPY.en.faqItems.find(item => item.q === 'How long is the Undertale soul quiz here?')?.a ?? faq.a }
  : faq);
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: copy.title,
      description: copy.desc,
      inLanguage: lang,
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: faqs.map(item => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    },
  ],
};
---

<Layout
  title={copy.title}
  description={copy.desc}
  canonicalUrl={pageUrl}
  structuredData={structuredData}
  lang={lang as Locale}
>
  <article class="max-w-5xl mx-auto px-4 sm:px-6 py-10 space-y-10">
    <header>
      <h1 class="text-3xl sm:text-5xl font-black text-white font-mono tracking-tight leading-tight mb-5">{copy.h1}</h1>
      <p class="text-sm sm:text-base text-gray-300 leading-relaxed">{copy.intro}</p>
    </header>

    <section class="pixel-card-sub p-5 sm:p-7">
      <h2 class="text-xl sm:text-2xl font-bold text-white font-mono mb-4">7 colors / 7 virtues</h2>
      <ul class="list-disc pl-5 space-y-2 text-sm text-gray-300">
        {copy.facts.map(fact => <li>{fact}</li>)}
      </ul>
    </section>

    <section id="test" class="scroll-mt-24">
      <Quiz lang={lang as Locale} />
    </section>

    <section class="pixel-card-sub p-5 sm:p-7">
      <h2 class="text-xl sm:text-2xl font-bold text-white font-mono mb-4">{copy.compare.title}</h2>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[640px] text-left text-xs sm:text-sm">
          <thead class="text-gray-400 font-mono uppercase">
            <tr>
              <th class="py-2 pr-4">Soul color test</th>
              {copy.compare.heads.map(head => <th class="py-2 pr-4">{head}</th>)}
            </tr>
          </thead>
          <tbody>
            {copy.compare.rows.map(row => (
              <tr class="border-t border-gray-800 align-top">
                {row.map(cell => <td class="py-3 pr-4 text-gray-300">{cell}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-5 text-xs text-gray-400">{copy.compare.note}</p>
    </section>

    <section class="pixel-card-sub p-5 sm:p-7">
      <h2 class="text-xl sm:text-2xl font-bold text-white font-mono mb-4">{copy.howto.title}</h2>
      <ol class="list-decimal pl-5 space-y-2 text-sm text-gray-300">
        {copy.howto.steps.map(step => <li>{step}</li>)}
      </ol>
    </section>

    <section class="pixel-card-sub p-5 sm:p-7">
      <h2 class="text-xl sm:text-2xl font-bold text-white font-mono mb-4">{copy.maker.title}</h2>
      <p class="text-sm text-gray-300 mb-5">{copy.maker.hint}</p>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        {colorCards.map(card => (
          <a href={card.path} class="min-h-[72px] p-4 bg-black border border-gray-800 hover:border-white transition-colors">
            <span class="inline-block w-4 h-4 mr-2 border border-white/20" style={`background: ${card.hex}`} aria-hidden="true"></span>
            <span class="font-mono font-bold text-white">{card.name}</span>
            <span class="block mt-1 text-xs text-gray-400">{copy.maker.colors[card.copyKey]}</span>
            <span class="sr-only">{card.anchor}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="pixel-card-sub p-5 sm:p-7" id="faq">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white font-mono tracking-wide mb-5">FAQ</h2>
      <FAQ faqs={faqs} />
    </section>

    <nav class="border-t border-gray-800 pt-6 text-xs sm:text-sm font-mono flex flex-wrap gap-4" aria-label="Soul color page links">
      <a href="/souls/" class="text-cyan-300 underline">/souls/</a>
      <a href="/method/" class="text-cyan-300 underline">/method/</a>
      {colorCards.map(card => <a href="/#test" class="sr-only">{card.anchor}</a>)}
    </nav>
  </article>
</Layout>
