---
// input: optional faqs array of {q, a} items
// output: Accessible pixel-card accordion list addressing top search intent questions
// pos: src/components/FAQ.astro (更新规则：文件变更需同步本注释与所属目录 README)

import type { FAQItem } from '../i18n/types';

import { ASSESSMENT_COPY } from '../data/assessmentContent';
const FAQS = ASSESSMENT_COPY.en.faqItems;

interface Props {
  faqs?: FAQItem[];
}

const { faqs = FAQS } = Astro.props;
---

<div class="space-y-4 max-w-4xl mx-auto">
  {faqs.map((faq) => (
    <details class="group pixel-card-sub p-5">
      <summary class="flex items-center justify-between cursor-pointer list-none text-base font-semibold text-white group-open:text-red-400">
        <span class="pr-4">{faq.q}</span>
        <span class="transition-transform duration-200 group-open:rotate-180 text-gray-400">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </span>
      </summary>
      <p class="mt-4 text-sm text-gray-300 leading-relaxed border-t border-gray-800/80 pt-4">
        {faq.a}
      </p>
    </details>
  ))}
</div>
