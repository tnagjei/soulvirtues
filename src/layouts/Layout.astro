---
// input: Title, description, canonicalUrl, ogImage, structuredData schema
// output: Full HTML page shell with SEO meta tags, fonts, styles, header, footer, ambient background video, Google Analytics, Clarity analytics, and MakeThisBetter widget
// pos: src/layouts/Layout.astro (更新规则：文件变更需同步本注释与所属目录 README)

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  structuredData?: Record<string, any>;
}

const {
  title = "Soul Virtues Extractor - Free 66-Question Soul Virtues Test",
  description = "Take the free 66-question Soul Virtues Extractor test. Discover your Undertale SOUL trait and color percentage across Determination, Bravery, and more.",
  canonicalUrl = "https://soulvirtues.org/",
  ogImage = "https://soulvirtues.org/og-image.png",
  structuredData,
} = Astro.props;

const siteUrl = "https://soulvirtues.org";
const fullCanonical = canonicalUrl.startsWith("http") ? canonicalUrl : `${siteUrl}${canonicalUrl}`;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={fullCanonical} />

    <!-- Open Graph Metadata -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Soul Virtues Extractor" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon & Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Structured Data (Schema.org JSON-LD) -->
    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-LV21SKRL9V"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-LV21SKRL9V');
    </script>

    <!-- Microsoft Clarity Analytics -->
    <script is:inline type="text/javascript">
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "y44qd28h2p");
    </script>

    <!-- 第三方广告代码 (5gvci) -->
    <script is:inline src="https://5gvci.com/act/files/tag.min.js?z=11601328" data-cfasync="false" async></script>

    <!-- 第三方广告代码 (nap5k) -->
    <script is:inline>(function(s){s.dataset.zone='11601357',s.src='https://nap5k.com/tag.min.js'})([document.documentElement, document.body].filter(Boolean).pop().appendChild(document.createElement('script')))</script>
  </head>
  <body class="bg-[#000000] text-gray-100 min-h-screen flex flex-col font-sans selection:bg-red-500 selection:text-white relative">
    <!-- 第三方广告代码 (omg10) 隐藏 iframe：该链接是重定向/弹窗类 HTML 页面，必须用 iframe 加载（不能当 <script> 放 head），置于屏幕外 0 尺寸避免影响布局 -->
    <iframe src="https://omg10.com/4/11601375" width="0" height="0" frameborder="0" scrolling="no" aria-hidden="true" style="position:absolute;width:0;height:0;border:0;overflow:hidden;"></iframe>

    <!-- Ambient Void Video Background -->
    <video
      id="bg-video"
      autoplay
      loop
      muted
      playsinline
      disablepictureinpicture
      aria-hidden="true"
    >
      <source src="/background.mp4" type="video/mp4" />
    </video>

    <Header />
    <main class="flex-grow relative z-10">
      <slot />
    </main>
    <Footer />

    <!-- MakeThisBetter Feedback Widget -->
    <script is:inline src="https://unpkg.com/makethisbetter@1/dist/makethisbetter.js"></script>
    <script is:inline>
      window.MakeThisBetter && window.MakeThisBetter.init({
        projectKey: "mtb_proj_tkShbrm7MCZZmiyokM2gfV9HCiFt_Ak0",
        locale: "en",
      });
    </script>
  </body>
</html>
