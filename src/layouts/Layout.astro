---
// input: Title, description, canonicalUrl, ogImage, structuredData schema, lang ('en' | 'ja' | 'es' | 'pt')
// output: Full HTML page shell with multilingual hreflang meta tags, fonts, styles, header, footer, bottom-right language suggestion toast, ambient background video, Google Analytics, Clarity analytics, MakeThisBetter widget, and deferred third-party ads (load on scroll/dwell)
// pos: src/layouts/Layout.astro (更新规则：文件变更需同步本注释与所属目录 README)

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LangDetector from '../components/LangDetector.astro';
import type { Locale } from '../i18n';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  structuredData?: Record<string, any>;
  lang?: Locale;
}

const {
  title = "Soul Virtues Extractor - Free 66-Question Soul Virtues Test",
  description = "Take the free 66-question Soul Virtues Extractor test. Discover your Undertale SOUL trait and color percentage across Determination, Bravery, and more.",
  canonicalUrl = "https://soulvirtues.org/",
  ogImage = "https://soulvirtues.org/og-image.png",
  structuredData,
  lang = "en",
} = Astro.props;

const siteUrl = "https://soulvirtues.org";
const fullCanonical = canonicalUrl.startsWith("http") ? canonicalUrl : `${siteUrl}${canonicalUrl}`;

// Calculate canonical relative path across all 4 languages dynamically
const pathname = Astro.url.pathname;
const cleanRel = pathname.replace(/^\/(ja|es|pt)(\/|$)/, '/').replace(/\/$/, '') || '';
const baseRel = cleanRel === '' ? '/' : cleanRel;

const hrefEn = `${siteUrl}${baseRel}`;
const hrefJa = `${siteUrl}/ja${baseRel === '/' ? '/' : baseRel}`;
const hrefEs = `${siteUrl}/es${baseRel === '/' ? '/' : baseRel}`;
const hrefPt = `${siteUrl}/pt${baseRel === '/' ? '/' : baseRel}`;
const hrefDefault = `${siteUrl}${baseRel}`;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Yandex site ownership verification -->
    <meta name="yandex-verification" content="46fdce885b6ef94a" />
    <link rel="canonical" href={fullCanonical} />

    <!-- Multilingual Hreflang SEO Tags -->
    <link rel="alternate" hreflang="en" href={hrefEn} />
    <link rel="alternate" hreflang="ja" href={hrefJa} />
    <link rel="alternate" hreflang="es" href={hrefEs} />
    <link rel="alternate" hreflang="pt" href={hrefPt} />
    <link rel="alternate" hreflang="x-default" href={hrefDefault} />

    <!-- Open Graph Metadata -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Soul Virtues Extractor" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon & Icons -->
    <link rel="icon" type="image/png" sizes="512x512" href="/logo.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Structured Data (Schema.org JSON-LD) -->
    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-LV21SKRL9V"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-LV21SKRL9V');
    </script>

    <!-- Microsoft Clarity Analytics -->
    <script is:inline type="text/javascript">
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "y44qd28h2p");
    </script>
  </head>
  <body class="bg-black text-gray-100 min-h-screen flex flex-col font-sans selection:bg-red-500 selection:text-white relative">
    <!-- Ambient Void Video Background -->
    <video
      id="bg-video"
      autoplay
      loop
      muted
      playsinline
      disablepictureinpicture
      aria-hidden="true"
    >
      <source src="/background.mp4" type="video/mp4" />
    </video>

    <Header lang={lang} />
    <main class="flex-grow relative z-10">
      <slot />
    </main>
    <Footer lang={lang} />

    <!-- Bottom-Right Floating Smart Language Detector -->
    <LangDetector lang={lang} />

    <!-- MakeThisBetter Feedback Widget -->
    <script is:inline src="https://unpkg.com/makethisbetter@1/dist/makethisbetter.js"></script>
    <script is:inline>
      window.MakeThisBetter && window.MakeThisBetter.init({
        projectKey: "mtb_proj_tkShbrm7MCZZmiyokM2gfV9HCiFt_Ak0",
        locale: "en",
      });
    </script>

    <!--
      第三方广告（5gvci / nap5k / omg10）—— 延迟加载。
      为什么：这三家是弹窗/浮动类广告，若一进首屏就加载会在移动端遮挡导航与按钮，
      并触发 Google “侵入式插页广告”惩罚（移动端优先索引，直接伤排名）。
      怎么做：用户向下滚动超过 250px、或停留超过 5 秒，才注入这三段广告代码，且只注入一次。
      效果：首屏干净（Googlebot 不滚动/不停留，爬到的是无广告页面），变现往后挪、跳出率更低。
      调参：SCROLL_TRIGGER_PX（滚动阈值）、DWELL_TRIGGER_MS（停留毫秒数）。
    -->
    <script is:inline>
      (function () {
        var SCROLL_TRIGGER_PX = 250; // 滚动超过此距离即加载广告
        var DWELL_TRIGGER_MS = 5000; // 停留超过此时长即加载广告
        var loaded = false;

        function loadAds() {
          if (loaded) return;
          loaded = true;

          // 5gvci 弹窗/浮动广告
          var s1 = document.createElement('script');
          s1.src = 'https://5gvci.com/act/files/tag.min.js?z=11601328';
          s1.setAttribute('data-cfasync', 'false');
          s1.async = true;
          document.head.appendChild(s1);

          // nap5k 浮动广告（复刻原内联注入逻辑：data-zone + 追加到 body）
          var s2 = document.createElement('script');
          s2.setAttribute('data-zone', '11601357');
          s2.src = 'https://nap5k.com/tag.min.js';
          document.body.appendChild(s2);

          // omg10 隐藏 iframe（重定向/弹窗类 HTML，必须用 iframe 加载，置于屏幕外 0 尺寸）
          var f = document.createElement('iframe');
          f.src = 'https://omg10.com/4/11601375';
          f.width = '0';
          f.height = '0';
          f.setAttribute('frameborder', '0');
          f.setAttribute('scrolling', 'no');
          f.setAttribute('aria-hidden', 'true');
          f.style.cssText = 'position:absolute;width:0;height:0;border:0;overflow:hidden;';
          document.body.appendChild(f);
        }

        // 停留超时触发
        var dwellTimer = setTimeout(loadAds, DWELL_TRIGGER_MS);

        // 滚动触发（先到先生效，二者只触发一次）
        function onScroll() {
          if (window.scrollY > SCROLL_TRIGGER_PX) {
            clearTimeout(dwellTimer);
            loadAds();
            window.removeEventListener('scroll', onScroll);
          }
        }
        window.addEventListener('scroll', onScroll, { passive: true });
      })();
    </script>
  </body>
</html>
