---
// input: Title, description, canonicalUrl, ogImage, structuredData schema, lang ('en' | 'ja' | 'es' | 'pt' | 'ru')
// output: Full HTML page shell with multilingual hreflang meta tags, fonts, styles, header, footer, bottom-right language suggestion toast, ambient background video, Google Analytics, Clarity analytics, and MakeThisBetter widget
// pos: src/layouts/Layout.astro (更新规则：文件变更需同步本注释与所属目录 README)

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LangDetector from '../components/LangDetector.astro';
import type { Locale } from '../i18n';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  structuredData?: Record<string, any>;
  lang?: Locale;
}

const {
  title = "Soul Virtues Extractor - Free 66-Question Soul Virtues Test",
  description = "Take the free 66-question Soul Virtues Extractor test. Discover your Undertale SOUL trait and color percentage across Determination, Bravery, and more.",
  canonicalUrl = "https://soulvirtues.org/",
  ogImage = "https://soulvirtues.org/og-image.png",
  structuredData,
  lang = "en",
} = Astro.props;

const siteUrl = "https://soulvirtues.org";
const rawCanonical = canonicalUrl.startsWith("http") ? canonicalUrl : `${siteUrl}${canonicalUrl}`;
const fullCanonical = rawCanonical.replace(/\/?$/, '/');

// Calculate canonical relative path across all 5 languages dynamically
const pathname = Astro.url.pathname;
const cleanRel = pathname.replace(/^\/(ja|es|pt|ru)(\/|$)/, '/').replace(/\/+$/, '') || '';
const baseRel = cleanRel === '' ? '/' : `${cleanRel}/`;

const UNLOCALIZED_ROUTES = new Set(['/about/', '/contact/', '/privacy/', '/terms/']);
const isUnlocalized = UNLOCALIZED_ROUTES.has(baseRel);

const hrefEn = `${siteUrl}${baseRel}`;
const hrefJa = `${siteUrl}/ja${baseRel === '/' ? '/' : baseRel}`;
const hrefEs = `${siteUrl}/es${baseRel === '/' ? '/' : baseRel}`;
const hrefPt = `${siteUrl}/pt${baseRel === '/' ? '/' : baseRel}`;
const hrefRu = `${siteUrl}/ru${baseRel === '/' ? '/' : baseRel}`;
const hrefDefault = `${siteUrl}${baseRel}`;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Yandex site ownership verification -->
    <meta name="yandex-verification" content="46fdce885b6ef94a" />
    <link rel="canonical" href={fullCanonical} />

    <!-- Multilingual Hreflang SEO Tags -->
    {isUnlocalized ? (
      <>
        <link rel="alternate" hreflang="en" href={fullCanonical} />
        <link rel="alternate" hreflang="x-default" href={fullCanonical} />
      </>
    ) : (
      <>
        <link rel="alternate" hreflang="en" href={hrefEn} />
        <link rel="alternate" hreflang="ja" href={hrefJa} />
        <link rel="alternate" hreflang="es" href={hrefEs} />
        <link rel="alternate" hreflang="pt" href={hrefPt} />
        <link rel="alternate" hreflang="ru" href={hrefRu} />
        <link rel="alternate" hreflang="x-default" href={hrefDefault} />
      </>
    )}

    <!-- Open Graph Metadata -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Soul Virtues Extractor" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon & Icons -->
    <link rel="icon" type="image/png" sizes="512x512" href="/logo.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Structured Data (Schema.org JSON-LD) -->
    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-LV21SKRL9V"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-LV21SKRL9V');
    </script>

    <!-- Microsoft Clarity Analytics -->
    <script is:inline type="text/javascript">
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "y44qd28h2p");
    </script>
  </head>
  <body class="bg-black text-gray-100 min-h-screen flex flex-col font-sans selection:bg-red-500 selection:text-white relative">
    <!-- Ambient Void Video Background -->
    <video
      id="bg-video"
      autoplay
      loop
      muted
      playsinline
      disablepictureinpicture
      aria-hidden="true"
    >
      <source src="/background.mp4" type="video/mp4" />
    </video>

    <Header lang={lang} />
    <main class="flex-grow relative z-10">
      <slot />
    </main>
    <Footer lang={lang} />

    <!-- Bottom-Right Floating Smart Language Detector -->
    <LangDetector lang={lang} />

    <!-- MakeThisBetter Feedback Widget -->
    <script is:inline src="https://unpkg.com/makethisbetter@1/dist/makethisbetter.js"></script>
    <script is:inline>
      window.MakeThisBetter && window.MakeThisBetter.init({
        projectKey: "mtb_proj_tkShbrm7MCZZmiyokM2gfV9HCiFt_Ak0",
        locale: "en",
      });
    </script>
  </body>
</html>
